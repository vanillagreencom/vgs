#!/bin/sh
set -e

if [ "$1" = configure ]; then
	cat <<'EOF'
VGS is installed. Finish the setup for your account with:

  vshell setup

That enables and starts vshell.service, then reports the optional feature
dependencies and which app owns org.freedesktop.Notifications; if it is not
VGS, vshell notifications takeover hands the name back.
EOF
fi

#DEBHELPER#
