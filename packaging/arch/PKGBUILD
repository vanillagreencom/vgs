pkgname=('vgs-shell' 'vgs-shell-assets')
pkgver=0.1.0
pkgrel=3
pkgdesc='VanillaGreen desktop shell for Hyprland and Niri'
arch=('x86_64' 'aarch64')
url='https://github.com/vanillagreencom/vgs'
license=('MIT')
depends=('quickshell' 'jq' 'python' 'systemd')
