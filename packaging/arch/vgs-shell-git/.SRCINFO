pkgbase = vgs-shell-git
	pkgdesc = VanillaGreen desktop shell for Hyprland and Niri (git)
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 3
	url = https://github.com/vanillagreencom/vgs
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = go
	depends = quickshell
	depends = jq
	depends = python
	depends = systemd
	optdepends = alacritty: terminal for VGS terminal actions
	optdepends = bandwhich: per-interface network usage
	optdepends = curl: AI usage widget
	optdepends = dolphin: file manager for the launcher folder opener
	optdepends = fd: faster launcher file search
	optdepends = ffmpeg: screen recording
	optdepends = ffmpegthumbnailer: file thumbnails
	optdepends = fontconfig: font cache refresh after a font change
	optdepends = foot: terminal for VGS terminal actions
	optdepends = fuse3: cloud sync streaming mounts
	optdepends = ghostty: terminal for VGS terminal actions
	optdepends = glib2: GTK theme, icon theme and color-scheme application, trash instead of deleting files, launcher default folder opener
	optdepends = gnome-keyring: greeter and keyring integration
	optdepends = gnome-terminal: terminal for VGS terminal actions
	optdepends = gpu-screen-recorder: screen recording
	optdepends = greetd: greeter and keyring integration
	optdepends = grim: screenshots, region OCR
	optdepends = hyprland: Hyprland compositor support
	optdepends = hyprpicker: screenshots, region OCR, screen recording
	optdepends = hyprsunset: night light
	optdepends = kitty: terminal for VGS terminal actions
	optdepends = konsole: terminal for VGS terminal actions
	optdepends = libnotify: screenshots, region OCR, screen recording
	optdepends = nautilus: file manager for the launcher folder opener
	optdepends = niri: Niri compositor support
	optdepends = pacman-contrib: repo update checks
	optdepends = paru: AUR update checks
	optdepends = python-pywalfox: Firefox theming (AUR; pip elsewhere)
	optdepends = rclone: cloud file sync
	optdepends = ripgrep: launcher text search
	optdepends = satty: screenshot annotation
	optdepends = slurp: screenshots, region OCR, screen recording
	optdepends = sudo: privileged actions run from the shell, sudoers validation before a drop-in is installed
	optdepends = tailscale: Tailscale widget
	optdepends = tesseract: region OCR
	optdepends = tesseract-data-eng: region OCR
	optdepends = thunar: file manager for the launcher folder opener
	optdepends = uwsm: launches apps into their own systemd scope
	optdepends = wezterm: terminal for VGS terminal actions
	optdepends = wl-clipboard: clipboard history, screenshots, region OCR, screen recording
	optdepends = wlsunset: night light
	optdepends = xdg-utils: reads and sets default applications
	optdepends = xterm: terminal for VGS terminal actions
	optdepends = yazi: terminal file manager for the launcher Yazi folder opener
	optdepends = zoxide: launcher recent-directory search
	provides = vgs-shell
	provides = notification-daemon
	conflicts = vgs-shell
	conflicts = notification-daemon
	conflicts = mako
	conflicts = swaync
	source = git+https://github.com/vanillagreencom/vgs.git
	sha256sums = SKIP

pkgname = vgs-shell-git
	install = vgs-shell-git.install

pkgname = vgs-shell-assets-git
	pkgdesc = Optional VGS themes, wallpapers, and bundled icon themes (git)
	depends = vgs-shell-git=0.1.0.r0.g0000000-3
	provides = vgs-shell-assets
	conflicts = vgs-shell-assets
