{
  "$comment": [
    "Distribution package names for the commands declared in",
    "config/vshell/dependencies.json. scripts/gen-package-metadata.py joins the",
    "two files and regenerates the optional-dependency blocks in the packaging",
    "recipes, so the feature manifest and the packaging cannot drift apart.",
    "",
    "Every command in dependencies.json must appear in \"commands\" or the",
    "generator fails. Use \"skip\" for commands already covered by a hard",
    "dependency or shipped inside the package. Omit a distro key when the",
    "distribution has no package for that command; the entry is then left out of",
    "that distribution's recipe rather than guessed at.",
    "",
    "Package names were verified against archlinux.org, packages.debian.org",
    "(trixie), the Fedora rawhide metadata API, and packages.gentoo.org."
  ],
  "features": {
    "base": "shell runtime",
    "theme": "theme engine",
    "theme-gtk": "GTK theme, icon theme and color-scheme application",
    "theme-firefox": "Firefox theming",
    "fonts": "font cache refresh after a font change",
    "greeter": "greeter and keyring integration",
    "clipboard": "clipboard history",
    "network-usage": "per-interface network usage",
    "capture": "screenshots",
    "capture-edit": "screenshot annotation",
    "ocr": "region OCR",
    "gamma": "night light",
    "recording": "screen recording",
    "thumbnails": "file thumbnails",
    "launcher-zoxide": "launcher recent-directory search",
    "launcher-search": "launcher text search",
    "launcher-search-fast": "faster launcher file search",
    "trash": "trash instead of deleting files",
    "launcher-folder-open": "launcher default folder opener",
    "updates-arch": "repo update checks",
    "updates-aur": "AUR update checks",
    "ai-usage": "AI usage widget",
    "tailscale": "Tailscale widget",
    "brightness": "display brightness",
    "sudo-toggle": "passwordless sudo toggle widget",
    "cloud-sync": "cloud file sync",
    "cloud-sync-stream": "cloud sync streaming mounts"
  },
