short_desc="VanillaGreen desktop shell for Hyprland and Niri"
maintainer="Brad <brad@vanillagreen>"
license="MIT"
homepage="https://github.com/vanillagreencom/vgs"
case "$XBPS_TARGET_MACHINE" in
	x86_64*)
		_arch=x86_64
		checksum=a0bc9dfe74a9eb76513608b196ae11153dee89b370d30bf5121a9256fc23cec5
		;;
	aarch64*)
		_arch=aarch64
		checksum=dee66ae3d7f81d63f6f2634b81bf487ce53a11e67635b4bfbc2a933a4e79656e
		;;
	*) broken="unsupported architecture: $XBPS_TARGET_MACHINE" ;;
esac
distfiles="https://github.com/vanillagreencom/vgs/releases/download/v${version}/vgs-${version}-linux-${_arch}.tar.gz"
wrksrc="vgs-${version}-linux-${_arch}"

do_install() {
	DESTDIR="$DESTDIR" PREFIX=/usr VGS_BACKEND_BINARY="$wrksrc/bin/vshell-backend" packaging/install-system.sh
}