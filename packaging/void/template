pkgname=vgs-shell
version=0.4.0
revision=1
# BEGIN GENERATED REQUIRED DEPENDENCIES
# Generated by scripts/gen-package-metadata.py from
# config/vshell/dependencies.json and packaging/optional-packages.json.
# Run scripts/gen-package-metadata.py --write after changing either file.
depends="quickshell jq python3 grim slurp hyprpicker wl-clipboard libnotify glib sudo"
# END GENERATED REQUIRED DEPENDENCIES
# One notification daemon per session: org.freedesktop.Notifications is a
# first-come, first-served bus name. Void packages swaync under its upstream
# name, SwayNotificationCenter.
conflicts="mako>=0 dunst>=0 SwayNotificationCenter>=0"
subpackages="vgs-shell-assets"
short_desc="VanillaGreen desktop shell for Hyprland and Niri"
maintainer="Brad <brad@vanillagreen>"
license="MIT"
homepage="https://github.com/vanillagreencom/vgs"
case "$XBPS_TARGET_MACHINE" in
	x86_64*)
		_arch=x86_64
		checksum="907f46ba17b3b6b3efe7628a790451b35d1626e581a564d240f66dd991650f84
		 cab6238a8217bbe08407403efba57cf9681f50202adcf7366111a4071f2ce448"
		;;
	aarch64*)
		_arch=aarch64
		checksum="e852d03b941e984f06e9ab9322c5eb6875d5f01a5bea5c5c7c837e9edea5192b
		 cab6238a8217bbe08407403efba57cf9681f50202adcf7366111a4071f2ce448"
		;;
	*) broken="unsupported architecture: $XBPS_TARGET_MACHINE" ;;
esac
# Two distfiles: the per-architecture shell, and the architecture-independent
# extras the assets subpackage installs. xbps unpacks both into $wrksrc's parent,
# so do_install reaches the extras tree by name.
distfiles="https://github.com/vanillagreencom/vgs/releases/download/v${version}/vgs-${version}-linux-${_arch}.tar.gz
 https://github.com/vanillagreencom/vgs/releases/download/v${version}/vgs-${version}-assets.tar.gz"
wrksrc="vgs-${version}-linux-${_arch}"

do_install() {
	DESTDIR="$DESTDIR" PREFIX=/usr VGS_THEME_BUNDLE=core VGS_BACKEND_BINARY="$wrksrc/bin/vshell-backend" packaging/install-system.sh
	DESTDIR="$DESTDIR" PREFIX=/usr VGS_THEME_BUNDLE=extras ../vgs-${version}-assets/packaging/install-system.sh
}

vgs-shell-assets_package() {
	short_desc="Optional VGS themes, wallpapers, and bundled icon themes"
	depends="vgs-shell>=${version}_${revision}"
	pkg_install() {
		vmove usr/lib/vshell/config/vshell/icons
		local theme
		for theme in "${DESTDIR}"/usr/lib/vshell/themes/*/; do
			theme="${theme%/}"
			theme="${theme##*/}"
			case "$theme" in
				coppernight|targets) continue ;;
			esac
			vmove "usr/lib/vshell/themes/${theme}"
		done
	}
}