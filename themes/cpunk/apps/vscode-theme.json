    "property": "#e8e9e9",
    "property.readonly": "#e8e9e9",
    "function": "#aaacac",
    "function.defaultLibrary": "#babbbb",
    "method": "#aaacac",
    "macro": "#babbbb",
    "class": "#fef348",
    "type": "#fef348",
    "type.defaultLibrary": "#ffffff",
    "struct": "#fef348",
    "interface": "#fef348",
    "enum": "#fef348",
    "enumMember": "#fff9a3",
    "typeParameter": "#fef348",
    "namespace": "#aaacac",
    "decorator": "#babbbb",
    "keyword": "#ffc2c7",
    "string": "#d1d2d1",
    "number": "#ff7f7f",
    "*.declaration": {
      "bold": false
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#7f6e6e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": "variable, string constant.other.placeholder",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": "variable.parameter, meta.function.parameter, entity.name.variable.parameter",
      "settings": {
        "foreground": "#babbbb",
        "fontStyle": "italic"
