    "number": "#fab387",
    "*.declaration": {
      "bold": false
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#9399b2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": "variable, string constant.other.placeholder",
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": "variable.parameter, meta.function.parameter, entity.name.variable.parameter",
