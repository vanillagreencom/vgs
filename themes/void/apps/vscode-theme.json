    "variable.defaultLibrary": "#fab387",
    "property": "#b4befe",
    "property.readonly": "#b4befe",
    "function": "#89b4fa",
    "function.defaultLibrary": "#fab387",
    "method": "#89b4fa",
    "macro": "#fab387",
    "class": "#f9e2af",
    "type": "#f9e2af",
    "type.defaultLibrary": "#cba6f7",
    "struct": "#f9e2af",
    "interface": "#f9e2af",
