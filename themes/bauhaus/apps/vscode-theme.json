  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#98a0ae", "fontStyle": "italic" } },
    { "scope": ["comment.todo", "keyword.codetag.notation"], "settings": { "foreground": "#e0a568", "fontStyle": "bold" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#789fa2" } },
    { "scope": ["constant.character.escape", "string.regexp", "punctuation.definition.template-expression"], "settings": { "foreground": "#809d9e" } },
    { "scope": ["constant.numeric", "constant.language.boolean", "constant.language.null", "constant.language.undefined"], "settings": { "foreground": "#e7a46f" } },
    { "scope": ["constant", "constant.other", "support.constant"], "settings": { "foreground": "#e7a46f" } },
    { "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.other"], "settings": { "foreground": "#e37b66", "fontStyle": "bold" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "meta.brace"], "settings": { "foreground": "#c6ced8" } },
    { "scope": ["punctuation.definition.tag", "punctuation.section", "punctuation.definition.parameters", "punctuation.definition.array"], "settings": { "foreground": "#98a0ae" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#8999aa" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.class"], "settings": { "foreground": "#e0a568" } },
    { "scope": ["support.type.builtin", "entity.name.type.builtin", "constant.language"], "settings": { "foreground": "#e0a568" } },
    { "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.definition.variable.name"], "settings": { "foreground": "#eaeff5" } },
    { "scope": ["variable.parameter", "meta.parameter"], "settings": { "foreground": "#e7a46f" } },
    { "scope": ["variable.other.member", "meta.object-literal.key", "support.type.property-name", "variable.other.property"], "settings": { "foreground": "#c6ced8" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#e37b66", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag", "entity.name.tag.html", "entity.name.tag.xml"], "settings": { "foreground": "#8999aa" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e0a568" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "support.other.namespace"], "settings": { "foreground": "#8999aa" } },
    { "scope": ["markup.heading", "markup.heading entity.name", "entity.name.section"], "settings": { "foreground": "#e37b66", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#e7a46f", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#789fa2" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#809d9e", "fontStyle": "underline" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#789fa2" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#cb886d" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#e0a568" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#cb886d" } },
    { "scope": ["meta.tag", "meta.jsx.children"], "settings": { "foreground": "#eaeff5" } }
  ]
}
