  "semanticTokenColors": {
    "parameter": "#7c93dd",
    "variable": "#ffffff",
    "variable.readonly": "#f6dbe6",
    "variable.defaultLibrary": "#7c93dd",
    "property": "#c3cef2",
    "property.readonly": "#c3cef2",
    "function": "#979fec",
    "function.defaultLibrary": "#7c93dd",
    "method": "#979fec",
    "macro": "#7c93dd",
    "class": "#e095b5",
    "type": "#e095b5",
    "type.defaultLibrary": "#ffffff",
    "struct": "#e095b5",
    "interface": "#e095b5",
    "enum": "#e095b5",
    "enumMember": "#f6dbe6",
    "typeParameter": "#e095b5",
    "namespace": "#979fec",
    "decorator": "#7c93dd",
    "keyword": "#eddaee",
    "string": "#648ed0",
    "number": "#d5aeb5",
    "*.declaration": {
      "bold": false
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#836f79",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": "variable, string constant.other.placeholder",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": "variable.parameter, meta.function.parameter, entity.name.variable.parameter",
      "settings": {
        "foreground": "#7c93dd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable Property",
