{
  "schemaVersion": 1,
  "name": "frankenstein",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#313132",
      "foreground": "#8dffd5",
      "accent": "#93a7e6",
      "success": "#47ae83",
      "warning": "#46b287",
      "danger": "#d68679",
      "info": "#849be3"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.35)",
      "success": "mix({palette.success}, contrast({palette.background}), 0.14)",
      "warning": "mix({palette.warning}, contrast({palette.background}), 0.11)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.15)",
      "info": "mix({palette.info}, contrast({palette.background}), 0.12)"
    }
  }
}
