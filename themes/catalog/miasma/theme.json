{
  "schemaVersion": 1,
  "name": "miasma",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#222222",
      "foreground": "#c2c2b0",
      "accent": "#90996b",
      "success": "#5f875f",
      "warning": "#b36d43",
      "danger": "#685742",
      "info": "#78824b"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.27)",
      "success": "mix({palette.success}, contrast({palette.background}), 0.18)",
      "warning": "mix({palette.warning}, contrast({palette.background}), 0.19)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.36)",
      "info": "mix({palette.info}, contrast({palette.background}), 0.18)"
    }
  }
}
