{
  "schemaVersion": 1,
  "name": "arc-raiders",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#0c060d",
      "foreground": "#fafafa",
      "accent": "#858386",
      "success": "#b0413b",
      "warning": "#dca23e",
      "danger": "#6a5457",
      "info": "#3f57a1"
    },
    "color": {
      "success": "mix({palette.success}, contrast({palette.background}), 0.21)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.25)",
      "info": "mix({palette.info}, contrast({palette.background}), 0.25)"
    }
  }
}
