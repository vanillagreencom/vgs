{
  "schemaVersion": 1,
  "name": "harbordark",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#1b1b1b",
      "foreground": "#efebdc",
      "accent": "#e75a50",
      "success": "#e75a50",
      "warning": "#a99b7a",
      "danger": "#f44336",
      "info": "#e58980"
    },
    "color": {
      "success": "mix({palette.success}, contrast({palette.background}), 0.10)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.15)"
    }
  }
}
