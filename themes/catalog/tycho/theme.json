{
  "schemaVersion": 1,
  "name": "tycho",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#1e2125",
      "foreground": "#f0e9ec",
      "accent": "#bf8a81",
      "success": "#b4756b",
      "warning": "#c17a6a",
      "danger": "#976870",
      "info": "#9b826b"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.41)",
      "success": "mix({palette.success}, contrast({palette.background}), 0.15)",
      "warning": "mix({palette.warning}, contrast({palette.background}), 0.10)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.25)",
      "info": "mix({palette.info}, contrast({palette.background}), 0.14)"
    }
  }
}
