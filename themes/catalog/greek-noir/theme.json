{
  "schemaVersion": 1,
  "name": "greek-noir",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#171717",
      "foreground": "#ccd0cf",
      "accent": "#f25623",
      "success": "#f25623",
      "warning": "#757864",
      "danger": "#aeab94",
      "info": "#88a57d"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.37)",
      "success": "mix({palette.success}, contrast({palette.background}), 0.01)",
      "warning": "mix({palette.warning}, contrast({palette.background}), 0.16)"
    }
  }
}
