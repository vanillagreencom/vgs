{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "vgs",
  "author": "vgs",
  "themes": [
    {
      "name": "vgs",
      "appearance": "dark",
      "style": {
        "background": "#@{color.surface}",
        "border": "#@{color.border}",
        "border.variant": "#@{color.borderSubtle}",
        "border.focused": "#@{color.focus}",
        "border.selected": "#@{color.accent}",
        "border.disabled": "#@{color.borderSubtle}",
        "elevated_surface.background": "#@{color.surfaceRaised}",
        "surface.background": "#@{color.surface}",
        "element.background": "#@{color.surfaceRaised}",
        "element.hover": "#@{color.surfaceHover}",
        "element.active": "#@{color.borderStrong}",
        "element.selected": "#@{color.borderStrong}",
        "element.disabled": "#@{color.surface}",
        "ghost_element.hover": "#@{color.surfaceHover}",
        "ghost_element.active": "#@{color.borderStrong}",
        "ghost_element.selected": "#@{color.borderStrong}",
        "drop_target.background": "#@{color.accentSubtle}",
        "text": "#@{color.text}",
        "text.muted": "#@{color.textMuted}",
        "text.placeholder": "#@{color.textFaint}",
        "text.disabled": "#@{color.textDisabled}",
        "text.accent": "#@{color.accent}",
        "icon": "#@{color.text}",
        "icon.muted": "#@{color.textMuted}",
        "icon.accent": "#@{color.accent}",
        "status_bar.background": "#@{color.surface}",
        "title_bar.background": "#@{color.surface}",
        "title_bar.inactive_background": "#@{color.surfaceSunken}",
        "toolbar.background": "#@{color.background}",
        "tab_bar.background": "#@{color.surface}",
        "tab.inactive_background": "#@{color.surface}",
        "tab.active_background": "#@{color.background}",
        "panel.background": "#@{color.surface}",
        "panel.focused_border": "#@{color.focus}",
        "pane.focused_border": "#@{color.focus}",
        "scrollbar.thumb.background": "#@{color.border}",
        "scrollbar.thumb.hover_background": "#@{color.borderStrong}",
        "scrollbar.track.background": "#@{color.background}",
        "search.match_background": "#@{color.accentSubtle}",
        "editor.background": "#@{color.background}",
        "editor.foreground": "#@{color.text}",
        "editor.gutter.background": "#@{color.background}",
        "editor.active_line.background": "#@{color.surfaceRaised}",
        "editor.line_number": "#@{color.textFaint}",
        "editor.active_line_number": "#@{color.text}",
        "editor.invisible": "#@{color.textDisabled}",
        "editor.wrap_guide": "#@{color.borderSubtle}",
        "editor.indent_guide": "#@{color.borderSubtle}",
        "editor.indent_guide_active": "#@{color.border}",
        "editor.document_highlight.read_background": "#@{color.accentSubtle}",
        "terminal.background": "#@{color.background}",
        "terminal.foreground": "#@{color.text}",
        "terminal.ansi.black": "#@{terminal.color0}",
        "terminal.ansi.red": "#@{terminal.color1}",
        "terminal.ansi.green": "#@{terminal.color2}",
        "terminal.ansi.yellow": "#@{terminal.color3}",
        "terminal.ansi.blue": "#@{terminal.color4}",
        "terminal.ansi.magenta": "#@{terminal.color5}",
        "terminal.ansi.cyan": "#@{terminal.color6}",
        "terminal.ansi.white": "#@{terminal.color7}",
        "terminal.ansi.bright_black": "#@{terminal.color8}",
        "terminal.ansi.bright_red": "#@{terminal.color9}",
        "terminal.ansi.bright_green": "#@{terminal.color10}",
        "terminal.ansi.bright_yellow": "#@{terminal.color11}",
        "terminal.ansi.bright_blue": "#@{terminal.color12}",
        "terminal.ansi.bright_magenta": "#@{terminal.color13}",
        "terminal.ansi.bright_cyan": "#@{terminal.color14}",
        "terminal.ansi.bright_white": "#@{terminal.color15}",
        "error": "#@{color.danger}",
        "error.background": "#@{color.dangerSubtle}",
        "warning": "#@{color.warning}",
        "warning.background": "#@{color.warningSubtle}",
        "info": "#@{color.info}",
        "info.background": "#@{color.infoSubtle}",
        "success": "#@{color.success}",
        "success.background": "#@{color.successSubtle}",
        "hint": "#@{color.textFaint}",
        "created": "#@{color.success}",
        "modified": "#@{color.warning}",
        "deleted": "#@{color.danger}",
        "players": [{ "cursor": "#@{color.accent}", "background": "#@{color.accent}", "selection": "#@{color.selection}" }],
        "syntax": {
          "comment": { "color": "#@{color.textFaint}", "font_style": "italic" },
          "string": { "color": "#@{terminal.color2}" },
          "number": { "color": "#@{terminal.color6}" },
          "constant": { "color": "#@{terminal.color6}" },
          "boolean": { "color": "#@{terminal.color6}" },
          "keyword": { "color": "#@{terminal.color5}" },
          "function": { "color": "#@{terminal.color4}" },
          "type": { "color": "#@{terminal.color3}" },
          "variable": { "color": "#@{color.text}" },
          "property": { "color": "#@{color.text}" },
          "operator": { "color": "#@{color.textMuted}" },
          "punctuation": { "color": "#@{color.textMuted}" },
          "tag": { "color": "#@{terminal.color1}" },
          "attribute": { "color": "#@{terminal.color3}" },
          "title": { "color": "#@{color.accent}", "font_weight": 700 },
          "link_uri": { "color": "#@{color.info}" }
        }
      }
    }
  ]
}
