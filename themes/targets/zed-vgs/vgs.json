            "font_style": null,
            "font_weight": null
          },
          "punctuation.delimiter": {
            "color": "{outline}",
            "font_style": null,
            "font_weight": null
          },
          "punctuation.list_marker": {
            "color": "{color1}",
            "font_style": null,
            "font_weight": null
          },
          "punctuation.special": {
            "color": "{color1}",
            "font_style": null,
            "font_weight": null
          },
          "selector": {
            "color": "{color3}",
            "font_style": null,
            "font_weight": null
          },
          "selector.pseudo": {
            "color": "{color4}",
            "font_style": null,
            "font_weight": null
          },
          "string": {
            "color": "{color2}",
            "font_style": null,
            "font_weight": null
          },
          "string.escape": {
            "color": "{color6}",
            "font_style": null,
            "font_weight": null
          },
          "string.regex": {
            "color": "{color10}",
            "font_style": null,
            "font_weight": null
          },
          "string.special": {
            "color": "{color6}",
            "font_style": null,
            "font_weight": null
          },
          "string.special.symbol": {
            "color": "{color6}",
            "font_style": null,
            "font_weight": null
          },
          "tag": {
            "color": "{color4}",
            "font_style": null,
            "font_weight": null
          },
          "text.literal": {
            "color": "{color2}",
            "font_style": null,
            "font_weight": null
          },
          "title": {
            "color": "{color1}",
            "font_style": null,
            "font_weight": 700
          },
          "type": {
            "color": "{color3}",
            "font_style": "italic",
            "font_weight": null
          },
          "variable": {
            "color": "{foreground}",
            "font_style": null,
            "font_weight": null
          },
          "variable.special": {
            "color": "{color9}",
            "font_style": null,
            "font_weight": null
          },
          "variant": {
            "color": "{color4}",
            "font_style": null,
            "font_weight": null
          }
        }
