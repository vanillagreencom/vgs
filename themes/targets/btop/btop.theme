# The vgs theme for btop, linked as vgs.theme in btop's themes directory by
# vgsh theme apply. Select it once as the colour theme "vgs".
theme[main_bg]="#@{palette.background}"
theme[main_fg]="#@{palette.foreground}"
theme[title]="#@{color.textHeading}"
theme[hi_fg]="#@{palette.accent}"
theme[selected_bg]="#@{color.border}"
theme[selected_fg]="#@{color.textHeading}"
theme[inactive_fg]="#@{color.textFaint}"
theme[graph_text]="#@{color.textMuted}"
theme[meter_bg]="#@{color.surfaceRaised}"
theme[proc_misc]="#@{palette.info}"
theme[cpu_box]="#@{color.border}"
theme[mem_box]="#@{color.border}"
theme[net_box]="#@{color.border}"
theme[proc_box]="#@{color.border}"
theme[div_line]="#@{color.borderSubtle}"
theme[temp_start]="#@{palette.success}"
theme[temp_mid]="#@{palette.warning}"
theme[temp_end]="#@{palette.danger}"
theme[cpu_start]="#@{palette.success}"
theme[cpu_mid]="#@{palette.warning}"
theme[cpu_end]="#@{palette.danger}"
theme[free_start]="#@{terminal.color2}"
theme[free_mid]="#@{terminal.color2}"
theme[free_end]="#@{terminal.color10}"
theme[cached_start]="#@{terminal.color4}"
theme[cached_mid]="#@{terminal.color4}"
theme[cached_end]="#@{terminal.color12}"
theme[available_start]="#@{terminal.color3}"
theme[available_mid]="#@{terminal.color3}"
theme[available_end]="#@{terminal.color11}"
theme[used_start]="#@{terminal.color1}"
theme[used_mid]="#@{terminal.color1}"
theme[used_end]="#@{terminal.color9}"
theme[download_start]="#@{terminal.color5}"
theme[download_mid]="#@{terminal.color5}"
theme[download_end]="#@{terminal.color13}"
theme[upload_start]="#@{terminal.color6}"
theme[upload_mid]="#@{terminal.color6}"
theme[upload_end]="#@{terminal.color14}"
theme[process_start]="#@{palette.success}"
theme[process_mid]="#@{palette.warning}"
theme[process_end]="#@{palette.danger}"
