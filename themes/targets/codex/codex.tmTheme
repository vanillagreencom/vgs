<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>vgs</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.text}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>comment</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.textFaint}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>string</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{terminal.color2}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>constant</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{terminal.color3}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>variable</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.text}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>keyword, keyword.control, storage.modifier</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{terminal.color5}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>keyword.operator</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.textHeading}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>storage.type, entity.name.type, support, support.type</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{terminal.color6}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>entity.name.function, entity.name.tag, support.function</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{terminal.color4}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>punctuation</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.textMuted}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>markup.heading, entity.name.section</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.accent}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>markup.underline.link</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.info}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>markup.inserted, diff.inserted</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.success}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>markup.deleted, diff.deleted</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.danger}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>invalid</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.danger}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>entity.other.attribute-name</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{terminal.color6}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>markup.raw, markup.inline.raw, markup.fenced_code</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{terminal.color2}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>markup.quote</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.textFaint}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>markup.list, markup.list.numbered, markup.list.unnumbered</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.textMuted}</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>meta.diff, meta.diff.header, meta.diff.range</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@{color.accent}</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
