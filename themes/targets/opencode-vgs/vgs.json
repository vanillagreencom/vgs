      "light": "{light_accent}"
    },
    "secondary": {
      "dark": "{dark_secondary}",
      "light": "{light_secondary}"
    },
    "accent": {
      "dark": "{dark_tertiary}",
      "light": "{light_tertiary}"
    },
    "error": {
      "dark": "{dark_error}",
      "light": "{light_error}"
    },
    "warning": {
      "dark": "{dark_warning}",
      "light": "{light_warning}"
    },
    "success": {
      "dark": "{dark_success}",
      "light": "{light_success}"
    },
    "info": {
      "dark": "{dark_info}",
      "light": "{light_info}"
    },
    "text": {
      "dark": "{dark_foreground}",
      "light": "{light_foreground}"
    },
    "textMuted": {
      "dark": "{dark_muted}",
      "light": "{light_muted}"
