    "syntaxType": {
      "dark": "{dark_cyan}",
      "light": "{light_cyan}"
    },
    "syntaxOperator": {
      "dark": "{dark_bright_white}",
      "light": "{light_bright_white}"
    },
    "syntaxPunctuation": {
      "dark": "{dark_muted}",
      "light": "{light_muted}"
    }
  }
