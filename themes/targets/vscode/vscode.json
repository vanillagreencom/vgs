{
  "$schema": "vscode://schemas/color-theme",
  "name": "vgs",
  "type": "dark",
  "colors": {
    "foreground": "#@{color.text}",
    "descriptionForeground": "#@{color.textMuted}",
    "disabledForeground": "#@{color.textDisabled}",
    "errorForeground": "#@{color.danger}",
    "focusBorder": "#@{color.focus}",
    "contrastBorder": "#@{color.borderSubtle}",
    "widget.border": "#@{color.border}",
    "selection.background": "#@{color.selection}",
    "textLink.foreground": "#@{color.info}",
    "textLink.activeForeground": "#@{color.accentHover}",
    "button.background": "#@{color.accent}",
    "button.foreground": "#@{color.onAccent}",
    "button.hoverBackground": "#@{color.accentHover}",
    "badge.background": "#@{color.accent}",
    "badge.foreground": "#@{color.onAccent}",
    "input.background": "#@{color.surfaceSunken}",
    "input.foreground": "#@{color.text}",
    "input.border": "#@{color.border}",
    "input.placeholderForeground": "#@{color.textFaint}",
    "dropdown.background": "#@{color.surfaceRaised}",
    "dropdown.foreground": "#@{color.text}",
    "dropdown.border": "#@{color.border}",
    "list.activeSelectionBackground": "#@{color.borderStrong}",
    "list.activeSelectionForeground": "#@{color.text}",
    "list.inactiveSelectionBackground": "#@{color.surfaceRaised}",
    "list.hoverBackground": "#@{color.surfaceHover}",
    "list.highlightForeground": "#@{color.accent}",
    "activityBar.background": "#@{color.surface}",
    "activityBar.foreground": "#@{color.text}",
    "activityBar.inactiveForeground": "#@{color.textFaint}",
    "activityBar.border": "#@{color.borderSubtle}",
    "activityBarBadge.background": "#@{color.accent}",
    "activityBarBadge.foreground": "#@{color.onAccent}",
    "sideBar.background": "#@{color.surface}",
    "sideBar.foreground": "#@{color.text}",
    "sideBar.border": "#@{color.borderSubtle}",
    "sideBarSectionHeader.background": "#@{color.surfaceRaised}",
    "sideBarTitle.foreground": "#@{color.textMuted}",
    "editorGroupHeader.tabsBackground": "#@{color.surface}",
    "tab.activeBackground": "#@{color.background}",
    "tab.activeForeground": "#@{color.text}",
    "tab.inactiveBackground": "#@{color.surface}",
    "tab.inactiveForeground": "#@{color.textMuted}",
    "tab.border": "#@{color.borderSubtle}",
    "tab.activeBorderTop": "#@{color.accent}",
    "titleBar.activeBackground": "#@{color.surface}",
    "titleBar.activeForeground": "#@{color.text}",
    "titleBar.inactiveBackground": "#@{color.surfaceSunken}",
    "titleBar.inactiveForeground": "#@{color.textMuted}",
    "statusBar.background": "#@{color.surface}",
    "statusBar.foreground": "#@{color.text}",
    "statusBar.border": "#@{color.borderSubtle}",
    "panel.background": "#@{color.surface}",
    "panel.border": "#@{color.border}",
    "panelTitle.activeForeground": "#@{color.text}",
    "panelTitle.activeBorder": "#@{color.accent}",
    "editor.background": "#@{color.background}",
    "editor.foreground": "#@{color.text}",
    "editor.lineHighlightBackground": "#@{color.surfaceRaised}",
    "editor.selectionBackground": "#@{color.selection}",
    "editor.findMatchBackground": "#@{color.accentSubtle}",
    "editor.findMatchHighlightBackground": "#@{color.accentSubtle}",
    "editorCursor.foreground": "#@{color.accent}",
    "editorLineNumber.foreground": "#@{color.textFaint}",
    "editorLineNumber.activeForeground": "#@{color.text}",
    "editorWhitespace.foreground": "#@{color.textDisabled}",
    "editorIndentGuide.background1": "#@{color.borderSubtle}",
    "editorIndentGuide.activeBackground1": "#@{color.border}",
    "editorWidget.background": "#@{color.surfaceRaised}",
    "editorWidget.border": "#@{color.border}",
    "editorGutter.background": "#@{color.background}",
    "editorError.foreground": "#@{color.danger}",
    "editorWarning.foreground": "#@{color.warning}",
    "editorInfo.foreground": "#@{color.info}",
    "editorGutter.addedBackground": "#@{color.success}",
    "editorGutter.modifiedBackground": "#@{color.warning}",
    "editorGutter.deletedBackground": "#@{color.danger}",
    "scrollbarSlider.background": "#@{color.border}",
    "scrollbarSlider.hoverBackground": "#@{color.borderStrong}",
    "scrollbarSlider.activeBackground": "#@{color.borderStrong}",
    "terminal.background": "#@{color.background}",
    "terminal.foreground": "#@{color.text}",
    "terminal.ansiBlack": "#@{terminal.color0}",
    "terminal.ansiRed": "#@{terminal.color1}",
    "terminal.ansiGreen": "#@{terminal.color2}",
    "terminal.ansiYellow": "#@{terminal.color3}",
    "terminal.ansiBlue": "#@{terminal.color4}",
    "terminal.ansiMagenta": "#@{terminal.color5}",
    "terminal.ansiCyan": "#@{terminal.color6}",
    "terminal.ansiWhite": "#@{terminal.color7}",
    "terminal.ansiBrightBlack": "#@{terminal.color8}",
    "terminal.ansiBrightRed": "#@{terminal.color9}",
    "terminal.ansiBrightGreen": "#@{terminal.color10}",
    "terminal.ansiBrightYellow": "#@{terminal.color11}",
    "terminal.ansiBrightBlue": "#@{terminal.color12}",
    "terminal.ansiBrightMagenta": "#@{terminal.color13}",
    "terminal.ansiBrightCyan": "#@{terminal.color14}",
    "terminal.ansiBrightWhite": "#@{terminal.color15}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#@{color.textFaint}", "fontStyle": "italic" } },
    { "scope": ["string", "markup.inline.raw"], "settings": { "foreground": "#@{terminal.color2}" } },
    { "scope": ["constant", "constant.numeric", "constant.language"], "settings": { "foreground": "#@{terminal.color6}" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#@{terminal.color5}" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#@{terminal.color4}" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#@{terminal.color3}" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#@{color.text}" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#@{color.textMuted}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#@{terminal.color1}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#@{terminal.color3}" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#@{color.accent}", "fontStyle": "bold" } },
    { "scope": ["invalid"], "settings": { "foreground": "#@{color.danger}" } }
  ]
}
