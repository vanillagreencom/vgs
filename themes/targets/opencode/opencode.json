{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "#@{color.accent}",
    "secondary": "#@{terminal.color5}",
    "accent": "#@{terminal.color6}",
    "error": "#@{color.danger}",
    "warning": "#@{color.warning}",
    "success": "#@{color.success}",
    "info": "#@{color.info}",
    "text": "#@{color.text}",
    "textMuted": "#@{color.textMuted}",
    "selectedListItemText": "#@{color.onAccent}",
    "background": "#@{color.background}",
    "backgroundPanel": "#@{color.surface}",
    "backgroundElement": "#@{color.surfaceRaised}",
    "backgroundMenu": "#@{color.surfaceRaised}",
    "border": "#@{color.border}",
    "borderActive": "#@{color.accent}",
    "borderSubtle": "#@{color.borderSubtle}",
    "diffAdded": "#@{color.success}",
    "diffRemoved": "#@{color.danger}",
    "diffContext": "#@{color.textMuted}",
    "diffHunkHeader": "#@{color.info}",
    "diffHighlightAdded": "#@{terminal.color10}",
    "diffHighlightRemoved": "#@{terminal.color9}",
    "diffAddedBg": "#@{color.surface}",
    "diffRemovedBg": "#@{color.surface}",
    "diffContextBg": "#@{color.background}",
    "diffLineNumber": "#@{color.textFaint}",
    "diffAddedLineNumberBg": "#@{color.surface}",
    "diffRemovedLineNumberBg": "#@{color.surface}",
    "markdownText": "#@{color.text}",
    "markdownHeading": "#@{color.accent}",
    "markdownLink": "#@{color.info}",
    "markdownLinkText": "#@{color.accent}",
    "markdownCode": "#@{terminal.color2}",
    "markdownBlockQuote": "#@{color.textMuted}",
    "markdownEmph": "#@{terminal.color3}",
    "markdownStrong": "#@{color.textHeading}",
    "markdownHorizontalRule": "#@{color.borderSubtle}",
    "markdownListItem": "#@{color.accent}",
    "markdownListEnumeration": "#@{terminal.color6}",
    "markdownImage": "#@{color.info}",
    "markdownImageText": "#@{color.textMuted}",
    "markdownCodeBlock": "#@{color.text}",
    "syntaxComment": "#@{color.textFaint}",
    "syntaxKeyword": "#@{terminal.color5}",
    "syntaxFunction": "#@{terminal.color4}",
    "syntaxVariable": "#@{color.text}",
    "syntaxString": "#@{terminal.color2}",
    "syntaxNumber": "#@{terminal.color3}",
    "syntaxType": "#@{terminal.color6}",
    "syntaxOperator": "#@{color.textHeading}",
    "syntaxPunctuation": "#@{color.textMuted}"
  }
}
