{
  "app": "WezTerm",
  "encoder": "hex6",
  "files": [{ "template": "wezterm.lua", "destination": "wezterm.lua" }],
  "detect": ["wezterm"],
  "wiring": { "file": "wezterm/wezterm.lua", "line": "pcall(dofile, \"@{state}/wezterm.lua\")", "create": false },
  "reload": { "command": ["sh", "-c", "touch -c -- \"${XDG_CONFIG_HOME:-$HOME/.config}/wezterm/wezterm.lua\""], "timeoutMs": 5000 }
}
