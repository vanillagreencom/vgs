{
  "app": "WezTerm",
  "encoder": "hex6",
  "files": [{ "template": "wezterm.lua", "destination": "wezterm.lua" }],
  "detect": ["wezterm"],
  "wiring": { "file": "wezterm/wezterm.lua", "line": "pcall(dofile, \"@{state}/wezterm.lua\")", "create": false, "fallbacks": [".config/wezterm/wezterm.lua", ".wezterm.lua"] },
  "reload": { "command": ["touch", "-c", "--", "@{wiring}"], "timeoutMs": 5000 }
}
