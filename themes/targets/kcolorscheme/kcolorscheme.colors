# The vgs KDE colour scheme, linked into ~/.local/share/color-schemes/ as
# Vgs.colors by vgsh theme apply.
[General]
ColorScheme=Vgs
Name=Vgs

[ColorEffects:Disabled]
Color=#@{color.textDisabled}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=#@{color.border}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=#@{color.surfaceHover}
BackgroundNormal=#@{color.surfaceRaised}
DecorationFocus=#@{color.focus}
DecorationHover=#@{color.accentHover}
ForegroundActive=#@{color.accent}
ForegroundInactive=#@{color.textMuted}
ForegroundLink=#@{color.info}
ForegroundNegative=#@{color.danger}
ForegroundNeutral=#@{color.warning}
ForegroundNormal=#@{color.text}
ForegroundPositive=#@{color.success}
ForegroundVisited=#@{color.accent}

[Colors:Complementary]
BackgroundAlternate=#@{color.surface}
BackgroundNormal=#@{color.surfaceRaised}
DecorationFocus=#@{color.focus}
DecorationHover=#@{color.accentHover}
ForegroundActive=#@{color.accent}
ForegroundInactive=#@{color.textMuted}
ForegroundLink=#@{color.info}
ForegroundNegative=#@{color.danger}
ForegroundNeutral=#@{color.warning}
ForegroundNormal=#@{color.text}
ForegroundPositive=#@{color.success}
ForegroundVisited=#@{color.accent}

[Colors:Header]
BackgroundAlternate=#@{color.surface}
BackgroundNormal=#@{color.surfaceRaised}
DecorationFocus=#@{color.focus}
DecorationHover=#@{color.accentHover}
ForegroundActive=#@{color.accent}
ForegroundInactive=#@{color.textMuted}
ForegroundLink=#@{color.info}
ForegroundNegative=#@{color.danger}
ForegroundNeutral=#@{color.warning}
ForegroundNormal=#@{color.text}
ForegroundPositive=#@{color.success}
ForegroundVisited=#@{color.accent}

[Colors:Header][Inactive]
BackgroundAlternate=#@{color.surfaceRaised}
BackgroundNormal=#@{color.surface}
DecorationFocus=#@{color.focus}
DecorationHover=#@{color.accentHover}
ForegroundActive=#@{color.accent}
ForegroundInactive=#@{color.textMuted}
ForegroundLink=#@{color.info}
ForegroundNegative=#@{color.danger}
ForegroundNeutral=#@{color.warning}
ForegroundNormal=#@{color.text}
ForegroundPositive=#@{color.success}
ForegroundVisited=#@{color.accent}

[Colors:Selection]
BackgroundAlternate=#@{color.accentHover}
BackgroundNormal=#@{color.accent}
DecorationFocus=#@{color.focus}
DecorationHover=#@{color.accentHover}
ForegroundActive=#@{color.accent}
ForegroundInactive=#@{color.textMuted}
ForegroundLink=#@{color.info}
ForegroundNegative=#@{color.danger}
ForegroundNeutral=#@{color.warning}
ForegroundNormal=#@{color.onAccent}
ForegroundPositive=#@{color.success}
ForegroundVisited=#@{color.accent}

[Colors:Tooltip]
BackgroundAlternate=#@{color.surface}
BackgroundNormal=#@{color.surfaceRaised}
DecorationFocus=#@{color.focus}
DecorationHover=#@{color.accentHover}
ForegroundActive=#@{color.accent}
ForegroundInactive=#@{color.textMuted}
ForegroundLink=#@{color.info}
ForegroundNegative=#@{color.danger}
ForegroundNeutral=#@{color.warning}
ForegroundNormal=#@{color.text}
ForegroundPositive=#@{color.success}
ForegroundVisited=#@{color.accent}

[Colors:View]
BackgroundAlternate=#@{color.surfaceSunken}
BackgroundNormal=#@{color.background}
DecorationFocus=#@{color.focus}
DecorationHover=#@{color.accentHover}
ForegroundActive=#@{color.accent}
ForegroundInactive=#@{color.textMuted}
ForegroundLink=#@{color.info}
ForegroundNegative=#@{color.danger}
ForegroundNeutral=#@{color.warning}
ForegroundNormal=#@{color.text}
ForegroundPositive=#@{color.success}
ForegroundVisited=#@{color.accent}

[Colors:Window]
BackgroundAlternate=#@{color.surfaceRaised}
BackgroundNormal=#@{color.surface}
DecorationFocus=#@{color.focus}
DecorationHover=#@{color.accentHover}
ForegroundActive=#@{color.accent}
ForegroundInactive=#@{color.textMuted}
ForegroundLink=#@{color.info}
ForegroundNegative=#@{color.danger}
ForegroundNeutral=#@{color.warning}
ForegroundNormal=#@{color.text}
ForegroundPositive=#@{color.success}
ForegroundVisited=#@{color.accent}

[WM]
activeBackground=#@{color.surfaceRaised}
activeBlend=#@{color.text}
activeForeground=#@{color.text}
inactiveBackground=#@{color.surface}
inactiveBlend=#@{color.textMuted}
inactiveForeground=#@{color.textMuted}
