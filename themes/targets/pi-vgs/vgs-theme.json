{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "vgs-theme",
  "vars": {
    "bgPanel": "{surfaceContainerLow}",
    "bgElevated": "{surfaceContainerHigh}",
    "bgSelected": "{primaryContainer}",
    "bgToolPending": "{surfaceContainerLow}",
    "bgToolSuccess": "{successContainer}",
    "bgToolError": "{errorContainer}",
    "bgBase": "{background}",

    "fgPrimary": "{foreground}",
    "fgSecondary": "{bright_white}",
    "fgMuted": "{muted}",
    "fgDim": "{dim}",
    "onAccent": "{onPrimary}",

    "borderDefault": "{outline}",
    "borderAccentStrong": "{accent}",
    "borderSubtle": "{outlineVariant}",

    "accentPrimary": "{accent}",
    "accentSecondary": "{magenta}",
    "statusSuccess": "{success}",
    "statusWarning": "{warning}",
    "statusError": "{error}",

    "diffAddFg": "{success}",
    "diffRemoveFg": "{error}",
    "diffContextFg": "{muted}",

    "syntaxCommentRole": "{dim}",
    "syntaxKeywordRole": "{magenta}",
    "syntaxFunctionRole": "{blue}",
    "syntaxVariableRole": "{foreground}",
    "syntaxStringRole": "{green}",
    "syntaxNumberRole": "{yellow}",
    "syntaxTypeRole": "{cyan}",
    "syntaxOperatorRole": "{bright_white}",
    "syntaxPunctuationRole": "{muted}",

    "thinkingOffRole": "{dim}",
    "thinkingMinimalRole": "{muted}",
    "thinkingLowRole": "{cyan}",
    "thinkingMediumRole": "{accent}",
    "thinkingHighRole": "{magenta}",
    "thinkingXhighRole": "{red}",
    "thinkingMaxRole": "{bright_red}",

    "customMessageTextRole": "{yellow}"
  },
  "colors": {
    "accent": "accentPrimary",
    "border": "borderDefault",
    "borderAccent": "borderAccentStrong",
    "borderMuted": "borderSubtle",
    "success": "statusSuccess",
    "error": "statusError",
    "warning": "statusWarning",
    "muted": "fgMuted",
    "dim": "fgDim",
    "text": "fgPrimary",
    "thinkingText": "fgSecondary",

    "selectedBg": "bgSelected",
    "scrollbarTrack": "borderSubtle",
    "scrollbarThumb": "fgPrimary",
    "searchMatchBg": "bgSelected",
    "searchMatchText": "fgPrimary",
    "userMessageBg": "accentPrimary",
    "userMessageText": "onAccent",
    "customMessageBg": "bgPanel",
    "customMessageText": "customMessageTextRole",
    "customMessageLabel": "accentPrimary",
    "toolPendingBg": "bgToolPending",
    "toolSuccessBg": "bgToolSuccess",
    "toolErrorBg": "bgToolError",
    "toolTitle": "accentPrimary",
    "toolOutput": "fgPrimary",

    "mdHeading": "accentSecondary",
    "mdLink": "accentPrimary",
    "mdLinkUrl": "fgMuted",
    "mdCode": "accentSecondary",
    "mdCodeBlock": "syntaxStringRole",
    "mdCodeBlockBorder": "borderSubtle",
    "mdQuote": "fgSecondary",
    "mdQuoteBorder": "borderSubtle",
    "mdHr": "borderSubtle",
    "mdListBullet": "accentPrimary",

    "toolDiffAdded": "diffAddFg",
    "toolDiffRemoved": "diffRemoveFg",
    "toolDiffContext": "diffContextFg",

    "syntaxComment": "syntaxCommentRole",
    "syntaxKeyword": "syntaxKeywordRole",
    "syntaxFunction": "syntaxFunctionRole",
    "syntaxVariable": "syntaxVariableRole",
    "syntaxString": "syntaxStringRole",
    "syntaxNumber": "syntaxNumberRole",
    "syntaxType": "syntaxTypeRole",
    "syntaxOperator": "syntaxOperatorRole",
    "syntaxPunctuation": "syntaxPunctuationRole",

    "thinkingOff": "thinkingOffRole",
    "thinkingMinimal": "thinkingMinimalRole",
    "thinkingLow": "thinkingLowRole",
    "thinkingMedium": "thinkingMediumRole",
    "thinkingHigh": "thinkingHighRole",
    "thinkingXhigh": "thinkingXhighRole",
    "thinkingMax": "thinkingMaxRole",

    "bashMode": "statusSuccess"
  },
  "export": {
    "pageBg": "bgBase",
    "cardBg": "bgPanel",
    "infoBg": "bgElevated"
  }
}
