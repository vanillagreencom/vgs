{
  "$schema": "https://raw.githubusercontent.com/badlogic/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "vgs-theme",
  "vars": {
    "sourceBackground": "{background}",
    "sourceForeground": "{foreground}",
    "sourceSurfaceVariant": "{surfaceContainer}",
    "sourceOnSurfaceVariant": "{foreground}",
    "sourceAccent": "{accent}",
    "sourceOnAccent": "{onPrimary}",
    "sourceAccentAlt": "{magenta}",

    "bg": "{background}",
    "fg": "{foreground}",
    "altBg": "{surfaceContainer}",
    "muted": "{muted}",
    "dim": "{dim}",
    "accent": "{accent}",
    "red": "{red}",
    "green": "{green}",
    "yellow": "{yellow}",
    "blue": "{blue}",
    "magenta": "{magenta}",
    "cyan": "{cyan}",
    "brBlue": "{bright_blue}",
    "brMagenta": "{bright_magenta}",

    "ansiBlack": "{black}",
    "ansiRed": "{red}",
    "ansiGreen": "{green}",
    "ansiYellow": "{yellow}",
    "ansiBlue": "{blue}",
    "ansiMagenta": "{magenta}",
    "ansiCyan": "{cyan}",
    "ansiWhite": "{white}",
    "ansiBrightBlack": "{bright_black}",
    "ansiBrightRed": "{bright_red}",
    "ansiBrightGreen": "{bright_green}",
    "ansiBrightYellow": "{bright_yellow}",
    "ansiBrightBlue": "{bright_blue}",
    "ansiBrightMagenta": "{bright_magenta}",
    "ansiBrightCyan": "{bright_cyan}",
    "ansiBrightWhite": "{bright_white}",

    "bgBase": "{background}",
    "bgPanel": "{surfaceContainerLow}",
    "bgElevated": "{surfaceContainerHigh}",
    "bgSelected": "{primaryContainer}",
    "bgToolPending": "{surfaceContainerLow}",
    "bgToolSuccess": "{successContainer}",
    "bgToolWarning": "{warningContainer}",
    "bgToolError": "{errorContainer}",
    "fgPrimary": "{foreground}",
    "fgSecondary": "{bright_white}",
    "fgMuted": "{muted}",
    "fgDim": "{dim}",
    "borderDefault": "{outline}",
    "borderAccentStrong": "{accent}",
    "borderSubtle": "{outlineVariant}",
    "accentPrimary": "{accent}",
    "accentSecondary": "{magenta}",
    "statusSuccess": "{success}",
    "statusWarning": "{warning}",
    "statusError": "{error}",
    "statusInfo": "{info}",
    "diffAddFg": "{success}",
    "diffRemoveFg": "{error}",
    "diffContextFg": "{muted}",
    "diffAddBg": "{successContainer}",
    "diffRemoveBg": "{errorContainer}",
    "syntaxCommentRole": "{dim}",
    "syntaxKeywordRole": "{magenta}",
    "syntaxFunctionRole": "{blue}",
    "syntaxVariableRole": "{foreground}",
    "syntaxStringRole": "{green}",
    "syntaxNumberRole": "{yellow}",
    "syntaxTypeRole": "{cyan}",
    "syntaxOperatorRole": "{bright_white}",
    "syntaxPunctuationRole": "{muted}",
    "thinkingOffRole": "{dim}",
    "thinkingMinimalRole": "{muted}",
    "thinkingLowRole": "{cyan}",
    "thinkingMediumRole": "{accent}",
    "thinkingHighRole": "{magenta}",
    "thinkingXhighRole": "{red}"
