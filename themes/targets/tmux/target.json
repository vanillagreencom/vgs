{
  "app": "tmux",
  "runsCode": true,
  "encoder": "hex6",
  "files": [{ "template": "tmux.conf", "destination": "tmux.conf" }],
  "detect": ["tmux"],
  "wiring": { "file": "tmux/tmux.conf", "line": "source-file -q '@{state}/tmux.conf'", "create": false },
  "reload": { "command": ["sh", "-c", "tmux list-sessions >/dev/null 2>&1 || exit 0; exec tmux source-file -q \"$1\"", "sh", "@{state}/tmux.conf"], "timeoutMs": 5000 }
}
