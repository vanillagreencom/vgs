    "interface": "#d5d5d5",
    "enum": "#d5d5d5",
    "enumMember": "#707070",
    "typeParameter": "#d5d5d5",
    "namespace": "#c4693d",
    "decorator": "#b14242",
    "keyword": "#b14242",
    "string": "#df6464",
    "number": "#4a8b8b",
    "*.declaration": {
      "bold": false
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#737373",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": "variable, string constant.other.placeholder",
      "settings": {
        "foreground": "#b4b4b4"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": "variable.parameter, meta.function.parameter, entity.name.variable.parameter",
      "settings": {
        "foreground": "#d5d5d5",
