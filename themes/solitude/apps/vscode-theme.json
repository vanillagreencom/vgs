    "variable.defaultLibrary": "#4a8b8b",
    "property": "#d5d5d5",
    "property.readonly": "#d5d5d5",
    "function": "#e5e5e5",
    "function.defaultLibrary": "#e5e5e5",
    "method": "#e5e5e5",
    "macro": "#e5e5e5",
    "class": "#e5e5e5",
    "type": "#d5d5d5",
    "type.defaultLibrary": "#4a8b8b",
