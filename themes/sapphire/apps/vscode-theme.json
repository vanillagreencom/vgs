      "bold": false
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#6060a4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": "variable, string constant.other.placeholder",
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": "variable.parameter, meta.function.parameter, entity.name.variable.parameter",
      "settings": {
        "foreground": "#f6f8ff",
        "fontStyle": "italic"
      }
