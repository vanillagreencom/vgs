{
  "schemaVersion": 1,
  "id": "vgs.bar",
  "name": "Bar",
  "version": "0.3.0",
  "author": "VanillaGreen",
  "description": "The top bar. Draws its own workspaces and clock, and lays out plugin widgets in left, center and right sections.",
  "license": "MIT",
  "icon": "panel-top",
  "kinds": [
    "bar"
  ],
  "entryPoints": {
    "bar": "Bar.qml"
  },
  "capabilities": [
    "builtins",
    "compositor"
  ],
  "settings": {
    "left": ["workspaces"],
    "center": ["clock"],
    "right": [],
    "clockFormat": "ddd d MMM  HH:mm"
  },
  "schema": {
    "clockFormat": {
      "type": "string",
      "label": "Clock format",
      "description": "How the bar's clock shows the date and time",
      "format": "datetime",
      "allowCustom": true,
      "presets": [
        { "value": "ddd d MMM  HH:mm" },
        { "value": "ddd d MMM  h:mm AP" },
        { "value": "dddd HH:mm" },
        { "value": "dddd h:mm AP" },
        { "value": "HH:mm" },
        { "value": "h:mm AP" },
        { "value": "HH:mm:ss" },
        { "value": "yyyy-MM-dd HH:mm" },
        { "value": "ddd d MMM" }
      ]
    }
  }
}
