#%PAM-1.0
# The lock screen's password check, read by the lock's PamContext from this
# directory (its configDirectory), so no file under /etc is installed. It is
# Omarchy's omarchy-lock-password stack, auth lines only, since PamContext
# runs only the auth type: pam_faillock allows ten wrong passwords before a
# two-minute pause, and a success clears the count.
auth       required                    pam_faillock.so preauth silent deny=10 unlock_time=120
-auth      [success=2 default=ignore]  pam_systemd_home.so
auth       [success=1 default=bad]     pam_unix.so try_first_pass nullok
auth       [default=die]               pam_faillock.so authfail deny=10 unlock_time=120
auth       optional                    pam_permit.so
auth       required                    pam_env.so
auth       required                    pam_faillock.so authsucc
