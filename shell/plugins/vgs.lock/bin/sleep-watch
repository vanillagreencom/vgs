#!/usr/bin/env bash
# sleep-watch: vgs.lock's before-sleep hook, run under
#   systemd-inhibit --what=sleep --mode=delay -- setpriv --pdeathsig TERM -- sleep-watch
# so logind holds every suspend until this process exits, for at most its
# InhibitDelayMaxUSec. It prints, one line each, on stdout:
#   ready budget_ms=<n>     the inhibitor holds and the listener is live;
#                           n is the lock budget
#   sleep budget_ms=<n>     logind prepares for sleep: lock now
#   released reason=<r>     secure, refused, timeout or closed; it exits
# After `sleep` it waits for one line on stdin, for at most the budget:
# `secure`, the service's word that the session lock is confirmed, or
# `refused`, that the compositor refused it. Then it exits 0, which
# releases the inhibitor and lets the suspend go on. stdin closing is
# reason=closed. The service starts it again after each exit. TERM, such as
# the one setpriv delivers when systemd-inhibit is stopped, ends it, and
# bash runs its EXIT trap, which ends its dbus-monitor, so no listener
# outlives the hook.
#
# No PrepareForSleep is lost between taking the inhibitor and listening.
# It subscribes first and waits for dbus-monitor's first line, the bus's
# NameAcquired, which dbus-monitor prints only once its match is added.
# Then it asks logind whether a preparation is already under way,
# PreparingForSleep, and takes one for a sleep; `ready` follows that check.
#
# The budget follows Omarchy's bin/omarchy-system-sleep-lock: logind's
# InhibitDelayMaxUSec less a fifth of it, at least 1000 ms kept for logind,
# capped at 12000 ms; 5 s, logind's default, when the window is unreadable.
# An overrun is what the budget prevents: past its window logind stops
# honouring the inhibitor and suspends with the lock half taken.
#
# Refusals, one keyed line on stderr, exit 1:
#   sleep-watch: refused: monitor=silent             no first line in 2 s
#   sleep-watch: refused: monitor=exited status=<n>   dbus-monitor ended
set -euo pipefail

budget_cap_ms=12000

derive_budget_ms() {
  local window
  window="$(timeout --kill-after=0.1s 1s busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null)" || window=""
  window="${window##* }"
  [[ $window =~ ^[0-9]+$ ]] && ((window > 0)) || window=5000000
  window=$((window / 1000))
  window=$((window - (window / 5 > 1000 ? window / 5 : 1000)))
  ((window > 0)) || window=1
  if ((window < budget_cap_ms)); then echo "$window"; else echo "$budget_cap_ms"; fi
}

monitor_exit() {
  local status=0
  wait "$monitor_pid" || status=$?
  printf 'sleep-watch: refused: monitor=exited status=%s\n' "$status" >&2
  exit 1
}

# One sleep: announce it, wait for the service's word, release.
sleep_once() {
  local reply
  echo "sleep budget_ms=$budget_ms"
  if IFS= read -r -t "$budget_s" reply; then
    case "$reply" in
      secure) echo "released reason=secure" ;;
      refused) echo "released reason=refused" ;;
      *) echo "released reason=timeout" ;;
    esac
  elif (($? > 128)); then
    echo "released reason=timeout"
  else
    echo "released reason=closed"
  fi
  exit 0
}

coproc MONITOR { exec dbus-monitor --system "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"; }
monitor_pid=$MONITOR_PID
# Bash unsets MONITOR when the coprocess ends, so the reads use a copy.
exec {monitor_fd}<&"${MONITOR[0]}"
trap 'kill "$monitor_pid" 2>/dev/null || :' EXIT
if ! IFS= read -r -t 2 line <&"$monitor_fd"; then
  kill -0 "$monitor_pid" 2>/dev/null || monitor_exit
  printf 'sleep-watch: refused: monitor=silent\n' >&2
  exit 1
fi
preparing="$(timeout --kill-after=0.1s 1s busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
  org.freedesktop.login1.Manager PreparingForSleep 2>/dev/null)" || preparing=""
budget_ms="$(derive_budget_ms)"
printf -v budget_s '%d.%03d' $((budget_ms / 1000)) $((budget_ms % 1000))
echo "ready budget_ms=$budget_ms"
[[ $preparing != "b true" ]] || sleep_once

while IFS= read -r line <&"$monitor_fd"; do
  [[ $line == *"boolean true"* ]] || continue
  sleep_once
done
monitor_exit
