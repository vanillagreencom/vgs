#!/usr/bin/env bash
# Compose every update probe for vgs.updates and atomically publish one cache:
# ${XDG_STATE_HOME:-~/.local/state}/vgs/updates/status.json.
set -euo pipefail

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
runtime_dir="${XDG_RUNTIME_DIR:-$state_home}"
state_dir="$state_home/vgs/updates"
lock_dir="$runtime_dir/vgs/updates"
mkdir -p -- "$state_dir" "$lock_dir"
lock="$lock_dir/check.lock"
status_file="$state_dir/status.json"
vgsh="${VGS_UPDATES_VGSH:-vgsh}"
script="$(readlink -f -- "${BASH_SOURCE[0]}")"
plugin_dir="$(cd -- "$(dirname -- "$script")/.." && pwd)"
logic="$plugin_dir/UpdatesLogic.js"
prefix="$$"

exec 9>"$lock"
flock 9

child=""
cleanup_files=()
cleanup() {
  local file
  for file in "${cleanup_files[@]}"; do rm -f -- "$file"; done
}
stop_child() {
  if [[ -n $child ]]; then kill -TERM "$child" 2>/dev/null || true; fi
}
trap 'stop_child; cleanup; exit 143' TERM
trap 'stop_child; cleanup; exit 130' INT
trap 'stop_child; cleanup; exit 129' HUP
trap cleanup EXIT

run_probe() {
  local name="$1" out err stat status=0
  out="$state_dir/.${name}.${prefix}.out"
  err="$state_dir/.${name}.${prefix}.err"
  stat="$state_dir/.${name}.${prefix}.status"
  shift
  cleanup_files+=("$out" "$err" "$stat")
  "$@" >"$out" 2>"$err" &
  child=$!
  wait "$child" || status=$?
  child=""
  printf '%s\n' "$status" >"$stat"
}

run_probe pkg "$vgsh" pkg check --json
run_probe self "$vgsh" self status --json
run_probe plugins "$vgsh" plugin outdated --json
run_probe themes "$vgsh" theme outdated --json

snapshot="$state_dir/.status.${prefix}.json"
cleanup_files+=("$snapshot")
node - "$logic" "$state_dir" "$prefix" <<'NODE' >"$snapshot"
const fs = require("fs");
const vm = require("vm");
function load(file) {
  const source = fs.readFileSync(file, "utf8");
  const pragma = ".pragma library\n";
  if (!source.startsWith(pragma)) throw new Error("pragma=missing path=" + file);
  const library = {};
  vm.runInNewContext(source.slice(pragma.length), library, { filename: file });
  return library;
}
const logic = load(process.argv[2]);
const dir = process.argv[3];
const prefix = process.argv[4];
function read(name) {
  return {
    status: Number(fs.readFileSync(`${dir}/.${name}.${prefix}.status`, "utf8")),
    stdout: fs.readFileSync(`${dir}/.${name}.${prefix}.out`, "utf8"),
    stderr: fs.readFileSync(`${dir}/.${name}.${prefix}.err`, "utf8")
  };
}
const probes = { pkg: read("pkg"), self: read("self"), plugins: read("plugins"), themes: read("themes") };
process.stdout.write(JSON.stringify(logic.normalizeSnapshot(probes, Date.now())) + "\n");
NODE
mv -f -- "$snapshot" "$status_file"
cat -- "$status_file"
