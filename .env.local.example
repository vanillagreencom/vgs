# Copy to .env.local and supply the secrets required by enabled tools.
# Keep public defaults in kendex.settings.toml. The worktree skill links
# .env.local into worktrees. The Linear skill auth-check action reports
# which configuration source supplied its API key.

# Used by: linear (every live command and `sync`; cache reads work without it)
# Set to: a Linear personal API key (Settings -> Security & access -> API keys).
# The team it targets is LINEAR_TEAM in kendex.settings.toml, not here.
LINEAR_API_KEY=""

# Used by: deep-research / researcher agents.
# Set to: provider API keys for whichever research backends you enable.
PERPLEXITY_API_KEY=""
GEMINI_API_KEY=""
JINA_API_KEY=""
OPENAI_API_KEY=""
