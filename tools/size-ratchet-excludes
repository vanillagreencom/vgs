# kendex-guard-dialect: legacy-glob
# Exclusions use pattern<TAB>reason. Globs match full repository paths; * crosses /.
# Shipped path classes set limits. Tests outside those classes use the default
# limit and may require a frozen baseline entry.
backend/vendor/*	vendored Go modules (go mod vendor for offline Nix builds), upstream-owned
config/vshell/nvim/colorschemes/*	vendored upstream colorscheme plugins, upstream-owned
third_party/*	byte-pinned vendored trees (coderabbit-schema, asdcontrol)
quickshell/*/assets/*	shipped binary/data assets, not source
themes/*/apps/*	generated per-app theme outputs inside theme packages, not source
themes/*/backgrounds/*	shipped background images inside theme packages, not source
themes/*/theme.json	theme-package palette data, not source
themes/*/colors.toml	theme-package palette data, not source
themes/*/preview.png	theme-package preview image, not source
themes/catalog.json	generated theme catalog index, regenerated from packages
.agents/*	vendored kendex install, upstream-owned
.coderabbit.yaml	skill path lists grow one line per UPSTREAM-shipped skill; check-owned-skills.py makes the line mandatory
.claude/hooks/block-repo-copy.sh	kendex-rendered hook copy, 511 lines, source owned upstream
.codex/hooks/block-repo-copy.sh	kendex-rendered hook copy, 511 lines, source owned upstream
.pi/kendex/hooks/block-repo-copy.sh	kendex-rendered hook copy, 511 lines, source owned upstream
.github/workflows/review-gate-writer.yml	adopted verbatim from the review-gate template kendex ships; validate.sh holds it to equality, so its size is the template's
