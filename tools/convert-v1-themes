#!/usr/bin/env node
// Convert v1 theme packages into the judged v2 catalog.
//
// Usage:
//   tools/convert-v1-themes <v1-tree> [--theme NAME ...]
//       [--catalog-dir themes/catalog] [--asset-cache DIR]
//       [--asset-base URL] [--allow-file-base]
//       [--thumbnail-budget BYTES]
//
// The v1 tree is read only. Output packages are written below the catalog
// directory, with thumbnails in catalog/thumbnails/. Archives download once
// into the content-addressed cache `${XDG_CACHE_HOME:-$HOME/.cache}/vgs/theme-assets/<sha256>.tar.gz` unless --asset-cache names another directory.
// --asset-base overrides v1 catalog.json's source.baseUrl. HTTPS is the only
// normal transport, redirects included; file:// is accepted only with
// --allow-file-base for tests. The fetch and the archive reader are
// bin/lib/theme-download.js, which `vgsh theme wallpapers` shares; this
// converter refuses links and unsupported member types under backgrounds/.
// Exit 0: converted. Exit 1: refused input or output. Exit 2: unreadable or
// I/O failure.
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

const repo = path.join(__dirname, "..");
const { load } = require(path.join(repo, "bin", "lib", "qml-library.js"));
const logic = load(path.join(repo, "shell", "Commons", "ThemeLogic.js"));
const tokens = load(path.join(repo, "shell", "Commons", "Tokens.js")).TOKENS;
const { Refusal, replaceFile } = require(path.join(repo, "bin", "lib", "judge-files.js"));
const backgrounds = require(path.join(repo, "bin", "lib", "theme-backgrounds.js"));
const download = require(path.join(repo, "bin", "lib", "theme-download.js"));

const THUMBNAIL_WIDTH = 480;
const DEFAULT_THUMBNAIL_BUDGET = 120000;
const EXIT_REFUSED = 1;
const EXIT_IO = 2;
const REQUIRED_COLORS = ["accent", "foreground", "background", ...Array.from({ length: 16 }, (_, index) => `color${index}`)];
const PALETTE_FROM_COLORS = [
    ["background", "background"],
    ["foreground", "foreground"],
    ["accent", "accent"],
    ["success", "color2"],
    ["warning", "color3"],
    ["danger", "color1"],
    ["info", "color4"]
];
const COLOR_OVERRIDE_ORDER = ["textMuted", "textFaint", "success", "warning", "danger", "info"];
// Readability roles fixed at the palette level, each with the palette
// colour its token default reads. Other roles derive from that colour too,
// so the fix changes the palette colour, not the role's expression.
const PALETTE_OVERRIDE_ROLES = { text: "foreground", accent: "accent" };
// The judged boundary roles (ThemeLogic.BOUNDARY_ROLES) whose token
// default is color.accent: a shortfall of one against a surface is fixed
// by the accent's lift, as accent text is.
const tokenDefault = name => name.split(".").reduce((node, key) => (node === undefined ? undefined : node[key]), tokens);
const ACCENT_BOUNDARIES = logic.BOUNDARY_ROLES.filter(role => { const leaf = tokenDefault(role); return leaf !== undefined && leaf.value === "{color.accent}"; });
const FIXABLE_READABILITY = new Set(COLOR_OVERRIDE_ORDER.concat(Object.keys(PALETTE_OVERRIDE_ROLES)).map(role => `color.${role}`).concat(ACCENT_BOUNDARIES));
const STATUS_ROLES = ["success", "warning", "danger", "info"];
const TERMINAL_SLOTS = Array.from({ length: 16 }, (_, index) => `color${index}`);
const REPO_HOST = "https://github.com/";

class ConvertExit extends Error {
    constructor(status, line) {
        super(line);
        this.status = status;
        this.line = line;
    }
}

function message(kind, detail) {
    return `convert-v1-themes: ${kind}: ${detail}`;
}

function refuse(theme, key, detail) {
    throw new ConvertExit(EXIT_REFUSED, message("refused", `theme=${theme} key=${key}${detail === "" ? "" : " " + detail}`));
}

function refuseGlobal(key, detail) {
    throw new ConvertExit(EXIT_REFUSED, message("refused", `${key}${detail === "" ? "" : " " + detail}`));
}

function unreadable(file, cause) {
    throw new ConvertExit(EXIT_IO, message("unreadable", `path=${file} error=${cause}`));
}

function usage(detail) {
    throw new ConvertExit(EXIT_IO, message("refused", detail));
}

function readFile(file, encoding = "utf8") {
    try {
        return fs.readFileSync(file, encoding);
    } catch (e) {
        unreadable(file, e.code || e.message);
    }
}

function readJson(file) {
    const text = readFile(file, "utf8");
    try {
        return JSON.parse(text);
    } catch (e) {
        unreadable(file, "unparseable");
    }
}

function writeJson(value) {
    return JSON.stringify(value, null, 2) + "\n";
}

function codeUnitCompare(a, b) {
    return a < b ? -1 : a > b ? 1 : 0;
}

function parseArgs(argv) {
    const args = {
        v1Tree: null,
        themes: [],
        catalogDir: path.join(repo, "themes", "catalog"),
        assetCache: null,
        assetBase: null,
        allowFileBase: false,
        thumbnailBudget: DEFAULT_THUMBNAIL_BUDGET
    };
    for (let i = 0; i < argv.length; i++) {
        const arg = argv[i];
        const value = () => {
            if (i + 1 >= argv.length || argv[i + 1].startsWith("--")) usage(`argument=${arg} reason=missing-value`);
            i += 1;
            return argv[i];
        };
        if (arg === "--theme") args.themes.push(value());
        else if (arg === "--catalog-dir") args.catalogDir = path.resolve(value());
        else if (arg === "--asset-cache") args.assetCache = path.resolve(value());
        else if (arg === "--asset-base") args.assetBase = value().replace(/\/+$/, "");
        else if (arg === "--allow-file-base") args.allowFileBase = true;
        else if (arg === "--thumbnail-budget") {
            const raw = value();
            const budget = Number(raw);
            if (!Number.isSafeInteger(budget) || budget <= 0) usage(`thumbnail-budget=${raw} reason=invalid`);
            args.thumbnailBudget = budget;
        } else if (arg === "--help") {
            process.stdout.write(readFile(__filename, "utf8").split("\n").slice(0, 16).join("\n") + "\n");
            process.exit(0);
        } else if (arg.startsWith("--")) usage(`argument=${arg}`);
        else if (args.v1Tree === null) args.v1Tree = path.resolve(arg);
        else usage(`argument=${arg}`);
    }
    if (args.v1Tree === null) usage("v1-tree=missing");
    args.assetCache = args.assetCache || download.cacheDir();
    return args;
}

function parseTomlColors(theme, file, required, colorKeysOnly) {
    const out = {};
    const lines = readFile(file, "utf8").split(/\r?\n/);
    for (let index = 0; index < lines.length; index++) {
        const line = lines[index];
        if (/^\s*(#.*)?$/.test(line)) continue;
        const match = /^([A-Za-z0-9_]+)\s*=\s*"(#[0-9A-Fa-f]{6})"\s*$/.exec(line);
        if (match === null) refuse(theme, `${path.basename(file)}:${index + 1}`, `line=${JSON.stringify(line)}`);
        const key = match[1];
        if (colorKeysOnly && !/^color([0-9]|1[0-5])$/.test(key)) refuse(theme, `${path.basename(file)}.${key}`, "reason=unknown-key");
        if (Object.hasOwn(out, key)) refuse(theme, `${path.basename(file)}.${key}`, "reason=duplicate");
        out[key] = match[2].toLowerCase();
    }
    for (const key of required) {
        if (!Object.hasOwn(out, key)) refuse(theme, `${path.basename(file)}.${key}`, "reason=missing");
    }
    return out;
}

function modeOptions() {
    return logic.nodeAt(tokens, "scheme.mode").options;
}

function repoUrl(repoName) {
    if (typeof repoName !== "string" || !/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(repoName)) refuseGlobal("catalog.source.repo", `value=${JSON.stringify(repoName)}`);
    return REPO_HOST + repoName;
}

function pinFromV1(theme, catalog, lock) {
    if (!catalog || catalog.version !== 2 || !catalog.source || !Array.isArray(catalog.themes)) refuseGlobal("catalog.json", "reason=malformed");
    if (!lock || lock.version !== 2 || !lock.themes) refuseGlobal("asset-lock.json", "reason=malformed");
    const catalogTheme = catalog.themes.find(entry => entry && entry.name === theme);
    if (catalogTheme === undefined || catalogTheme.assets === undefined) refuse(theme, "catalog.json", "reason=missing-pin");
    const locked = lock.themes[theme];
    if (locked === undefined) refuse(theme, "asset-lock.json", "reason=missing-pin");
    const keys = ["release", "archive", "rev", "size", "sha256"];
    for (const key of keys) {
        if (catalogTheme.assets[key] !== locked[key]) refuse(theme, `pin.${key}`, `catalog=${JSON.stringify(catalogTheme.assets[key])} lock=${JSON.stringify(locked[key])}`);
    }
    if (catalog.source.repo !== lock.repo) refuse(theme, "pin.repo", `catalog=${JSON.stringify(catalog.source.repo)} lock=${JSON.stringify(lock.repo)}`);
    return {
        repo: repoUrl(lock.repo),
        release: locked.release,
        archive: locked.archive,
        size: locked.size,
        sha256: locked.sha256
    };
}

function cloneJson(value) {
    return JSON.parse(JSON.stringify(value));
}

function truncateRatio(value) {
    return Math.floor(value * 100) / 100;
}

function ratioText(shortfall) {
    return shortfall.ratio === null ? "translucent" : truncateRatio(shortfall.ratio).toFixed(2);
}

function roleShortfall(shortfalls, role) {
    return shortfalls.find(shortfall => shortfall.text === `color.${role}`);
}

function resolvedShell(theme, shell) {
    const result = logic.accept(tokens, writeJson(shell));
    if (!result.ok) refuse(theme, "theme.json", logic.refusalLine(result));
    return result;
}

function shortfallsFor(theme, shell) {
    return logic.readabilityShortfalls(resolvedShell(theme, shell).values);
}

function withColorOverride(shell, role, expression) {
    const candidate = cloneJson(shell);
    candidate.tokens.color = candidate.tokens.color || {};
    candidate.tokens.color[role] = expression;
    return candidate;
}

function withPaletteOverride(shell, role, value) {
    const candidate = cloneJson(shell);
    candidate.tokens.palette[role] = value;
    return candidate;
}

function hex6(colour) {
    return colour.endsWith("ff") ? colour.slice(0, 7) : colour;
}

function paletteForEntry(theme, shell) {
    const resolved = resolvedShell(theme, shell).values.palette;
    const out = {};
    for (const [target] of PALETTE_FROM_COLORS) out[target] = hex6(resolved[target]);
    return out;
}

function fadeExpression(step) {
    return `mix({palette.foreground}, {palette.background}, ${(step / 100).toFixed(2)})`;
}

function fadeDefaultAmount(token) {
    const value = logic.nodeAt(tokens, token).value;
    const parsed = typeof value === "string" ? logic.parseExpression(value) : { error: "not-expression" };
    const valid = parsed.error === undefined && parsed.kind === "call" && parsed.name === "mix" && parsed.args.length === 3
        && parsed.args[0].kind === "reference" && parsed.args[0].path === "palette.foreground"
        && parsed.args[1].kind === "reference" && parsed.args[1].path === "palette.background"
        && parsed.args[2].kind === "number" && parsed.args[2].value > 0 && parsed.args[2].value <= 1;
    if (!valid) refuseGlobal(`token=${token}`, `reason=fade-shape value=${JSON.stringify(value)}`);
    return parsed.args[2].value;
}

function fadeDefaults() {
    return { textMuted: fadeDefaultAmount("color.textMuted"), textFaint: fadeDefaultAmount("color.textFaint") };
}

function stepBelow(amount) {
    return Math.floor(amount * 100 + 0.0000001) - 1;
}

function proportionalMutedCap(defaults, faintAmount) {
    return Math.floor(faintAmount * (defaults.textMuted / defaults.textFaint) * 100) / 100;
}

function contrastMixExpression(role, step) {
    return `mix({palette.${role}}, contrast({palette.background}), ${(step / 100).toFixed(2)})`;
}

// The mix amount of color.textHeading's default. The text family lifts
// palette.foreground along the same line, and a lift below this amount
// keeps headings stronger than body text.
function headingDefaultAmount() {
    const value = logic.nodeAt(tokens, "color.textHeading").value;
    const parsed = typeof value === "string" ? logic.parseExpression(value) : { error: "not-expression" };
    const toward = parsed.error === undefined && parsed.kind === "call" && parsed.args.length === 3 ? parsed.args[1] : null;
    const valid = toward !== null && parsed.name === "mix"
        && parsed.args[0].kind === "reference" && parsed.args[0].path === "palette.foreground"
        && toward.kind === "call" && toward.name === "contrast" && toward.args.length === 1
        && toward.args[0].kind === "reference" && toward.args[0].path === "palette.background"
        && parsed.args[2].kind === "number" && parsed.args[2].value > 0 && parsed.args[2].value <= 1;
    if (!valid) refuseGlobal("token=color.textHeading", `reason=heading-shape value=${JSON.stringify(value)}`);
    return parsed.args[2].value;
}

// The opaque colour that ROLE's palette colour becomes when mixed STEP
// hundredths toward contrast({palette.background}), resolved through
// ThemeLogic.accept so that 8-bit rounding is part of the value.
function liftedPaletteLiteral(theme, shell, role, step) {
    const probe = withColorOverride(shell, role, contrastMixExpression(PALETTE_OVERRIDE_ROLES[role], step));
    return hex6(resolvedShell(theme, probe).values.color[role]);
}

function addReadabilityOverrides(theme, shell) {
    let fixed = cloneJson(shell);
    const defaults = fadeDefaults();
    const headingAmount = headingDefaultAmount();
    const initialShortfalls = shortfallsFor(theme, fixed);
    const firstUnfixable = initialShortfalls.find(shortfall => !FIXABLE_READABILITY.has(shortfall.text));
    if (firstUnfixable !== undefined) return { held: true, shortfall: firstUnfixable };

    if (roleShortfall(initialShortfalls, "text") !== undefined) {
        let chosen = null;
        for (let step = 1; step / 100 < headingAmount; step++) {
            const candidate = withPaletteOverride(fixed, "foreground", liftedPaletteLiteral(theme, fixed, "text", step));
            if (roleShortfall(shortfallsFor(theme, candidate), "text") === undefined) {
                chosen = candidate;
                break;
            }
        }
        if (chosen === null) return { held: true, shortfall: roleShortfall(initialShortfalls, "text") };
        fixed = chosen;
    }

    // The lift moves every role and surface that mixes from the
    // foreground, so the later families fix what fails in the lifted theme.
    const shortfalls = shortfallsFor(theme, fixed);

    const accentShortfall = list => roleShortfall(list, "accent") || list.find(shortfall => ACCENT_BOUNDARIES.includes(shortfall.text));
    if (accentShortfall(shortfalls) !== undefined) {
        let chosen = null;
        for (let step = 1; step <= 100; step++) {
            const candidate = withPaletteOverride(fixed, "accent", liftedPaletteLiteral(theme, fixed, "accent", step));
            if (accentShortfall(shortfallsFor(theme, candidate)) === undefined) {
                chosen = candidate;
                break;
            }
        }
        if (chosen === null) return { held: true, shortfall: accentShortfall(shortfalls) };
        fixed = chosen;
    }

    let faintAmount = defaults.textFaint;
    if (roleShortfall(shortfalls, "textFaint") !== undefined) {
        let chosen = null;
        const start = stepBelow(defaults.textFaint);
        for (let step = start; step >= 0; step--) {
            const candidate = withColorOverride(fixed, "textFaint", fadeExpression(step));
            if (roleShortfall(shortfallsFor(theme, candidate), "textFaint") === undefined) {
                chosen = { shell: candidate, amount: step / 100 };
                break;
            }
        }
        if (chosen === null) return { held: true, shortfall: roleShortfall(shortfalls, "textFaint") };
        fixed = chosen.shell;
        faintAmount = chosen.amount;
    }

    if (roleShortfall(shortfalls, "textMuted") !== undefined) {
        let chosen = null;
        const cap = proportionalMutedCap(defaults, faintAmount);
        for (let step = Math.floor(cap * 100 + 0.0000001); step >= 0; step--) {
            const candidate = withColorOverride(fixed, "textMuted", fadeExpression(step));
            if (roleShortfall(shortfallsFor(theme, candidate), "textMuted") === undefined) {
                chosen = candidate;
                break;
            }
        }
        if (chosen === null) return { held: true, shortfall: roleShortfall(shortfalls, "textMuted") };
        fixed = chosen;
    }

    for (const role of STATUS_ROLES) {
        const pathName = `color.${role}`;
        if (shortfalls.find(shortfall => shortfall.text === pathName) === undefined) continue;
        let chosen = null;
        for (let step = 1; step <= 100; step++) {
            const candidate = withColorOverride(fixed, role, contrastMixExpression(role, step));
            if (roleShortfall(shortfallsFor(theme, candidate), role) === undefined) {
                chosen = candidate;
                break;
            }
        }
        if (chosen === null) return { held: true, shortfall: roleShortfall(shortfalls, role) };
        fixed = chosen;
    }

    const finalShortfalls = shortfallsFor(theme, fixed);
    if (finalShortfalls.length > 0) return { held: true, shortfall: finalShortfalls[0] };
    const overrides = [];
    for (const role of Object.values(PALETTE_OVERRIDE_ROLES)) {
        if (fixed.tokens.palette[role] !== shell.tokens.palette[role]) overrides.push(`palette.${role}`);
    }
    if (fixed.tokens.color !== undefined) {
        const ordered = {};
        for (const role of COLOR_OVERRIDE_ORDER) {
            if (Object.hasOwn(fixed.tokens.color, role)) {
                ordered[role] = fixed.tokens.color[role];
                overrides.push(`color.${role}`);
            }
        }
        fixed.tokens.color = ordered;
    }
    return { held: false, shell: fixed, overrides };
}

function convertTheme(theme, v1ThemesDir, catalog, lock) {
    if (!logic.isPackageName(theme) || theme === logic.DEFAULT_NAME || logic.RESERVED_DIRECTORIES.includes(theme)) refuse(theme, "name", "reason=reserved-or-malformed");
    const dir = path.join(v1ThemesDir, theme);
    const colors = parseTomlColors(theme, path.join(dir, "colors.toml"), REQUIRED_COLORS, false);
    const terminalOverrides = fs.existsSync(path.join(dir, "terminal-colors.toml"))
        ? parseTomlColors(theme, path.join(dir, "terminal-colors.toml"), [], true)
        : {};
    const themeJson = readJson(path.join(dir, "theme.json"));
    if (themeJson.name !== theme) refuse(theme, "theme.json.name", `value=${JSON.stringify(themeJson.name)}`);
    if (modeOptions().indexOf(themeJson.mode) === -1) refuse(theme, "theme.json.mode", `value=${JSON.stringify(themeJson.mode)}`);
    const palette = {};
    for (const [target, source] of PALETTE_FROM_COLORS) palette[target] = colors[source];
    const slots = {};
    for (const slot of TERMINAL_SLOTS) slots[slot] = terminalOverrides[slot] || colors[slot];
    const shell = {
        schemaVersion: 1,
        name: theme,
        tokens: {
            scheme: { mode: themeJson.mode },
            palette
        }
    };
    const terminal = { schemaVersion: 1, slots };
    const readability = addReadabilityOverrides(theme, shell);
    if (readability.held) return { theme, held: true, shortfall: readability.shortfall };
    const imagery = pinFromV1(theme, catalog, lock);
    const entry = { name: theme, mode: themeJson.mode, thumbnail: `thumbnails/${theme}.jpg`, palette: paletteForEntry(theme, readability.shell), imagery };
    return { theme, held: false, shell: readability.shell, terminal, entry, overrides: readability.overrides };
}

// A refusal of bin/lib/theme-download.js as this converter's line. A
// fetch refusal is `asset-<reason>`, a transfer's `asset-download
// reason=<reason>`; a local write failure exits 2.
function refuseAsset(theme, e) {
    switch (e.step) {
    case "fetch":
        if (e.reason === "unwritable") throw new ConvertExit(EXIT_IO, message("unwritable", e.detail));
        if (e.reason === "download" || e.reason === "redirect-not-https") refuseGlobal("asset-download", `reason=${e.reason} ${e.detail}`);
        refuseGlobal(`asset-${e.reason}`, e.detail);
        break;
    case "archive":
        refuse(theme, "archive", `reason=${e.reason} ${e.detail}`);
        break;
    case "header":
        refuse(theme, "archive.header", `reason=${e.reason}${e.detail === "" ? "" : " " + e.detail}`);
        break;
    case "name":
        refuse(theme, "archive.member", `name=${JSON.stringify(e.member)}`);
        break;
    default:
        throw new Error(`convert-v1-themes: asset refusal step ${e.step} is none of fetch, archive, header, name`);
    }
}

// The verified archive of theme ITEM in the asset cache, downloaded once
// and kept there, under the cache's download lock, which `vgsh theme
// wallpapers` takes too: a fetch owns the part it writes.
async function ensureArchive(item, args, catalog) {
    const base = args.assetBase || catalog.source.baseUrl;
    if (typeof base !== "string" || base === "") refuseGlobal("asset-base", "reason=missing");
    let lock = null;
    try {
        const url = download.archiveUrl(item.entry.imagery, base, args.allowFileBase);
        lock = download.holdDownloadLock(args.assetCache);
        return (await download.fetchArchive(item.entry.imagery, url, args.assetCache, true, () => {})).file;
    } catch (e) {
        if (e instanceof download.AssetRefusal) refuseAsset(item.theme, e);
        throw e;
    } finally {
        if (lock !== null) lock.release();
    }
}

// The converter's member policy: every member under backgrounds/ is a
// regular file or a directory, and each regular file directly in it goes
// into ENTRIES for the thumbnail; nested files and every member outside
// backgrounds/ are skipped.
function thumbnailSources(theme, entries) {
    return member => {
        if (member.name !== backgrounds.DIR && !member.name.startsWith(`${backgrounds.DIR}/`)) return null;
        if (member.kind === "hardlink" || member.kind === "symlink") refuse(theme, "archive.member", `name=${JSON.stringify(member.name)} reason=link type=${JSON.stringify(member.type)}`);
        if (member.kind !== "file" && member.kind !== "directory") refuse(theme, "archive.member", `name=${JSON.stringify(member.name)} reason=unsupported-type type=${JSON.stringify(member.type)}`);
        if (member.kind !== "file") return null;
        const fileName = member.name.slice(backgrounds.DIR.length + 1);
        return fileName.includes("/") ? null : collect(entries, fileName);
    };
}

// A sink that keeps member FILE_NAME's body in memory as an entry of
// ENTRIES, shaped as backgrounds.firstImageName reads a directory entry.
function collect(entries, fileName) {
    const chunks = [];
    return {
        write(chunk) { chunks.push(Buffer.from(chunk)); },
        close() { entries.push({ name: fileName, data: Buffer.concat(chunks), isFile: () => true, isSymbolicLink: () => false }); }
    };
}

async function readTarEntries(theme, archive) {
    const entries = [];
    try {
        await download.readArchive(archive, thumbnailSources(theme, entries), () => {});
    } catch (e) {
        if (e instanceof download.AssetRefusal) refuseAsset(theme, e);
        throw e;
    }
    return entries;
}

function scratchRoot() {
    const root = path.join(repo, "tmp", `convert-v1-themes-${process.pid}-${Date.now()}`);
    fs.mkdirSync(root, { recursive: true });
    return root;
}

async function makeThumbnail(theme, archive, scratch, budget) {
    const entries = await readTarEntries(theme, archive);
    const first = backgrounds.firstImageName(entries);
    if (first === null) refuse(theme, "archive.backgrounds", "reason=no-image");
    const entry = entries.find(candidate => candidate.name === first);
    const ext = path.extname(first).toLowerCase() || ".jpg";
    const input = path.join(scratch, `${theme}-input${ext}`);
    const output = path.join(scratch, `${theme}.jpg`);
    fs.writeFileSync(input, entry.data);
    const proc = spawnSync("magick", [input, "-auto-orient", "-resize", `${THUMBNAIL_WIDTH}x`, "-strip", "-sampling-factor", "4:2:0", "-quality", "82", `jpeg:${output}`], { encoding: "utf8" });
    if (proc.status !== 0) refuse(theme, "thumbnail", `reason=magick status=${proc.status} stderr=${JSON.stringify(proc.stderr.trim())}`);
    const bytes = fs.statSync(output).size;
    if (bytes > budget) refuse(theme, "thumbnail", `reason=over-budget bytes=${bytes} budget=${budget}`);
    return { path: output, bytes, source: first };
}

function readExistingIndex(catalogDir) {
    const file = path.join(catalogDir, "index.json");
    if (!fs.existsSync(file)) return { schemaVersion: 1, entries: [] };
    return readJson(file);
}

function buildIndex(existing, converted, heldBack) {
    const byName = new Map();
    for (const entry of existing.entries || []) byName.set(entry.name, entry);
    for (const item of heldBack) byName.delete(item.theme);
    for (const item of converted) byName.set(item.theme, item.entry);
    return { schemaVersion: 1, entries: Array.from(byName.values()).sort((a, b) => codeUnitCompare(a.name, b.name)) };
}

function readPackageFilesForIndex(catalogDir, convertedByName, entry) {
    const converted = convertedByName.get(entry.name);
    if (converted !== undefined) return { themeJson: writeJson(converted.shell), terminalJson: writeJson(converted.terminal) };
    const dir = path.join(catalogDir, entry.name);
    return {
        themeJson: readFile(path.join(dir, "theme.json"), "utf8"),
        terminalJson: fs.existsSync(path.join(dir, "terminal.json")) ? readFile(path.join(dir, "terminal.json"), "utf8") : undefined
    };
}

function judgeOutput(catalogDir, finalIndex, converted) {
    const indexText = writeJson(finalIndex);
    const judgedIndex = logic.acceptCatalogIndex(tokens, indexText);
    if (!judgedIndex.ok) refuseGlobal("index", logic.refusalLine(judgedIndex));
    const convertedByName = new Map(converted.map(item => [item.theme, item]));
    for (const entry of judgedIndex.entries) {
        const verdict = logic.acceptCatalogEntry(tokens, entry, readPackageFilesForIndex(catalogDir, convertedByName, entry));
        if (!verdict.ok) refuseGlobal(`entry=${entry.name}`, logic.refusalLine(verdict));
    }
}

function land(catalogDir, finalIndex, converted, heldBack, thumbnails) {
    for (const item of heldBack) {
        fs.rmSync(path.join(catalogDir, item.theme), { recursive: true, force: true });
        fs.rmSync(path.join(catalogDir, "thumbnails", `${item.theme}.jpg`), { force: true });
    }
    for (const item of converted) {
        const dir = path.join(catalogDir, item.theme);
        replaceFile(path.join(dir, "theme.json"), writeJson(item.shell), "convert-v1-themes");
        replaceFile(path.join(dir, "terminal.json"), writeJson(item.terminal), "convert-v1-themes");
    }
    for (const [theme, thumbnail] of thumbnails) {
        replaceFile(path.join(catalogDir, "thumbnails", `${theme}.jpg`), readFile(thumbnail.path, null), "convert-v1-themes");
    }
    replaceFile(path.join(catalogDir, "index.json"), writeJson(finalIndex), "convert-v1-themes");
}

async function main() {
    const args = parseArgs(process.argv.slice(2));
    const v1ThemesDir = path.join(args.v1Tree, "themes");
    const catalog = readJson(path.join(v1ThemesDir, "catalog.json"));
    const lock = readJson(path.join(v1ThemesDir, "asset-lock.json"));
    const themes = args.themes.length === 0 ? catalog.themes.map(entry => entry.name).sort() : args.themes;
    const seen = new Set();
    for (const theme of themes) {
        if (seen.has(theme)) refuse(theme, "selection", "reason=duplicate");
        seen.add(theme);
    }
    const results = themes.map(theme => convertTheme(theme, v1ThemesDir, catalog, lock));
    const converted = results.filter(item => !item.held);
    const heldBack = results.filter(item => item.held);
    const scratch = scratchRoot();
    const thumbnails = new Map();
    try {
        for (const item of converted) {
            const archive = await ensureArchive(item, args, catalog);
            thumbnails.set(item.theme, await makeThumbnail(item.theme, archive, scratch, args.thumbnailBudget));
        }
        const existing = readExistingIndex(args.catalogDir);
        const finalIndex = buildIndex(existing, converted, heldBack);
        judgeOutput(args.catalogDir, finalIndex, converted);
        land(args.catalogDir, finalIndex, converted, heldBack, thumbnails);
        for (const item of heldBack) {
            const shortfall = item.shortfall;
            console.log(`held-back theme=${item.theme} text=${shortfall.text} surface=${shortfall.surface} ratio=${ratioText(shortfall)} floor=${shortfall.floor}`);
        }
        for (const item of converted) {
            const thumb = thumbnails.get(item.theme);
            const overrides = item.overrides.length === 0 ? "none" : item.overrides.join(",");
            console.log(`ok theme=${item.theme} thumbnail=${item.entry.thumbnail} bytes=${thumb.bytes} source=${thumb.source} budget=${args.thumbnailBudget} overrides=${overrides}`);
        }
        console.log("convert-v1-themes: ok");
    } finally {
        fs.rmSync(scratch, { recursive: true, force: true });
    }
}

main().catch(e => {
    if (e instanceof ConvertExit) {
        console.error(e.line);
        process.exit(e.status);
    }
    if (e instanceof Refusal) {
        console.error(message("unreadable", e.first));
        process.exit(EXIT_IO);
    }
    throw e;
});
