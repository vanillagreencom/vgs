#!/usr/bin/env python3
"""Scaffold and check v2 shell plugins.

  vgs-plugin new <author.name> --kinds <kind,...> [--dir DIR] [--name NAME] [--author AUTHOR] [--description TEXT]
  vgs-plugin check <plugin-dir>

`new` writes <DIR>/<id>/ (default DIR: shell/plugins) from the templates
beside this script, one entry point per kind, then runs `check` on it.
`check` runs the repository's manifest judge and boundary check on one
plugin directory. Exit 0 when clean, 1 on findings, 2 on a refusal, whose
first line is keyed: `vgs-plugin: refused: <key>=<value>`, with `kind=` for
a kind no template covers, `manifest=` for a manifest the judge refuses
(its verdict follows), `judge=exit-<status>` for a judge that exited with
any status other than 0 or 1 (both of its streams follow), `exists=` for an
occupied target and `no-manifest=` for a check on a directory without one.
scripts/test-vgs-plugin.py pins each.
"""
import argparse
import json
import os
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
SKILL = os.path.dirname(HERE)
REPO = os.path.abspath(os.path.join(SKILL, "..", "..", ".."))
TEMPLATES = os.path.join(SKILL, "templates")
MANIFEST_CHECK = os.path.join(REPO, "scripts", "check-manifests.js")
BOUNDARY_CHECK = os.path.join(REPO, "scripts", "check-plugin-boundary.py")
# Every child runs under this environment and nothing inherited beyond it;
# HOME stays because a version-managed node reads its configuration there.
ENV = {"PATH": os.environ.get("PATH", ""), "HOME": os.environ.get("HOME", ""), "LC_ALL": "C"}

# kind -> (template file, entry file name). Which kinds exist, and every
# other manifest rule, is the repository's one judge, shell/Core/PluginLogic.js,
# run through scripts/check-manifests.js before anything is written; this
# table only selects a template, and scripts/test-vgs-plugin.py holds it to
# PluginLogic.KINDS.
TEMPLATE_FOR = {
    "bar-widget": ("BarWidget.qml", "Widget.qml"),
    "bar": ("Bar.qml", "Bar.qml"),
    "panel": ("Panel.qml", "Panel.qml"),
    "overlay": ("Panel.qml", "Overlay.qml"),
    "menu": ("Panel.qml", "Menu.qml"),
    "service": ("Service.qml", "Service.qml"),
    "background": ("Background.qml", "Background.qml"),
}


def fill(text, values):
    for key, value in values.items():
        text = text.replace("__" + key + "__", value)
    return text


def escaped(value):
    """`value` as the inside of a JSON string literal, which is also a valid
    QML string literal: every placeholder sits inside quotes or a comment, so
    a quote or a backslash in a name or description cannot end the string."""
    return json.dumps(value, ensure_ascii=False)[1:-1]


def cmd_new(args):
    kinds = [k.strip() for k in args.kinds.split(",") if k.strip()]
    unknown = [k for k in kinds if k not in TEMPLATE_FOR]
    if unknown:
        print(f"vgs-plugin: refused: kind={','.join(unknown)} known={','.join(TEMPLATE_FOR)}")
        return 2
    base = os.path.join(REPO, args.dir) if not os.path.isabs(args.dir) else args.dir
    target = os.path.join(base, args.id)
    if os.path.exists(target):
        print(f"vgs-plugin: refused: exists={target}")
        return 2
    # The id's shape is the judge's decision below; the name and author are
    # derived from what the id holds either side of its first dot.
    author, _, rest = args.id.partition(".")
    name = args.name or (rest or args.id).replace("-", " ").title()
    values = {
        "ID": escaped(args.id),
        "NAME": escaped(name),
        "AUTHOR": escaped(args.author or author),
        "DESCRIPTION": escaped(args.description or f"{name} plugin."),
        "KINDS": json.dumps(kinds),
        "ENTRY_POINTS": json.dumps({k: TEMPLATE_FOR[k][1] for k in kinds}),
    }
    with open(os.path.join(TEMPLATES, "manifest.json.tmpl"), encoding="utf-8") as fh:
        data = json.loads(fill(fh.read(), values))
    if "bar-widget" in kinds:
        # The widget template reads settings.label; its default lives here.
        data["defaultSection"] = "right"
        data["settings"] = {"label": name}
    manifest = json.dumps(data, indent=2) + "\n"
    # The repository's one manifest judge decides the id and the shape before
    # anything is written, on the manifest text that will be written, so a
    # refused id leaves no directory behind.
    with tempfile.TemporaryDirectory() as probe:
        probe_dir = os.path.join(probe, "probe")
        os.makedirs(probe_dir)
        with open(os.path.join(probe_dir, "manifest.json"), "w", encoding="utf-8") as fh:
            fh.write(manifest)
        for kind in kinds:
            with open(os.path.join(probe_dir, TEMPLATE_FOR[kind][1]), "w", encoding="utf-8") as fh:
                fh.write("")
        judged = subprocess.run(["node", MANIFEST_CHECK, "--", probe_dir], capture_output=True, text=True, check=False, env=ENV)
        if judged.returncode == 1:
            print(f"vgs-plugin: refused: manifest={args.id}")
            print(judged.stdout.rstrip())
            if judged.stderr.strip():
                print(judged.stderr.rstrip())
            return 2
        if judged.returncode != 0:
            print(f"vgs-plugin: refused: judge=exit-{judged.returncode}")
            print(judged.stdout.rstrip())
            print(judged.stderr.rstrip())
            return 2
    os.makedirs(target)
    with open(os.path.join(target, "manifest.json"), "w", encoding="utf-8") as fh:
        fh.write(manifest)
    for kind in kinds:
        template, entry = TEMPLATE_FOR[kind]
        with open(os.path.join(TEMPLATES, template), encoding="utf-8") as fh:
            body = fill(fh.read(), values)
        with open(os.path.join(target, entry), "w", encoding="utf-8") as fh:
            fh.write(body)
    print(f"vgs-plugin: wrote {target}")
    return cmd_check(argparse.Namespace(dir=target))


def cmd_check(args):
    target = os.path.abspath(args.dir)
    if not os.path.isfile(os.path.join(target, "manifest.json")):
        print(f"vgs-plugin: refused: no-manifest={target}")
        return 2
    status = 0
    for command in (
        ["node", MANIFEST_CHECK, "--", target],
        [sys.executable, BOUNDARY_CHECK, "--shell", os.path.join(REPO, "shell"), target],
    ):
        proc = subprocess.run(command, check=False, env=ENV)
        if proc.returncode != 0:
            status = 1 if proc.returncode == 1 and status != 2 else max(status, proc.returncode)
    print("vgs-plugin: check " + ("ok" if status == 0 else f"failed={status}"))
    return status


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    new = sub.add_parser("new")
    new.add_argument("id")
    new.add_argument("--kinds", required=True)
    new.add_argument("--dir", default=os.path.join("shell", "plugins"))
    new.add_argument("--name")
    new.add_argument("--author")
    new.add_argument("--description")
    new.set_defaults(func=cmd_new)
    check = sub.add_parser("check")
    check.add_argument("dir")
    check.set_defaults(func=cmd_check)
    args = parser.parse_args(argv[1:])
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
