{
  "$comment": [
    "Catalog for `vshell mise`, `vshell agent` and `vshell dev-env`. One list",
    "feeds the ~/.local/bin stubs, the default-agent picker, the Developer",
    "settings tab and the VGS menu; nothing else may carry its own copy.",
    "",
    "agents: coding-agent harnesses. `package` is what mise installs, `command`",
    "the stub name in ~/.local/bin, `bin` the executable inside the package",
    "(defaults to command). `launch` is the argv the default-agent launcher runs,",
    "the agent's own spelling of \"do not stop to ask\". `kind: server` marks a",
    "harness with no terminal or desktop UI: it serves a page and opens the",
    "browser, and every surface says so.",
    "",
    "`icon` is `nerd:<hex>` (bundled Nerd Font) or `brand:<hex>` (bundled",
    "omarchy brand marks); `color` is the brand's dominant color for the",
    "launcher tile, omitted where the mark is monochrome by design.",
    "",
    "tools: developer CLIs that get a lazy stub but are not agents.",
    "",
    "envs: language environments. `tools` are mise packages installed globally;",
    "`installer` names a non-mise route the helper implements; `managedBy` names",
    "a command whose presence at a distribution path means the package manager",
    "owns the environment and VGS neither installs nor removes it; `packages` are",
    "distribution packages (keyed by dependencies.json distro ids) installed",
    "first; `present` is the path whose existence means installed."
  ],
  "agents": [
    { "id": "claude", "name": "Claude Code", "icon": "nerd:f06c4", "color": "#D97757", "package": "claude", "command": "claude", "launch": ["claude", "--permission-mode", "auto"] },
    { "id": "codex", "name": "Codex", "icon": "brand:e905", "color": "#10A37F", "package": "codex", "command": "codex", "launch": ["codex", "--approve-for-me"] },
    { "id": "opencode", "name": "OpenCode", "icon": "brand:e902", "package": "opencode", "command": "opencode", "launch": ["opencode", "--auto"] },
    { "id": "copilot", "name": "GitHub Copilot", "icon": "nerd:f4b8", "color": "#6E40C9", "package": "copilot", "command": "copilot", "launch": ["copilot", "--allow-all"] },
    { "id": "crush", "name": "Crush", "icon": "nerd:f02d1", "color": "#FF5C8A", "package": "crush", "command": "crush", "launch": ["crush", "--yolo"] },
    { "id": "pi", "name": "Pi", "icon": "brand:e901", "package": "pi", "command": "pi", "launch": ["pi"] },
    { "id": "omp", "name": "Oh My Pi", "icon": "brand:e903", "package": "github:can1357/oh-my-pi", "command": "omp", "launch": ["omp", "--auto-approve"] },
    { "id": "gemini", "name": "Gemini CLI", "icon": "nerd:f0674", "color": "#4E8DF5", "package": "gemini", "command": "gemini", "launch": ["gemini", "--yolo"] },
    { "id": "agy", "name": "Antigravity", "icon": "nerd:f02ad", "color": "#4285F4", "package": "aqua:google-antigravity/antigravity-cli", "command": "agy", "launch": ["agy", "--dangerously-skip-permissions"] },
    { "id": "grok", "name": "Grok", "icon": "brand:e904", "package": "npm:@xai-official/grok", "command": "grok", "launch": ["grok", "--permission-mode", "bypassPermissions"] },
    { "id": "ori", "name": "Ori", "icon": "brand:e909", "color": "#6467F2", "package": "github:OpenRouterLabs/ori-releases", "command": "ori", "launch": ["ori", "code"] },
    { "id": "dsh", "name": "DeepSeek Harness", "kind": "server", "icon": "nerd:f06a9", "color": "#4D6BFE", "package": "npm:@deepseek-ai/dsh", "command": "dsh", "launch": ["dsh", "web"] }
  ],
  "tools": [
    { "package": "gh", "command": "gh" },
    { "package": "npm:playwright", "command": "playwright" },
    { "package": "npm:@kitlangton/ghui", "command": "ghui" },
    { "package": "aqua:modem-dev/hunk", "command": "hunk" },
    { "package": "github:basecamp/hey-cli", "command": "hey" }
  ],
  "envs": [
    { "id": "node", "name": "Node.js", "icon": "nerd:f0399", "color": "#5FA04E", "tools": ["node"], "settings": { "idiomatic_version_file_enable_tools": ["node"] }, "present": "~/.local/share/mise/installs/node" },
    { "id": "bun", "name": "Bun", "icon": "nerd:e76f", "color": "#F9F1E1", "tools": ["bun"], "present": "~/.local/share/mise/installs/bun" },
    { "id": "deno", "name": "Deno", "icon": "nerd:f06e6", "color": "#70FFAF", "tools": ["deno"], "present": "~/.local/share/mise/installs/deno" },
    { "id": "go", "name": "Go", "icon": "nerd:f07d3", "color": "#00ADD8", "tools": ["go"], "present": "~/.local/share/mise/installs/go" },
    { "id": "python", "name": "Python", "icon": "nerd:f0320", "color": "#3776AB", "tools": ["python", "uv"], "present": "~/.local/share/mise/installs/python" },
    { "id": "ruby", "name": "Ruby", "icon": "nerd:f0d2d", "color": "#CC342D", "tools": ["ruby"], "packages": { "arch": ["libyaml"], "debian": ["libyaml-dev"], "fedora": ["libyaml-devel"] }, "settings": { "ruby.compile": "false", "idiomatic_version_file_enable_tools": "ruby" }, "present": "~/.local/share/mise/installs/ruby" },
    { "id": "java", "name": "Java", "icon": "nerd:f0b37", "color": "#ED8B00", "tools": ["java"], "present": "~/.local/share/mise/installs/java" },
    { "id": "zig", "name": "Zig", "icon": "nerd:e6a9", "color": "#F7A41D", "tools": ["zig", "zls"], "present": "~/.local/share/mise/installs/zig" },
    { "id": "dotnet", "name": ".NET", "icon": "nerd:f0aae", "color": "#512BD4", "tools": ["dotnet"], "present": "~/.local/share/mise/installs/dotnet" },
    { "id": "clojure", "name": "Clojure", "icon": "nerd:e768", "color": "#5881D8", "tools": ["clojure"], "packages": { "arch": ["rlwrap"], "debian": ["rlwrap"], "fedora": ["rlwrap"] }, "present": "~/.local/share/mise/installs/clojure" },
    { "id": "scala", "name": "Scala", "icon": "nerd:e737", "color": "#DC322F", "tools": ["java", "scala", "scala-cli"], "present": "~/.local/share/mise/installs/scala" },
    { "id": "elixir", "name": "Elixir", "icon": "nerd:e7cd", "color": "#9B6BC7", "tools": ["erlang", "elixir"], "present": "~/.local/share/mise/installs/elixir" },
    { "id": "rust", "name": "Rust", "icon": "nerd:f1617", "color": "#DEA584", "installer": "rustup", "present": "~/.rustup", "managedBy": "rustup" }
  ]
}
