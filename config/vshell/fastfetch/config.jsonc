{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "source": "~/.config/vshell/generated/fastfetch/logo.jpg",
        "type": "auto",
        "recache": true,
        "width": 35,
        "height": 16,
        "preserveAspectRatio": true,
        "padding": {
            "top": 0,
            "left": 0,
            "right": 4
        }
    },
    "display": {
        "separator": " ",
        "key": {
            "width": 0
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "╭─────────────╮"
        },
        {
            "type": "title",
            "key": "{#}│ {#31}  user     {#}│",
            "format": "{1}"
        },
        {
            "type": "host",
            "key": "{#}│ {#32}  hname    {#}│",
            "format": "{2}"
        },
        {
            "type": "Uptime",
            "key": "{#}│ {#33}  uptime   {#}│"
        },
        {
            "type": "os",
            "key": "{#}│ {#34}  distro   {#}│"
        },
        {
            "type": "kernel",
            "key": "{#}│ {#35}  kernel   {#}│",
            "format": "{2}"
        },
        {
            "type": "de",
            "key": "{#}│ {#36}  desktop  {#}│",
            "format": "{2}"
        },
        {
            "type": "terminal",
            "key": "{#}│ {#37}  term     {#}│",
            "format": "{3}"
        },
        {
            "type": "Font",
            "key": "{#}│ {#31}  font     {#}│"
        },
        {
            "type": "TerminalFont",
            "key": "{#}│ {#32}  termfont {#}│"
        },
        {
            "type": "shell",
            "key": "{#}│ {#34}  shell    {#}│",
            "format": "{3} {4}"
        },
        {
            "type": "Packages",
            "key": "{#}│ {#33}  packages {#}│"
        },
        {
            "type": "memory",
            "key": "{#}│ {#34}  memory   {#}│",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "GPU",
            "key": "{#}│ {#35}  gpu      {#}│",
            "format": "{3} {4}"
        },
        {
            "type": "custom",
            "format": "├─────────────┤"
        },
        {
            "type": "colors",
            "key": "{#}│ {#37}  colors    {#}│",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "╰─────────────╯"
        }
    ]
}
