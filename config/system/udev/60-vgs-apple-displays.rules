# VGS: access to the Apple display brightness controls for the user at the
# seat. Installed by `vgsh system apply apple-displays` (bin/vgsh-system);
# `vgsh system undo apple-displays` removes it.
#
# uaccess alone: the active session's user gets an ACL on each hidraw node
# of the display, and no group or mode reaches an SSH or other-seat session.
# The 60- prefix sorts ahead of 73-seat-late.rules, which applies the tag.

# Apple Studio Display (05ac:1114)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="1114", TAG+="uaccess"

# Apple Pro Display XDR (05ac:9243)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="9243", TAG+="uaccess"
