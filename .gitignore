# Agent and coding-harness workspaces
# Existing tracked files stay tracked until removed from the index.
# vstack.toml and vstack.settings.toml are tracked: they are project-owned
# config (agent/skill wiring, review gates, Linear team) with no secrets —
# those live in .env.local. The lock file stays ignored because it records
# per-machine install state (absolute source paths, install timestamps).
.vstack-lock.json
.agents/
.claude/
.codex/
.opencode/
opencode.json
.pi/
.aider*/
.cursor/
.continue/
.gemini/
.roo/
.windsurf/

# Local environment and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.local.example

# Runtime logs, scratch files, and caches
tmp/
.cache/
logs/
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej

# Python helper/tooling artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.venv/
venv/

# Node/QML tooling artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.qmlcache/
qmlcache/
*.qmlc
*.jsc

# Quickshell/vshell live state belongs in ~/.config/vshell, not source snapshots
config/vshell/session.json
config/vshell/cache.json
config/vshell/theme.json
config/vshell/generated/
config/vshell/runtime/

# Editor and OS metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local planning and research artifacts
docs/plans/
docs/research/
# Session handoff (single file, never committed) — see AGENTS.md § Conventions
docs/handoff/

# Machine-local companion to AGENTS.md: this workstation's expected symlinks and
# service state. Never committed — it describes one machine, and a tracked copy
# would rot on every other one.
AGENTS.local.md

# Local git worktrees (vstack worktree skill)
/trees/
