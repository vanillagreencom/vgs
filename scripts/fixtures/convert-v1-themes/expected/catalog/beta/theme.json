{
  "schemaVersion": 1,
  "name": "beta",
  "tokens": {
    "scheme": {
      "mode": "light"
    },
    "palette": {
      "background": "#fafafa",
      "foreground": "#111111",
      "accent": "#abcdef",
      "success": "#00aa00",
      "warning": "#aaaa00",
      "danger": "#aa0000",
      "info": "#0000aa"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.37)",
      "success": "mix({palette.success}, contrast({palette.background}), 0.28)",
      "warning": "mix({palette.warning}, contrast({palette.background}), 0.36)"
    }
  }
}
