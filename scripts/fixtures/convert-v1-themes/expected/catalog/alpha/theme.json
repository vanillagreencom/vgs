{
  "schemaVersion": 1,
  "name": "alpha",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#101010",
      "foreground": "#eeeeee",
      "accent": "#123456",
      "success": "#001100",
      "warning": "#111100",
      "danger": "#110000",
      "info": "#000011"
    },
    "color": {
      "success": "mix({palette.success}, contrast({palette.background}), 0.51)",
      "warning": "mix({palette.warning}, contrast({palette.background}), 0.50)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.53)",
      "info": "mix({palette.info}, contrast({palette.background}), 0.53)"
    }
  }
}
