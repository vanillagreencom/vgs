{ "schemaVersion": 1, "id": "acme.probe", "name": "Probe", "version": "0.1.0", "author": "acme", "description": "smoke fixture",
  "icon": "flask-conical",
  "kinds": ["service", "bar-widget"], "entryPoints": { "service": "Service.qml", "bar-widget": "Widget.qml" },
  "defaultSection": "right",
  "settings": { "label": "probe", "tags": ["a", "b"], "size": 12, "gap": 4, "compact": false, "mode": "calm", "delay": 800, "notes": "", "accent": true, "badge": "dot" },
  "schema": {
    "label": { "type": "string", "label": "Label" },
    "size": { "type": "number", "label": "Size", "description": "A bounded number, drawn as a slider", "min": 8, "max": 40, "step": 1, "group": "Layout" },
    "gap": { "type": "number", "label": "Gap", "description": "An unbounded number, drawn as a text field", "group": "Layout" },
    "compact": { "type": "boolean", "label": "Compact", "group": "Layout" },
    "mode": { "type": "enum", "label": "Mode", "options": ["calm", "busy", "off"], "group": "Behaviour" },
    "delay": { "type": "number", "label": "Delay", "description": "Milliseconds", "min": 0, "max": 5000, "step": 100, "group": "Behaviour" },
    "notes": { "type": "string", "label": "Notes", "group": "Behaviour" },
    "accent": { "type": "boolean", "label": "Accent", "group": "Look" },
    "badge": { "type": "enum", "label": "Badge", "options": ["dot", "count", "none"], "group": "Look" }
  },
  "hyprland": { "binds": [{ "shortcut": "ping", "key": "SUPER+code:108" }] },
  "capabilities": ["compositor", "configure", "idle", "ipc", "lock", "notifications", "polkit", "run", "screens", "shortcut", "toasts", "theme", "tui"] }
