#!/usr/bin/env bash
# Stand-in git for rows/updates.sh. A directory is a checkout only when
# UPDATES_SMOKE_CHECKOUTS (colon-separated) names it; each such checkout is
# one commit behind its upstream. Every call is logged; any other call is
# refused loudly, so no real repository or remote is ever reached.
set -euo pipefail
root="${XDG_STATE_HOME:?}/vgs/updates-smoke"
mkdir -p -- "$root"
printf 'git %s\n' "$*" >>"$root/calls.log"
work="$PWD"
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-pager) shift ;;
    -c) shift 2 ;;
    -C) work="$2"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
checkout=false
IFS=: read -r -a checkouts <<<"${UPDATES_SMOKE_CHECKOUTS:-}"
for dir in "${checkouts[@]}"; do [[ -n $dir && $work == "$dir" ]] && checkout=true; done
if [[ $checkout == false ]]; then
  printf 'fatal: not a git repository (or any of the parent directories): .git\n' >&2
  exit 128
fi
head=1111111111111111111111111111111111111111
upstream=2222222222222222222222222222222222222222
case "${args[*]}" in
  'rev-parse --show-toplevel') printf '%s\n' "$work" ;;
  'rev-parse --verify @{upstream}') printf '%s\n' "$upstream" ;;
  'rev-parse --verify HEAD') printf '%s\n' "$head" ;;
  'fetch --quiet --no-recurse-submodules --no-write-fetch-head --no-auto-maintenance') ;;
  "rev-list --count $head..$upstream") printf '1\n' ;;
  "describe --long --tags --always --abbrev=7 --match v[0-9]* --exclude v*[!0-9.]* HEAD") printf 'v0.1.0-1-g1111111\n' ;;
  "describe --long --tags --always --abbrev=7 --match v[0-9]* --exclude v*[!0-9.]* $upstream") printf 'v0.1.0-2-g2222222\n' ;;
  *) printf 'updates git stub: refused args=%s work=%s\n' "${args[*]}" "$work" >&2; exit 99 ;;
esac
