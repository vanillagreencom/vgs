  "cli|agent CLI target controls|scripts/test-vgsh-agents.sh|scripts/vgsh-rows.sh bin/vgsh* bin/lib/* shell/Commons/ThemeLogic.js shell/Commons/Tokens.js themes/* shell/Core/PluginLogic.js scripts/qml-library.js config/shell.json"
