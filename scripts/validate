#!/usr/bin/env bash
# The VGS validation suite: one runner, one manifest (VGS-123).
#
# This list used to live in AGENTS.md § Validation, where every agent session
# re-read forty command lines and a script machine-parsed them — which is what a
# manifest is, not prose. It lives here now, and AGENTS.md carries a pointer.
#
#   scripts/validate [AREA]            AREA: go|qml|helper|packaging|docs|all
#   scripts/validate --list [AREA]     print the commands without running them
#   scripts/validate --dump-grammar    print the normalized tag grammar and exit
#
# Scope to the area touched; run `all` for cross-cutting work. Exactly one area
# per invocation — naming two is rejected rather than silently honouring the
# last, because a partial run reported as the asked-for scope is the failure
# this runner exists to prevent. Every selected command runs — failures are
# collected rather than fail-fast — and the summary names every failing
# command, because that set is what a dev agent reports as `FAILING: ...` and a
# first failure must not hide the rest.
#
# A check that DID NOT RUN is never counted as a pass, in the summary OR in the
# exit status. Rows tagged `may-skip` may exit 77 to mean "precondition absent,
# nothing was checked"; exit 77 from any other row is a plain failure, and every
# check whose degraded mode can be flag-forced is listed with the flag that
# forces it (`--require-static`, `--require-nested`) rather than being allowed to
# skip at all. This runner's own four statuses:
#
#   0    every selected command ran and passed
#   77   everything that ran passed, but something did NOT run — the summary
#        names each skipped command. Report it as a pass with the skip recorded
#        (dev SKILL.md `--validate-note`), never as a bare pass: handing a caller
#        a 0 here would be VGS-69's "refusal read as a pass" one layer up.
#   1    at least one command failed
#   2    usage or manifest error — a broken invocation. NOTHING ran, so it is
#        neither a pass nor a validation failure; fix the invocation and re-run.
#
# `scripts/check-validation-inventory.py` parses the MANIFEST_EOF block below
# and enforces it in both directions: every executable check under `scripts/`
# must appear here and in CI or carry a written exclusion (VGS-50), and every
# command here must be runnable exactly as written (VGS-30). The interpreter
# prefixes that do appear are deliberate: `node --check`, `python3 -m
# py_compile` and `bash -n` are syntax checks over a file, and `scripts/lib/`
# holds non-executable libraries reached only by import, sourcing, or an
# explicit interpreter — `python3 scripts/lib/shell_scan.py` and
# `python3 scripts/lib/qml_source_selftest.py` run a library's self-test (each
# carries a `__main__` only for that; `session-snapshot.sh` is
# sourced, `validation_manifest.py` is imported by the inventory guard,
# `collected.py`, `section_pointers.py`, `pointer_targets.py`, `prose_blocks.py`,
# `tracked_blobs.py` and `owned_skill_lists.py` by the checks that import them, and
# `qml_scrub_selftest.py` and `shell_scan_selftest.py` by the entry points above, none of
# them run; `section_pointers_selftest.py` and `prose_blocks_selftest.py` join
# that list of libraries carrying a `__main__` only for their own self-test.
# `kendex_skills.py` is the exception: its `__main__` prints the in-place skill
# paths for `scripts/check-naming.sh`, which is bash and cannot import it, and
# its controls live in `scripts/check-owned-skills.py`).
# `bin/vshell_niri.py`,
# `bin/vshell_niri_kdl.py` and `bin/vshell_theme_color.py` likewise stay
# importable modules with no shebang and no `__main__`.
#
# WHICH OF THESE CI CAN RUN is not restated here — one enforced copy only.
# `.github/instructions/validation-scripts.instructions.md` § "What CI covers,
# and what it cannot" holds it, and `scripts/check-validation-inventory.py`
# machine-compares its tables against that file's `LOCAL_ONLY`/`INDIRECT_IN_CI`
# maps, so a second prose copy in this header could only drift. The measured
# economics behind the single CI job are in
# `docs/decisions/D007-ci-single-job-economics.md`.
#
# What is true of THIS runner: the nested QML smoke and the surface smoke are
# tagged `qml` and neither can run in CI, so only a run that includes the qml
# rows (`scripts/validate qml` or `all`) proves the shell starts.
# `scripts/smoke-surfaces.sh` works only from the checkout owning the live
# session, and its refusal is not a pass (VGS-69) — hence its `may-skip` tag,
# the named skip in the summary, and the 77 above.

# `-e` is on, and the suite loop below deliberately does not rely on it: each
# check runs as `eval "$cmd" || status=$?`, where the `||` both suppresses
# errexit and CAPTURES the status. The captured VALUE, not merely its
# truthiness, is what separates 77-from-a-may-skip-row from every other non-zero
# result — so do not "simplify" that line back to `if ! eval ...`, which
# collapses every failure into one branch and silently deletes the skip channel.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
cd "$repo_root" || exit 1

# ═══ THE MANIFEST GRAMMAR — the authority for what a row may say ═══════════
#
# Four rounds of review each closed one malformed SHAPE and left the rule
# unstated, so a fifth shape kept existing. The rule is written here, once, and
# both readers validate against it: scripts/validate below, and
# scripts/lib/validation_manifest.py for the guard. The controls in
# scripts/test-validate.sh are derived from THESE productions — one per thing
# the grammar forbids — not from the shapes reviewers happened to find.
#
#   row        := tags "|" command
#
#   tags       := "-" | part { "," part }     # a SET: order and repetition
#   part       := selector | modifier         # are immaterial
#   selector   := area | "always"             # decides WHEN the row runs
#   modifier   := "may-skip"                  # qualifies HOW it may exit
#   area       := "go" | "qml" | "helper" | "packaging" | "docs"
#
#   command    := non-empty after trimming, and accepted by `bash -n`
#
# Constraints the productions alone do not carry:
#
#   C1  `-` is exclusive — a row tagged `-` carries no other tag. It means
#       "only the full `all` run selects this row".
#   C2  every row that is not `-` carries AT LEAST ONE SELECTOR. A row of
#       modifiers alone is the fourth shape this grammar exists to end:
#       `may-skip` by itself parses, selects nothing, and so vanishes from
#       every named area while still running under `all` — green, and the row
#       gone from exactly the scoped runs this repo tells agents to use.
#   C3  `all` is an ARGUMENT to this script, never a tag. As a tag it would
#       match only an `all` run and behave like `-` everywhere else.
#   C4  whitespace is ASCII, and removed before matching. Python's str.split()
#       also eats Unicode whitespace; ASCII-only in both readers is what stops
#       a Unicode space normalising away for one and not the other. Enforced by
#       ONE SET, `ASCII_SPACE` below, which `--dump-grammar` emits and the
#       library builds its pattern from — the two sides used to spell six
#       characters out separately under a comment claiming they moved together,
#       which nothing checked. `[[:space:]]` did not enforce it either: bash
#       resolves character classes through the LOCALE, so C4 was asserted here
#       and true only incidentally, until a locale change made it false.
#
# ─── and the AREA DECLARATION, one level up ────────────────────────────────
#
# `all` being silently droppable by a reader was the FIFTH hole in this file,
# after the empty tag field, the trailing comma, the malformed command and the
# modifier-only row. Same lesson: the rule was real but unwritten, so it was a
# bug to discover rather than a rule to check. So it is written here too.
#
# TWO VOCABULARIES, and they are NOT the same set — overloading one word for
# both is what let `all` fall through the gap between them:
#
#   AREAS      := scope { scope } "all"    # the declaration; order immaterial
#   scope      := "go" | "qml" | "helper" | "packaging" | "docs"
#   argument   := scope | "all"            # what `scripts/validate X` accepts
#
#   A1  AREAS declares `all`. It is the runner's DEFAULT, so with `all`
#       deleted a bare `scripts/validate` fails as an unknown area.
#   A2  every name in AREAS is a lowercase token and appears exactly once.
#   A3  `all` is an ARGUMENT and never a row TAG (C3 above). Readers therefore
#       expose the DECLARATION and the tag-usable SCOPES separately; a consumer
#       that rebuilds one from the other cannot see a deletion in it, which is
#       precisely how A1 went unchecked.
#   A4  every scope is carried by at least one manifest row, or the argument
#       selects nothing of its own.
#   A5  the prose surfaces enumerate exactly the ARGUMENTS.
#
# NOT expressible here, and so not claimed: that a command names a program
# that exists and does what the row says. scripts/check-validation-inventory.py
# covers the `scripts/` part of that; the rest is only proven by running it.
#
# `always` IS A SELECTOR, not a modifier — it stands alone on three shipped
# rows and must keep doing so. The bar for it is high and all three parts are
# load-bearing: cheap, network-free, and correct in ANY checkout — a plain
# clone, a CI-shaped checkout, a worktree made before `kendex refresh`. A check
# that hard-fails when some out-of-tree artifact is absent does NOT qualify
# however fast it is. What qualifies: the format/lint floor, this manifest's own guard,
# `git diff --check` — a Go-scoped run must still gofmt the Go it changed.
#
# The per-area sets are the scoping AGENTS.md used to state in prose:
# go = the backend capability inventory guard plus the Go block; qml = naming,
# the QML smoke, the safety guard, surfaces, plus the QML source lints carrying
# the tag: the launcher hover latch and the popout dismiss envelope; helper =
# the helper checks plus the py_compile/bash -n pass; packaging = its three;
# docs = the instruction-surface growth ratchet, the owned-skill register guard,
# the section-pointer guard, and that guard's five control scripts, one per
# subject. This `test-` row is needed because the guard has no inline self-test;
# a docs run without the controls would prove nothing about whether it guards.
#
# The older QML source lints are still `-`, so only `all` reaches them, and the
# family is bigger than it looks: 23 of today's `-` rows read .qml source, from
# pill-hover to the six ai-usage checks. `qml` is the better tag for a new one —
# it runs the guard in the area AGENTS.md tells agents to run before finishing
# QML work — but retagging two dozen rows is its own change, not a drive-by.
# shellcheck disable=SC2329  # invoked indirectly, as an argument to collect()
manifest() {
  cat <<'MANIFEST_EOF'
qml       | scripts/check-naming.sh
always    | scripts/check-format-lint.sh
-         | python3 scripts/lib/shell_scan.py
-         | python3 scripts/lib/qml_source_selftest.py
-         | node scripts/lib/qml-region-selftest.js | grep -qxF 'qml-region guard selftest: all checks passed'
-         | node scripts/lib/qml-region-wiring-selftest.js | grep -qxF 'qml-region wiring selftest: all checks passed'
-         | node scripts/lib/qml-region-testkit-selftest.js | grep -qxF 'qml-region testkit selftest: all checks passed'
always    | scripts/check-validation-inventory.py
docs      | scripts/check-owned-skills.py
docs      | scripts/test-owned-skills-e2e.py
docs      | scripts/check-section-pointers.py
docs      | scripts/test-section-pointers.py
docs      | scripts/test-section-pointers-e2e.py
docs      | python3 scripts/lib/section_pointers_selftest.py
docs      | python3 scripts/lib/tracked_blobs_selftest.py
