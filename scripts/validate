#!/usr/bin/env bash
# The product validation manifest, run explicitly rather than by git hooks.
#
# Usage: scripts/validate [AREA] [--changed BASE | --full] [--list]
#   AREA is one of: logic, manifests, boundary, cli, tools, repo, offline,
#   unit, qml, all (default: all). One area per call.
#   repo holds the checks this file makes itself, the whitespace
#   row and the self-check that every scripts/test-* file has a row;
#   scripts/test-validate.sh, under tools, is their control. unit runs the
#   QML unit tests, which need Qt and no Wayland session; offline runs
#   every row but unit and the nested smoke.
#   --changed BASE selects rows whose inputs changed against BASE, including
#   staged, unstaged and untracked files. Renames include both paths. Unknown
#   inputs or an unreadable diff select the whole area. Repository checks
#   always run. --list prints selected commands without executing them.
#   Without a scope flag, compare against the default branch's merge base.
#   --full explicitly selects every row in the area.
#
# VGS_VALIDATE_BASE: the commit the whitespace row diffs the tree against;
#   used as the default change base too. --changed overrides it. Unset,
#   whitespace_base below resolves the base; an unavailable base exits 77.
# DEV_VALIDATE_BASE: the fix-round base supplied by Kendex; used when neither
#   --changed nor --full is present.
#
# Exit 0: every selected check passed. Exit 77: every check that ran passed
# but at least one could not run and is named; that is not a pass. Exit 1: a
# check failed. Exit 2: invalid area or arguments, named by
# `validate: refused: area=`, `extra-argument=` or
#   `changed-base=missing-or-repeated` or `scope=conflicting-or-repeated`.
set -euo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo="$(cd -- "$(dirname -- "$self")/.." && pwd)"
cd -- "$repo"

area="all"
area_given=false
change_base=""
list_only=false
full_scope=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --changed)
      if [[ $full_scope == true ]]; then
        echo 'validate: refused: scope=conflicting-or-repeated' >&2; exit 2
      fi
      if [[ $# -lt 2 || -z $2 || $2 == -* || -n $change_base ]]; then
        echo 'validate: refused: changed-base=missing-or-repeated' >&2; exit 2
      fi
      change_base="$2"; shift 2 ;;
    --full)
      if [[ $full_scope == true || -n $change_base ]]; then
        echo 'validate: refused: scope=conflicting-or-repeated' >&2; exit 2
      fi
      full_scope=true; shift ;;
    --list) list_only=true; shift ;;
    *)
      if [[ $area_given == true ]]; then
        printf 'validate: refused: extra-argument=%s\none area per call\n' "$1" >&2; exit 2
      fi
      area="$1"; area_given=true; shift ;;
  esac
done
case "$area" in
  logic|manifests|boundary|cli|tools|repo|offline|unit|qml|all) ;;
  *) printf 'validate: refused: area=%s\n' "$area" >&2; exit 2 ;;
esac
failed=()
skipped=()

run() { # LABEL CMD...
  local label="$1"; shift
  echo "== $label"
  local status=0
  "$@" || status=$?
  case "$status" in
    0) ;;
    77) skipped+=("$label") ;;
    *) failed+=("$label (exit $status)") ;;
  esac
}

# Rows: area | label | command | additional input globs, space-delimited.
# Command paths are also inputs.
rows=(
  "logic|plugin logic table|node scripts/test-plugin-logic.js|shell/Core/PluginLogic.js scripts/qml-library.js config/shell.json"
  "logic|dispatch table|node scripts/test-dispatch.js|shell/Core/Dispatch.js scripts/qml-library.js"
  "logic|instance lifetime cleanup|node scripts/test-lifetime.js|shell/Core/Lifetime.js scripts/qml-library.js"
  "logic|library loader controls|node scripts/test-qml-library.js|scripts/qml-library.js"
  "logic|theme judge table|node scripts/test-theme-logic.js|shell/Commons/ThemeLogic.js shell/Commons/Tokens.js scripts/qml-library.js themes/*"
  "logic|shipped theme packages and targets|bin/vgsh-theme-judge packages themes|themes/* bin/vgsh-theme-judge bin/lib/* shell/Commons/ThemeLogic.js shell/Commons/Tokens.js shell/Core/PluginLogic.js scripts/qml-library.js"
  "logic|theme target renderer|node scripts/test-theme-render.js|bin/lib/theme-render.js themes/targets/* shell/Commons/ThemeLogic.js shell/Commons/Tokens.js scripts/qml-library.js"
  "logic|theme selection edit|node scripts/test-theme-select.js|bin/lib/theme-select.js bin/lib/theme-render.js shell/Commons/ThemeLogic.js shell/Commons/Tokens.js scripts/qml-library.js"
  "logic|lucide icon data|node scripts/test-lucide-data.js|shell/Ui/icons/Lucide.js scripts/qml-library.js"
  "logic|launcher menu model|node scripts/test-launcher-model.js|shell/plugins/vgs.launcher/MenuModel.js shell/plugins/vgs.launcher/menu.json scripts/qml-library.js"
  "cli|launcher file search helper|scripts/test-launcher-file-search.sh|shell/plugins/vgs.launcher/file-search.sh"
  "logic|notifications logic|node scripts/test-notifications-logic.js|shell/plugins/vgs.notifications/NotificationLogic.js scripts/qml-library.js"
  "cli|notifications image helper|scripts/test-notifications-images.sh|shell/plugins/vgs.notifications/images.sh"
  "manifests|bundled manifests|node scripts/check-manifests.js|shell/plugins/* bin/vgsh-scan shell/Core/PluginLogic.js scripts/qml-library.js"
  "manifests|smoke fixture manifests|node scripts/check-manifests.js --base scripts/smoke/fixtures/plugins|scripts/smoke/fixtures/* bin/vgsh-scan shell/Core/PluginLogic.js scripts/qml-library.js"
  "manifests|manifest check controls|node scripts/test-check-manifests.js|scripts/check-manifests.js bin/vgsh-scan shell/Core/PluginLogic.js scripts/qml-library.js"
  "cli|runner CLI controls|scripts/test-vgsh.sh|scripts/vgsh-rows.sh bin/vgsh* bin/lib/* shell/Commons/ThemeLogic.js shell/Commons/Tokens.js themes/* shell/Core/PluginLogic.js scripts/check-manifests.js scripts/qml-library.js config/shell.json shell/plugins/*"
  "cli|theme reload controls|scripts/test-vgsh-reload.sh|scripts/vgsh-rows.sh bin/vgsh* bin/lib/* shell/Commons/ThemeLogic.js shell/Commons/Tokens.js themes/* shell/Core/PluginLogic.js scripts/qml-library.js config/shell.json"
  "cli|theme target controls|scripts/test-vgsh-targets.sh|scripts/vgsh-rows.sh bin/vgsh* bin/lib/* shell/Commons/ThemeLogic.js shell/Commons/Tokens.js themes/* shell/Core/PluginLogic.js scripts/qml-library.js config/shell.json"
