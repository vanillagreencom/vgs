#!/usr/bin/env python3
"""Read every plugin manifest under the given directories.

Prints one JSON array. Each element names a directory and carries either the
manifest text or the read error. Validation is not done here: the shell's
PluginLogic.js is the one judge of a manifest, and this script only reads
bytes.

  vgsh-scan [--require-base] BASE...

A base directory that does not exist is skipped, because the user plugin
directory is absent on a fresh install. Under --require-base it is an error
element like any other listing failure: the offline checks list the bundled
directory, where an absent base would certify nothing as everything. Every
other failure to list,
stat or open is an error element `{"dir": <path>, "error": "<what>: <strerror>"}`,
never a silent skip: a base that cannot be listed, an entry that cannot be
stat'ed, and a manifest that cannot be opened. An entry that is not a
directory, or a directory with no manifest.json, is not a plugin and is skipped.
"""
import json
import os
import stat
import sys


def scan_base(base, out, require_base):
    try:
        names = sorted(os.listdir(base))
    except OSError as exc:
        if isinstance(exc, FileNotFoundError) and not require_base:
            return
        out.append({"dir": base, "error": f"cannot list: {exc.strerror}"})
        return
    for name in names:
        plugin_dir = os.path.join(base, name)
        try:
            st = os.stat(plugin_dir)
        except OSError as exc:
            out.append({"dir": plugin_dir, "error": f"cannot stat: {exc.strerror}"})
            continue
        if not stat.S_ISDIR(st.st_mode):
            continue
        manifest = os.path.join(plugin_dir, "manifest.json")
        try:
            with open(manifest, encoding="utf-8") as fh:
                out.append({"dir": plugin_dir, "text": fh.read()})
        except FileNotFoundError:
            continue
        except OSError as exc:
            out.append({"dir": plugin_dir, "error": f"cannot read manifest: {exc.strerror}"})


def main(argv):
    bases = argv[1:]
    require_base = bases[:1] == ["--require-base"]
    if require_base:
        bases = bases[1:]
    out = []
    for base in bases:
        scan_base(base, out, require_base)
    json.dump(out, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
