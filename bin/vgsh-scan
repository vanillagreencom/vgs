#!/usr/bin/env python3
"""Read every plugin manifest under the given directories.

Prints one JSON array. Each element names the plugin directory and carries
either the manifest text or the read error. Validation is not done here: the
shell's PluginLogic.js is the one judge of a manifest, and this script only
reads bytes. A directory argument that does not exist is skipped, because the
user plugin directory is absent on a fresh install. A directory that exists
and cannot be listed is an error element, never a silent skip.
"""
import json
import os
import sys


def main(argv):
    out = []
    for base in argv[1:]:
        if not os.path.exists(base):
            continue
        if not os.path.isdir(base):
            out.append({"dir": base, "error": "not a directory"})
            continue
        try:
            names = sorted(os.listdir(base))
        except OSError as exc:
            out.append({"dir": base, "error": f"cannot list: {exc.strerror}"})
            continue
        for name in names:
            plugin_dir = os.path.join(base, name)
            manifest = os.path.join(plugin_dir, "manifest.json")
            if not os.path.isdir(plugin_dir) or not os.path.isfile(manifest):
                continue
            try:
                with open(manifest, encoding="utf-8") as fh:
                    out.append({"dir": plugin_dir, "text": fh.read()})
            except OSError as exc:
                out.append({"dir": plugin_dir, "error": f"cannot read manifest: {exc.strerror}"})
    json.dump(out, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
