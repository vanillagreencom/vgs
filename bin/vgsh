#!/usr/bin/env bash
# vgsh: the v2 shell runner and plugin manager CLI.
#
#   vgsh run                       start the shell in the foreground; holds the instance lock
#   vgsh pid                       print the running shell's pid from the instance lock
#   vgsh ipc <qs ipc args...>      talk to the running shell (qs ipc against its pid)
#   vgsh log <qs log args...>      read the running shell's log
#   vgsh plugin list               every discovered plugin with its enabled state, and each configured id no plugin has
#   vgsh plugin enable <id>        enable one plugin; a bar becomes the active bar
#   vgsh plugin disable <id>       disable one plugin; names the bar widgets it takes off screen
#   vgsh plugin validate <dir>     validate a plugin directory's manifest offline
#   vgsh plugin add <git url>      clone, validate and install one plugin, disabled
#   vgsh plugin update <id>        fetch, show the diff and fast-forward an installed plugin
#   vgsh plugin remove <id>        delete an installed plugin's directory
#   vgsh theme list [--json]       every theme package, its state and palette, and the theme file's state
#   vgsh theme apply [--json] <name>
#                                  apply one theme package to the shell and every enabled target; `apply vgs` restores the defaults
#   vgsh theme reload [--json]     run every pending reload hook again
#   vgsh theme follow [--json]     apply the applied package again when it changed and the theme file is unedited
#   vgsh theme background [--json] next|previous
#                                  show the applied package's next or previous background image and remember it
#   vgsh theme add <git url>       clone, judge and install one theme package
#   vgsh theme update <name>       fetch, show the diff and fast-forward an installed theme package, then follow it
#   vgsh theme remove <name>       delete an installed theme package's directory
#   vgsh theme browser-policy install
#                                  install the Chromium-family colour writer and its sudoers rule, once; sudo asks for the password
#
# `run` takes no arguments: the shell always runs in the foreground under
# this process, which is the identity the shell's guard checks. The lock file
# $XDG_RUNTIME_DIR/vgsh.lock holds the runner's pid while it runs. Every
# command that contacts the shell addresses that instance alone, so a shell
# started any other way is never reached. `plugin validate`, `plugin add`,
# `plugin update` and `plugin remove` work with no shell running.
#
# add, update and remove run no code from the plugin and no git hook, and ask
# for no privilege: installed plugins live under
# ${XDG_CONFIG_HOME:-~/.config}/vgs/plugins/<id>. add lands the plugin
# disabled. Each ends with `shell=rescan-started` or `shell=rescan-queued`
# when a shell runs (the scan's result is in `vgsh plugin list`), or
# `shell=not-running` when none does and the next start reads the change.
#
# Theme packages are the shipped themes/<name>/ and the installed
# ${XDG_CONFIG_HOME:-~/.config}/vgs/themes/<name>/; an installed package
# hides a shipped one of its name, except the reserved `vgs`. `theme apply`
# holds flock on ${XDG_CONFIG_HOME:-~/.config}/vgs/theme.lock for the whole
# apply, so a second apply from any caller is refused with reason=busy. It
# renders the package and every target under themes/targets/ whose commands
# are on PATH and that shell.json's disabledTargets does not list into
# ${XDG_STATE_HOME:-~/.local/state}/vgs/theme/, writes theme.name beside it,
# keeps each target's include line in its application's configuration file
# (a disabled target's is removed; one that renders nothing keeps the file it
# landed before), then copies the package's theme.json byte for byte to
# theme.json beside the lock, the file the shell watches. No other
# application file is written. Last, each landed target whose bytes changed
# or whose reload is pending runs its target.json reload hook, bounded by
# its timeout, with output discarded and no lock descriptor; a hook that
# fails or times out leaves the target reload-pending in
# ${XDG_STATE_HOME:-~/.local/state}/vgs/reload-pending.json. `theme reload`
# holds the same lock and runs every pending hook again, and nothing else.
# Apply records the package's name, the hash of the bytes it wrote to the
# theme file and a digest of the package's content in
# ${XDG_STATE_HOME:-~/.local/state}/vgs/applied.json. `theme follow` holds
# the same lock and applies the recorded package again when its content
# changed while the theme file still holds those bytes; a hand-edited file
# stays. `theme list` reports that unedited file unmodified.
# Apply also makes the package's remembered background image, else its
# first, the current one: the ${XDG_STATE_HOME:-~/.local/state}/vgs/background
# symlink and backgrounds.json beside it. `theme background next` and
# `previous` hold the same lock and move to the applied package's next or
# previous image, remembering it: docs/architecture/theme-backgrounds.md.
# `--json` prints the list, the apply's result `{ state, shell, targets,
# theme, reason }`, the follow's, that result with its `follow` outcome,
# the reload's `{ state, targets, reason }` or the background step's
# `{ state, background, theme, path, reason }`, refusals included, as one
# JSON line on stdout. `theme` commands never contact the
# shell: docs/architecture/theme-apply.md.
#
# `theme add`, `update` and `remove` follow the plugin rules above for
# ${XDG_CONFIG_HOME:-~/.config}/vgs/themes/<name>: add stages the clone,
# lands it under its theme.json name once the theme judge accepts it and
# refuses an occupied name and the reserved `vgs`; update refuses a
# modified checkout and rolls back a version the judge refuses, and a
# version it accepts follows as `theme follow` does for that package, its
# line last and its exit status update's; remove deletes only an installed
# package, never a shipped one. Each holds the theme lock while it changes
# the package; a held lock is reason=busy.
# docs/architecture/themes.md § Install.
#
# `theme browser-policy install` is the one command that asks for a
# privilege: bin/vgsh-browser-policy installs itself root-owned with one
# NOPASSWD sudoers rule for the calling user, the setup the chromium
# target's hook needs. Apply never prompts: until the setup exists that
# target is skipped with reason=setup-absent, and its hook runs `sudo -n`.
# docs/architecture/theme-browsers.md § Chromium.
#
# Every refusal prints one keyed line first: `vgsh: refused: <key>=<value>`.
# Exit 0 on success, 1 on a refusal, 2 on a bad invocation, 3 when a theme
# apply, follow or reload is partial (a target failed or its reload stays pending;
# each prints `vgsh: refused: target=<name> reason=<key>`), 75 when
# another shell holds the lock or another theme command holds the theme
# lock, 69 when the shell is not running. The usage text is this header;
# `vgsh --help` prints it and exits 0.
set -euo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
root="$(cd -- "$(dirname -- "$self")/.." && pwd)"
shell_dir="$root/shell"
rt_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
lock="$rt_dir/vgsh.lock"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"

usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$self" >&2; }

# Prints the pid the lock file records, or returns 69 after the refusal.
# A pid is only written by the runner after it took the lock, so an empty
# or absent file means no shell started through the runner. A recorded pid
# whose process is gone is the same refusal: the runner exec'd into the
# shell, so its pid is the shell's. Callers exit with the returned status
# themselves; errexit does not reach a failed command substitution here.
shell_pid() {
  local pid
  if [[ ! -r $lock ]]; then
    printf 'vgsh: refused: shell=not-running lock=%s\n' "$lock" >&2
    return 69
  fi
  if ! pid="$(head -n 1 -- "$lock")" || [[ ! $pid =~ ^[0-9]+$ ]]; then
    printf 'vgsh: refused: shell=not-running lock=%s\n' "$lock" >&2
    return 69
  fi
  if [[ ! -d /proc/$pid ]]; then
    printf 'vgsh: refused: shell=not-running pid=%s\n' "$pid" >&2
    return 69
  fi
  printf '%s\n' "$pid"
}

# One IPC call. qs prints its own log lines on stdout ahead of the reply;
# the reply is the last stdout line. stderr passes through untouched.
ipc() {
  local pid out status
  pid="$(shell_pid)" || exit $?
  set +e
  out="$(qs ipc --pid "$pid" call "$@")"
  status=$?
  set -e
  if [[ $status -ne 0 ]]; then
    printf 'vgsh: refused: shell=not-running pid=%s\n%s\n' "$pid" "$out" >&2
    exit 69
  fi
  printf '%s\n' "${out##*$'\n'}"
}

user_plugins="$config_home/vgs/plugins"
judge="$root/bin/vgsh-plugin-judge"
theme_judge="$root/bin/vgsh-theme-judge"
# Beside the file it guards, so callers with different runtime dirs still
# take the same lock. Created once and never removed.
theme_lock="$config_home/vgs/theme.lock"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"

refuse() { # STATUS FIRST_LINE [ENGLISH...]
  local status="$1"
  printf 'vgsh: refused: %s\n' "$2" >&2
  shift 2
  [[ $# -gt 0 ]] && printf '%s\n' "$@" >&2
  exit "$status"
}

# Every git call: no pager, no hook, no filesystem monitor. The plugin's
# repository cannot set any of these, but the user's git configuration can,
# and none of them may run while vgsh handles plugin files. Descriptor 9 is
# closed for git, so a gc git detaches never holds the theme lock.
git_plain() { git --no-pager -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@" 9>&-; }

# One git call whose failure is a refusal: KEY is the first stderr line and
# git's own messages follow it. Stdout passes through.
git_or_refuse() { # KEY GIT_ARGS...
  local key="$1" err
  shift
  { err="$(git_plain "$@" 2>&1 1>&3 3>&-)"; } 3>&1 || refuse 1 "$key" "$err"
  [[ -z $err ]] || printf '%s\n' "$err" >&2
}

# The shell's manifest judge run offline on one plugin directory; it also
# checks every entry point exists. Prints its verdict lines.
manifest_check="$root/scripts/check-manifests.js"

# Plugin directories whose manifest the judge accepts with ID, one per line.
owners_of() { # ID
  local scan
  scan="$("$root/bin/vgsh-scan" "$user_plugins" "$shell_dir/plugins")" || refuse 1 "scan=failed"
  node "$judge" owners "$1" <<<"$scan"
}

# After add, update or remove: a running shell re-reads its manifests, and
# with none running the next start reads them.
rescan_if_running() {
  local reply
  if ! shell_pid >/dev/null 2>&1; then echo "shell=not-running"; return 0; fi
  reply="$(ipc shell rescanPlugins)" || exit $?
  case "$reply" in
    ok) echo "shell=rescan-started" ;;
    busy) echo "shell=rescan-queued" ;;
    *) refuse 1 "rescan=$reply" "the plugin files changed; run vgsh ipc call shell rescanPlugins" ;;
  esac
}

# The directory `add` installed plugin ID into, resolved. An absent one is
# refused naming who owns the id instead; a symlink, a path that leaves the
# user plugin directory, or a manifest naming another id is refused.
installed_dir() { # ID
  local id="$1" target="$user_plugins/$1" real base owners owner got
  if [[ ! -e $target && ! -L $target ]]; then
    owners="$(owners_of "$id")" || exit 1
    owner="${owners%%$'\n'*}"
    [[ -z $owner ]] && refuse 1 "unknown=$id"
    [[ $owner == "$shell_dir/plugins/"* ]] && refuse 1 "bundled=$id" "a bundled plugin is disabled, not removed: vgsh plugin disable $id"
    refuse 1 "not-installed=$id owner=$owner" "only a plugin vgsh plugin add installed is updated or removed"
  fi
  [[ -L $target ]] && refuse 1 "symlink=$target"
  base="$(realpath -e -- "$user_plugins")" || refuse 1 "unreadable=$user_plugins"
  real="$(realpath -e -- "$target")" || refuse 1 "unreadable=$target"
  [[ -d $real && $(dirname -- "$real") == "$base" ]] || refuse 1 "outside=$real"
  got="$(node "$judge" id "$real")" || exit 1
  [[ $got == "$id" ]] || refuse 1 "manifest-id=$got path=$real"
  printf '%s\n' "$real"
}

plugin_add() { # URL
  local url="$1" verdict id target owners landed
  mkdir -p -- "$user_plugins"
  # Staged beside the plugin directory, never inside it, so no scan sees a
  # half-cloned plugin and the final move is a rename on one filesystem.
  stage="$(mktemp -d "$config_home/vgs/.vgsh-add.XXXXXX")" || refuse 1 "staging=$config_home/vgs"
  trap 'rm -rf -- "${stage:?}"' EXIT
  git_or_refuse "clone=$url" clone --quiet --no-recurse-submodules -- "$url" "$stage/plugin"
  verdict="$(node "$manifest_check" -- "$stage/plugin")" || refuse 1 "manifest=$url" "$verdict"
  id="$(node "$judge" id "$stage/plugin")" || exit 1
  owners="$(owners_of "$id")" || exit 1
  [[ -z $owners ]] || refuse 1 "id-owned=$id owner=${owners%%$'\n'*}"
  target="$user_plugins/$id"
  [[ -e $target || -L $target ]] && refuse 1 "exists=$target"
  # Before the move, so the first scan that sees the plugin sees it disabled.
  landed="$(node "$judge" land-disabled "$root/config/shell.json" "$config_home/vgs/shell.json" "$stage/plugin")" || exit 1
  mv -T -- "$stage/plugin" "$target" || refuse 1 "move=$target"
  echo "ok added=$id path=$target config=$landed"
  rescan_if_running
}

rollback() { # DIR COMMIT
  git_or_refuse "rollback=failed path=$1 to=$2" -C "$1" reset --quiet --hard "$2"
}

# Fetch checkout DIR's upstream and, when it is new, print the incoming diff
# and fast-forward to it. Sets ff_old and ff_new, the commits before and
# after, equal when DIR was already up to date. LABEL names DIR in the
# refusals: a directory that is not its own checkout, a modified checkout,
# a failed fetch, no upstream, and a source that rewrote its history.
fast_forward() { # DIR LABEL
  local dir="$1" label="$2" top dirty err rc=0
  top="$(git_or_refuse "not-a-checkout=$dir" -C "$dir" rev-parse --show-toplevel)" || exit 1
  [[ $top == "$dir" ]] || refuse 1 "not-a-checkout=$dir toplevel=$top"
  dirty="$(git_or_refuse "git=status path=$dir" -C "$dir" status --porcelain --untracked-files=all)" || exit 1
  [[ -z $dirty ]] || refuse 1 "modified=$dir" "commit or discard the local changes first"
  git_or_refuse "fetch=$label" -C "$dir" fetch --quiet --no-recurse-submodules
  ff_new="$(git_or_refuse "upstream=missing path=$dir" -C "$dir" rev-parse --verify '@{upstream}')" || exit 1
  ff_old="$(git_or_refuse "git=rev-parse path=$dir" -C "$dir" rev-parse --verify HEAD)" || exit 1
  [[ $ff_old == "$ff_new" ]] && return 0
  err="$(git_plain -C "$dir" merge-base --is-ancestor "$ff_old" "$ff_new" 2>&1)" || rc=$?
  case "$rc" in
    0) ;;
    1) refuse 1 "not-fast-forward=$label" "the source rewrote its history; remove and add it again" ;;
    *) refuse 1 "git=merge-base exit=$rc path=$dir" "$err" ;;
  esac
  git_or_refuse "git=diff path=$dir" -C "$dir" diff --no-ext-diff --no-textconv "$ff_old" "$ff_new"
  git_or_refuse "git=merge path=$dir" -C "$dir" merge --quiet --ff-only "$ff_new"
}

plugin_update() { # ID
  local id="$1" dir verdict new_id
  dir="$(installed_dir "$id")" || exit $?
  fast_forward "$dir" "$id"
  if [[ $ff_old == "$ff_new" ]]; then
    echo "ok up-to-date=$id"
    return 0
  fi
  # A refused new version is undone before the refusal, so the installed
  # plugin is always one the judge accepted.
  if ! verdict="$(node "$manifest_check" -- "$dir")"; then
    rollback "$dir" "$ff_old"
    refuse 1 "manifest=$id rolled-back=${ff_old:0:12}" "$verdict"
  fi
  if ! new_id="$(node "$judge" id "$dir")" || [[ $new_id != "$id" ]]; then
    rollback "$dir" "$ff_old"
    refuse 1 "manifest-id=${new_id:-unreadable} want=$id rolled-back=${ff_old:0:12}"
  fi
  echo "ok updated=$id from=${ff_old:0:12} to=${ff_new:0:12}"
  rescan_if_running
}

plugin_remove() { # ID
  local id="$1" dir
  dir="$(installed_dir "$id")" || exit $?
  rm -rf -- "${dir:?}" || refuse 1 "remove=$dir"
  echo "ok removed=$id"
  rescan_if_running
}

user_themes="$config_home/vgs/themes"

# Hold the theme lock on descriptor 9 until this process exits, so no apply
# reads a package while add, update or remove changes it, and no two of
# them change one at once. A lock held elsewhere refuses with reason=busy.
theme_lock_hold() { # NAME
  local rc=0
  mkdir -p -- "$config_home/vgs" 2>/dev/null && { exec 9>>"$theme_lock"; } 2>/dev/null ||
    refuse 1 "theme=$1 reason=lock-failed path=$theme_lock"
  flock -n -E 75 9 || rc=$?
  case "$rc" in
    0) ;;
    75) refuse 75 "theme=$1 reason=busy" "a theme apply, add, update or remove is running" ;;
    *) refuse 1 "theme=$1 reason=lock-failed path=$theme_lock" ;;
  esac
}

# Take the theme lock on descriptor 9 for a judge that execs from here and
# set `verdict` to held, busy or failed; the judge refuses on the last two.
# The judge runs under this process's descriptor 9, so it holds the lock
# until it exits, and it prints every refusal, busy included, so a --json
# caller reads a result on every path. bin/vgsh-theme-judge's LOCK_FD names
# the same number: no reload hook it runs holds the descriptor.
theme_lock_verdict() {
  local status=0
  verdict=failed
  mkdir -p -- "$config_home/vgs" 2>/dev/null && { exec 9>>"$theme_lock"; } 2>/dev/null || return 0
  flock -n -E 75 9 || status=$?
  case "$status" in
    0) verdict=held ;;
    75) verdict=busy ;;
  esac
}

# The theme judge's verdict on package DIR as installed, named NAME or by
# its document. Sets `verdict` to the accepted name and returns 0, or to
# the judge's `reason=...` line and returns 1; a judge that fails without
# a verdict line is `reason=judge-failed exit=<status>`.
accept_theme() { # DIR [NAME]
  local rc=0
  verdict="$(node "$theme_judge" accept "$@")" || rc=$?
  [[ $rc == 0 ]] && return 0
  [[ $rc == 1 && $verdict == reason=* && $verdict != *$'\n'* ]] || verdict="reason=judge-failed exit=$rc"
  return 1
}

theme_add() { # URL
  local url="$1" name target line
  mkdir -p -- "$user_themes"
  # Staged beside the themes directory, never inside it, so no list sees a
  # half-cloned package and the final move is a rename on one filesystem.
  stage="$(mktemp -d "$config_home/vgs/.vgsh-theme-add.XXXXXX")" || refuse 1 "staging=$config_home/vgs"
  trap 'rm -rf -- "${stage:?}"' EXIT
  git_or_refuse "clone=$url" clone --quiet --no-recurse-submodules -- "$url" "$stage/package"
  accept_theme "$stage/package" || refuse 1 "package=$url $verdict"
  name="$verdict"
  target="$user_themes/$name"
  theme_lock_hold "$name"
  [[ -e $target || -L $target ]] && refuse 1 "theme=$name reason=exists path=$target"
  mv -T -- "$stage/package" "$target" || refuse 1 "theme=$name reason=move path=$target"
  line="ok added=$name path=$target"
  [[ -d $root/themes/$name ]] && line+=" shadows=$root/themes/$name"
  echo "$line"
}

theme_update() { # NAME
  local name="$1" dir
  dir="$(node "$theme_judge" installed "$config_home/vgs" "$name")" || exit $?
  theme_lock_hold "$name"
  fast_forward "$dir" "$name"
  if [[ $ff_old == "$ff_new" ]]; then
    echo "ok up-to-date=$name"
    return 0
  fi
  # A refused new version is undone before the refusal, so the installed
  # package is always one the judge accepted.
  if ! accept_theme "$dir" "$name"; then
    rollback "$dir" "$ff_old"
    refuse 1 "theme=$name $verdict rolled-back=${ff_old:0:12}"
  fi
  echo "ok updated=$name from=${ff_old:0:12} to=${ff_new:0:12}"
  # Still under the lock this process holds on descriptor 9.
  exec node "$theme_judge" follow text "$config_home/vgs" "$state_home/vgs" held "$name"
}

theme_remove() { # NAME
  local name="$1" dir
  dir="$(node "$theme_judge" installed "$config_home/vgs" "$name")" || exit $?
  theme_lock_hold "$name"
  rm -rf -- "${dir:?}" || refuse 1 "theme=$name reason=remove path=$dir"
  echo "ok removed=$name"
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  run)
    if [[ $# -gt 0 ]]; then
      printf 'vgsh: refused: argument=%s\nrun takes no arguments; the shell runs in the foreground under the runner\n' "$1" >&2
      exit 2
    fi
    # The shell watches files in both directories from its start, and a
    # watch on a file whose directory is absent never fires once the
    # directory appears: docs/architecture/runtime-qml.md.
    mkdir -p -- "$config_home/vgs" "$state_home/vgs"
    # Opened for append so a runner that loses the race never truncates the
    # holder's pid; only the holder rewrites the file.
    exec 9>>"$lock"
    if ! flock -n 9; then
      printf 'vgsh: refused: lock=%s\nanother vgsh run holds the instance lock; one shell per session\n' "$lock" >&2
      exit 75
    fi
    truncate -s 0 -- "$lock"
    printf '%s\n' "$$" >&9
    # The lock proves no runner-started shell is alive, so every source
    # snapshot root under the runtime dir belongs to a dead shell.
    for stale in "$rt_dir"/vgsh-sources-*; do
      [[ -e $stale || -L $stale ]] || continue
      rm -rf -- "${stale:?}"
    done
    # exec keeps this pid and the lock descriptor, so the shell can prove it
    # is the lock holder by comparing VGSH_RUNNER_PID with its own pid.
    VGSH_RUNNER_PID=$$ exec qs -p "$shell_dir"
    ;;
  pid)
    pid="$(shell_pid)" || exit $?
    printf '%s\n' "$pid"
    ;;
  ipc)
    pid="$(shell_pid)" || exit $?
    exec qs ipc --pid "$pid" "$@"
    ;;
  log)
    pid="$(shell_pid)" || exit $?
    exec qs log --pid "$pid" "$@"
    ;;
  plugin)
    sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$sub" in
      list)
        # Captured first so the not-running exit code is the command's, not
        # the formatter's.
        reply="$(ipc shell listPlugins)" || exit $?
        python3 - "$reply" <<'PY'
import json, sys
data = json.loads(sys.argv[1])
for p in data["plugins"]:
    state = "enabled" if p["enabled"] else "disabled"
    print(f"{p['id']:<28} {p['version']:<8} {state:<9} kinds={','.join(p['kinds'])}")
for e in data["errors"]:
    print(f"error   {e['dir']}: {e['error']}")
for c in data["collisions"]:
    print(f"hidden  {c}")
for u in data["unknown"]:
    print(f"unknown {u['id']} in {u['key']}")
if data.get("scanError"):
    print(f"scan-error {data['scanError']}")
PY
        ;;
      enable|disable)
        id="${1:-}"
        if [[ -z $id ]]; then printf 'vgsh: refused: id=missing\n' >&2; usage; exit 2; fi
        enabled=true; [[ $sub == disable ]] && enabled=false
        reply="$(ipc shell setPluginEnabled "$id" "$enabled")" || exit $?
        case "$reply" in
          ok) echo ok ;;
          "ok hidden="*) echo "$reply"; echo "those bar widgets stay enabled and return when a bar is enabled" ;;
          *) printf 'vgsh: refused: %s\n' "$reply" >&2; exit 1 ;;
        esac
        ;;
      add)
        url="${1:-}"
        if [[ -z $url ]]; then printf 'vgsh: refused: url=missing\n' >&2; usage; exit 2; fi
        plugin_add "$url"
        ;;
      update|remove)
        id="${1:-}"
        if [[ -z $id ]]; then printf 'vgsh: refused: id=missing\n' >&2; usage; exit 2; fi
        "plugin_$sub" "$id"
        ;;
      validate)
        dir="${1:-}"
        if [[ -z $dir ]]; then printf 'vgsh: refused: dir=missing\n' >&2; usage; exit 2; fi
        exec node "$manifest_check" -- "$dir"
        ;;
      *)
        printf 'vgsh: refused: plugin-subcommand=%s\n' "${sub:-missing}" >&2; usage; exit 2
        ;;
    esac
    ;;
  theme)
    sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    format=text
    if [[ ${1:-} == --json ]]; then format=json; shift; fi
    case "$sub" in
      list)
        if [[ $# -gt 0 ]]; then printf 'vgsh: refused: argument=%s\n' "$1" >&2; usage; exit 2; fi
        exec node "$theme_judge" list "$format" "$config_home/vgs" "$state_home/vgs"
        ;;
      apply)
        name="${1:-}"
        if [[ -z $name ]]; then printf 'vgsh: refused: name=missing\n' >&2; usage; exit 2; fi
        if [[ $# -gt 1 ]]; then printf 'vgsh: refused: argument=%s\n' "$2" >&2; usage; exit 2; fi
        theme_lock_verdict
        exec node "$theme_judge" apply "$format" "$config_home/vgs" "$state_home/vgs" "$verdict" "$name"
        ;;
      reload)
        if [[ $# -gt 0 ]]; then printf 'vgsh: refused: argument=%s\n' "$1" >&2; usage; exit 2; fi
        theme_lock_verdict
        exec node "$theme_judge" reload "$format" "$config_home/vgs" "$state_home/vgs" "$verdict"
        ;;
      follow)
        if [[ $# -gt 0 ]]; then printf 'vgsh: refused: argument=%s\n' "$1" >&2; usage; exit 2; fi
        theme_lock_verdict
        exec node "$theme_judge" follow "$format" "$config_home/vgs" "$state_home/vgs" "$verdict"
        ;;
      background)
        step="${1:-}"
        if [[ $step != next && $step != previous ]]; then printf 'vgsh: refused: background-subcommand=%s\n' "${step:-missing}" >&2; usage; exit 2; fi
        if [[ $# -gt 1 ]]; then printf 'vgsh: refused: argument=%s\n' "$2" >&2; usage; exit 2; fi
        theme_lock_verdict
        exec node "$theme_judge" background "$format" "$step" "$config_home/vgs" "$state_home/vgs" "$verdict"
        ;;
      browser-policy)
        [[ $format == json ]] && { printf 'vgsh: refused: argument=--json\n' >&2; usage; exit 2; }
        if [[ ${1:-} != install ]]; then printf 'vgsh: refused: browser-policy-subcommand=%s\n' "${1:-missing}" >&2; usage; exit 2; fi
        if [[ $# -gt 1 ]]; then printf 'vgsh: refused: argument=%s\n' "$2" >&2; usage; exit 2; fi
        exec "$root/bin/vgsh-browser-policy" install
        ;;
      add|update|remove)
        arg="${1:-}"
        [[ $format == json ]] && { printf 'vgsh: refused: argument=--json\n' >&2; usage; exit 2; }
        if [[ -z $arg ]]; then
          missing=name; [[ $sub == add ]] && missing=url
          printf 'vgsh: refused: %s=missing\n' "$missing" >&2; usage; exit 2
        fi
        if [[ $# -gt 1 ]]; then printf 'vgsh: refused: argument=%s\n' "$2" >&2; usage; exit 2; fi
        "theme_$sub" "$arg"
        ;;
      *)
        printf 'vgsh: refused: theme-subcommand=%s\n' "${sub:-missing}" >&2; usage; exit 2
        ;;
    esac
    ;;
  -h|--help|help)
    usage; exit 0
    ;;
  *)
    printf 'vgsh: refused: command=%s\n' "${cmd:-missing}" >&2; usage; exit 2
    ;;
esac
