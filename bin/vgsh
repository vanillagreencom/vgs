#!/usr/bin/env bash
# vgsh: the v2 shell runner and plugin manager CLI.
#
#   vgsh run                       start the shell in the foreground; holds the instance lock
#   vgsh ipc <qs ipc args...>      talk to the running shell (qs ipc against its pid)
#   vgsh log <qs log args...>      read the running shell's log
#   vgsh plugin list               every discovered plugin with its enabled state
#   vgsh plugin enable <id>        enable one plugin; a bar becomes the active bar
#   vgsh plugin disable <id>       disable one plugin; names the bar widgets it takes off screen
#   vgsh plugin validate <dir>     validate a plugin directory's manifest offline
#   vgsh plugin add <git url>      clone, validate and install one plugin, disabled
#   vgsh plugin update <id>        fetch, show the diff and fast-forward an installed plugin
#   vgsh plugin remove <id>        delete an installed plugin's directory
#
# `run` takes no arguments: the shell always runs in the foreground under
# this process, which is the identity the shell's guard checks. The lock file
# $XDG_RUNTIME_DIR/vgsh.lock holds the runner's pid while it runs, and every
# other command addresses that instance alone, so a shell started any other
# way is never reached.
#
# add, update and remove run no code from the plugin and no git hook, and ask
# for no privilege: installed plugins live under
# ${XDG_CONFIG_HOME:-~/.config}/vgs/plugins/<id>. add lands the plugin
# disabled. Each ends with `shell=rescanned` when a shell runs, or
# `shell=not-running` when none does and the next start reads the change.
#
# Every refusal prints one keyed line first: `vgsh: refused: <key>=<value>`.
# Exit 0 on success, 1 on a refusal, 2 on a bad invocation, 75 when another
# shell holds the lock, 69 when the shell is not running.
set -euo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
root="$(cd -- "$(dirname -- "$self")/.." && pwd)"
shell_dir="$root/shell"
rt_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
lock="$rt_dir/vgsh.lock"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"

usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$self" >&2; }

# Prints the pid the lock file records, or returns 69 after the refusal.
# A pid is only written by the runner after it took the lock, so an empty
# or absent file means no shell started through the runner. A recorded pid
# whose process is gone is the same refusal: the runner exec'd into the
# shell, so its pid is the shell's. Callers exit with the returned status
# themselves; errexit does not reach a failed command substitution here.
shell_pid() {
  local pid
  if [[ ! -r $lock ]]; then
    printf 'vgsh: refused: shell=not-running lock=%s\n' "$lock" >&2
    return 69
  fi
  if ! pid="$(head -n 1 -- "$lock")" || [[ ! $pid =~ ^[0-9]+$ ]]; then
    printf 'vgsh: refused: shell=not-running lock=%s\n' "$lock" >&2
    return 69
  fi
  if [[ ! -d /proc/$pid ]]; then
    printf 'vgsh: refused: shell=not-running pid=%s\n' "$pid" >&2
    return 69
  fi
  printf '%s\n' "$pid"
}

# One IPC call. qs prints its own log lines on stdout ahead of the reply;
# the reply is the last stdout line. stderr passes through untouched.
ipc() {
  local pid out status
  pid="$(shell_pid)" || exit $?
  set +e
  out="$(qs ipc --pid "$pid" call "$@")"
  status=$?
  set -e
  if [[ $status -ne 0 ]]; then
    printf 'vgsh: refused: shell=not-running pid=%s\n%s\n' "$pid" "$out" >&2
    exit 69
  fi
  printf '%s\n' "${out##*$'\n'}"
}

user_plugins="$config_home/vgs/plugins"
judge="$root/bin/vgsh-plugin-judge"

refuse() { # STATUS FIRST_LINE [ENGLISH...]
  local status="$1"
  printf 'vgsh: refused: %s\n' "$2" >&2
  shift 2
  [[ $# -gt 0 ]] && printf '%s\n' "$@" >&2
  exit "$status"
}

# Every git call: no pager, no hook, no filesystem monitor. The plugin's
# repository cannot set any of these, but the user's git configuration can,
# and none of them may run while vgsh handles plugin files.
git_plain() { git --no-pager -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"; }

# One git call whose failure is a refusal: KEY is the first stderr line and
# git's own messages follow it. Stdout passes through.
git_or_refuse() { # KEY GIT_ARGS...
  local key="$1" err
  shift
  { err="$(git_plain "$@" 2>&1 1>&3 3>&-)"; } 3>&1 || refuse 1 "$key" "$err"
  [[ -z $err ]] || printf '%s\n' "$err" >&2
}

# The shell's manifest judge run offline on one plugin directory; it also
# checks every entry point exists. Prints its verdict lines.
manifest_check="$root/scripts/check-manifests.js"

# Plugin directories whose manifest the judge accepts with ID, one per line.
owners_of() { # ID
  local scan
  scan="$("$root/bin/vgsh-scan" "$user_plugins" "$shell_dir/plugins")" || refuse 1 "scan=failed"
  node "$judge" owners "$1" <<<"$scan"
}

# After add, update or remove: a running shell re-reads its manifests, and
# with none running the next start reads them.
rescan_if_running() {
  local reply
  if ! shell_pid >/dev/null 2>&1; then echo "shell=not-running"; return 0; fi
  reply="$(ipc shell rescanPlugins)" || exit $?
  case "$reply" in
    ok|busy) echo "shell=rescanned" ;;
    *) refuse 1 "rescan=$reply" "the plugin files changed; run vgsh ipc call shell rescanPlugins" ;;
  esac
}

# The directory `add` installed plugin ID into, resolved. An absent one is
# refused naming who owns the id instead; a symlink, a path that leaves the
# user plugin directory, or a manifest naming another id is refused.
installed_dir() { # ID
  local id="$1" target="$user_plugins/$1" real base owners owner got
  if [[ ! -e $target && ! -L $target ]]; then
    owners="$(owners_of "$id")" || exit 1
    owner="${owners%%$'\n'*}"
    [[ -z $owner ]] && refuse 1 "unknown=$id"
    [[ $owner == "$shell_dir/plugins/"* ]] && refuse 1 "bundled=$id" "a bundled plugin is disabled, not removed: vgsh plugin disable $id"
    refuse 1 "not-installed=$id owner=$owner" "only a plugin vgsh plugin add installed is updated or removed"
  fi
  [[ -L $target ]] && refuse 1 "symlink=$target"
  base="$(realpath -e -- "$user_plugins")" || refuse 1 "unreadable=$user_plugins"
  real="$(realpath -e -- "$target")" || refuse 1 "unreadable=$target"
  [[ -d $real && $(dirname -- "$real") == "$base" ]] || refuse 1 "outside=$real"
  got="$(node "$judge" id "$real")" || exit 1
  [[ $got == "$id" ]] || refuse 1 "manifest-id=$got path=$real"
  printf '%s\n' "$real"
}

plugin_add() { # URL
  local url="$1" verdict id target owners landed
  mkdir -p -- "$user_plugins"
  # Staged beside the plugin directory, never inside it, so no scan sees a
  # half-cloned plugin and the final move is a rename on one filesystem.
  stage="$(mktemp -d "$config_home/vgs/.vgsh-add.XXXXXX")" || refuse 1 "staging=$config_home/vgs"
  trap 'rm -rf -- "${stage:?}"' EXIT
  git_or_refuse "clone=$url" clone --quiet --no-recurse-submodules -- "$url" "$stage/plugin"
  verdict="$(node "$manifest_check" -- "$stage/plugin")" || refuse 1 "manifest=$url" "$verdict"
  id="$(node "$judge" id "$stage/plugin")" || exit 1
  owners="$(owners_of "$id")" || exit 1
  [[ -z $owners ]] || refuse 1 "id-owned=$id owner=${owners%%$'\n'*}"
  target="$user_plugins/$id"
  [[ -e $target || -L $target ]] && refuse 1 "exists=$target"
  # Before the move, so the first scan that sees the plugin sees it disabled.
  landed="$(node "$judge" land-disabled "$root/config/shell.json" "$config_home/vgs/shell.json" "$stage/plugin")" || exit 1
  mv -T -- "$stage/plugin" "$target" || refuse 1 "move=$target"
  echo "ok added=$id path=$target config=$landed"
  rescan_if_running
}

rollback() { # DIR COMMIT
  git_or_refuse "rollback=failed path=$1 to=$2" -C "$1" reset --quiet --hard "$2"
}

plugin_update() { # ID
  local id="$1" dir top dirty old upstream err verdict new_id rc=0
  dir="$(installed_dir "$id")" || exit $?
  top="$(git_plain -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || refuse 1 "not-a-checkout=$dir"
  [[ $top == "$dir" ]] || refuse 1 "not-a-checkout=$dir toplevel=$top"
  dirty="$(git_or_refuse "git=status path=$dir" -C "$dir" status --porcelain --untracked-files=all)" || exit 1
  [[ -z $dirty ]] || refuse 1 "modified=$dir" "commit or discard the local changes first"
  git_or_refuse "fetch=$id" -C "$dir" fetch --quiet --no-recurse-submodules
  upstream="$(git_plain -C "$dir" rev-parse --verify --quiet '@{upstream}' 2>/dev/null)" || refuse 1 "upstream=missing path=$dir"
  old="$(git_or_refuse "git=rev-parse path=$dir" -C "$dir" rev-parse --verify HEAD)" || exit 1
  if [[ $old == "$upstream" ]]; then
    echo "ok up-to-date=$id"
    return 0
  fi
  err="$(git_plain -C "$dir" merge-base --is-ancestor "$old" "$upstream" 2>&1)" || rc=$?
  case "$rc" in
    0) ;;
    1) refuse 1 "not-fast-forward=$id" "the source rewrote its history; remove and add the plugin again" ;;
    *) refuse 1 "git=merge-base exit=$rc path=$dir" "$err" ;;
  esac
  git_or_refuse "git=diff path=$dir" -C "$dir" diff --no-ext-diff --no-textconv "$old" "$upstream"
  git_or_refuse "git=merge path=$dir" -C "$dir" merge --quiet --ff-only "$upstream"
  # A refused new version is undone before the refusal, so the installed
  # plugin is always one the judge accepted.
  if ! verdict="$(node "$manifest_check" -- "$dir")"; then
    rollback "$dir" "$old"
    refuse 1 "manifest=$id rolled-back=${old:0:12}" "$verdict"
  fi
  if ! new_id="$(node "$judge" id "$dir")" || [[ $new_id != "$id" ]]; then
    rollback "$dir" "$old"
    refuse 1 "manifest-id=${new_id:-unreadable} want=$id rolled-back=${old:0:12}"
  fi
  echo "ok updated=$id from=${old:0:12} to=${upstream:0:12}"
  rescan_if_running
}

plugin_remove() { # ID
  local id="$1" dir
  dir="$(installed_dir "$id")" || exit $?
  rm -rf -- "${dir:?}" || refuse 1 "remove=$dir"
  echo "ok removed=$id"
  rescan_if_running
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  run)
    if [[ $# -gt 0 ]]; then
      printf 'vgsh: refused: argument=%s\nrun takes no arguments; the shell runs in the foreground under the runner\n' "$1" >&2
      exit 2
    fi
    mkdir -p -- "$config_home/vgs"
    # Opened for append so a runner that loses the race never truncates the
    # holder's pid; only the holder rewrites the file.
    exec 9>>"$lock"
    if ! flock -n 9; then
      printf 'vgsh: refused: lock=%s\nanother vgsh run holds the instance lock; one shell per session\n' "$lock" >&2
      exit 75
    fi
    truncate -s 0 -- "$lock"
    printf '%s\n' "$$" >&9
    # exec keeps this pid and the lock descriptor, so the shell can prove it
    # is the lock holder by comparing VGSH_RUNNER_PID with its own pid.
    VGSH_RUNNER_PID=$$ exec qs -p "$shell_dir"
    ;;
  ipc)
    pid="$(shell_pid)" || exit $?
    exec qs ipc --pid "$pid" "$@"
    ;;
  log)
    pid="$(shell_pid)" || exit $?
    exec qs log --pid "$pid" "$@"
    ;;
  plugin)
    sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$sub" in
      list)
        # Captured first so the not-running exit code is the command's, not
        # the formatter's.
        reply="$(ipc shell listPlugins)" || exit $?
        python3 - "$reply" <<'PY'
import json, sys
data = json.loads(sys.argv[1])
for p in data["plugins"]:
    state = "enabled" if p["enabled"] else "disabled"
    print(f"{p['id']:<28} {p['version']:<8} {state:<9} kinds={','.join(p['kinds'])}")
for e in data["errors"]:
    print(f"error   {e['dir']}: {e['error']}")
for c in data["collisions"]:
    print(f"hidden  {c}")
if data.get("scanError"):
    print(f"scan-error {data['scanError']}")
PY
        ;;
      enable|disable)
        id="${1:-}"
        if [[ -z $id ]]; then printf 'vgsh: refused: id=missing\n' >&2; usage; exit 2; fi
        enabled=true; [[ $sub == disable ]] && enabled=false
        reply="$(ipc shell setPluginEnabled "$id" "$enabled")" || exit $?
        case "$reply" in
          ok) echo ok ;;
          "ok hidden="*) echo "$reply"; echo "those bar widgets stay enabled and return when a bar is enabled" ;;
          *) printf 'vgsh: refused: %s\n' "$reply" >&2; exit 1 ;;
        esac
        ;;
      add)
        url="${1:-}"
        if [[ -z $url ]]; then printf 'vgsh: refused: url=missing\n' >&2; usage; exit 2; fi
        plugin_add "$url"
        ;;
      update|remove)
        id="${1:-}"
        if [[ -z $id ]]; then printf 'vgsh: refused: id=missing\n' >&2; usage; exit 2; fi
        "plugin_$sub" "$id"
        ;;
      validate)
        dir="${1:-}"
        if [[ -z $dir ]]; then printf 'vgsh: refused: dir=missing\n' >&2; usage; exit 2; fi
        exec node "$root/scripts/check-manifests.js" -- "$dir"
        ;;
      *)
        printf 'vgsh: refused: plugin-subcommand=%s\n' "${sub:-missing}" >&2; usage; exit 2
        ;;
    esac
    ;;
  -h|--help|help)
    usage; exit 0
    ;;
  *)
    printf 'vgsh: refused: command=%s\n' "${cmd:-missing}" >&2; usage; exit 2
    ;;
esac
