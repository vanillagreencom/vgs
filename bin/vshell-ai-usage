#!/usr/bin/env bash
# vshell-ai-usage — compact, span-free JSON of Claude Code / OpenAI Codex subscription
# usage, for the VGS "aiUsage" bar widget.
#
# Wraps the vendored claudebar/codexbar engines (which do the OAuth refresh and
# call the provider usage API) and re-emits a small JSON object the QML widget
# can parse without dealing with Pango markup.
#
# Multi-account: people run several subscriptions side by side by pointing
# CLAUDE_CONFIG_DIR (or CODEX_HOME) at different directories, one per wrapper
# script. Both providers are discovered the same way — any directory holding
# that provider's own login file — plus whatever `vshell ai-usage add-dir` was
# told to look in. Each supported profile becomes an account entry. Top-level
# fields describe the primary account.
#
# Providers configured with an API key rather than a CLI login (AI Gateway) are
# not this script's: they have nothing on disk to discover, and vshell_ai_usage.py
# fetches them.
#
# Usage: vshell-ai-usage [claude|codex]
#        vshell-ai-usage --dirs <claude|codex>   (which config directories it would read)
#
# Output (one line of JSON):
#   {"ok":true,"provider":"claude","plan":"Max 20x","class":"critical",
#    "session":{"pct":16,"reset":"3h 53m","resetAt":1785265401},
#    "weekly":{"pct":85,"reset":"5d 12h","resetAt":1785409199},
#    "third":{"label":"Fable","pct":89,"reset":"5d 12h"},
#    "accounts":[{"id":"claude","label":"you@example.com","plan":"Max 20x",
#                 "ok":true,"class":"high","session":{...},"weekly":{...},
#                 "models":[{"label":"Fable","pct":89,"reset":"5d 12h"}]}],
#    "aggregate":{"count":1,"session":16,"weekly":85,"class":"high"}}
# On failure:
#   {"ok":false,"provider":"codex","error":"..."}
set -euo pipefail

# Ensure the sibling engines (claudebar/codexbar) are found even when invoked
# from an environment without ~/.local/bin on PATH (e.g. the shell systemd unit).
SELF_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
case ":$PATH:" in
    *":$SELF_DIR:"*) : ;;
    *) PATH="$SELF_DIR:$PATH" ;;
esac
export PATH

# The shell (and anything it spawns) may itself be running under one account's
# wrapper, which would otherwise silently make every lookup report that account.
# Account selection here is always explicit via --config-dir.
unset CLAUDE_CONFIG_DIR CODEX_HOME

mode="usage"
if [[ "${1:-}" == "--dirs" ]]; then
    mode="dirs"
    shift
fi

provider="${1:-claude}"

case "$provider" in
    claude) engine=claudebar ;;
    codex)  engine=codexbar ;;
    *)
        jq -nc --arg p "$provider" '{ok:false,provider:$p,error:("unknown provider: "+$p)}'
        exit 0
        ;;
esac

if [[ "$mode" == "usage" ]] && ! command -v "$engine" >/dev/null 2>&1; then
    jq -nc --arg p "$provider" --arg e "$engine" '{ok:false,provider:$p,error:($e+" not found in PATH")}'
    exit 0
fi

# Directories the user told VGS to look in as well, written by
# `vshell ai-usage add-dir` for wrappers that point CLAUDE_CONFIG_DIR or
# CODEX_HOME somewhere no naming convention can guess.
SOURCES_FILE="$HOME/.local/state/vshell/ai-usage/sources.json"

# Read with jq, keeping "the file does not say" apart from "jq could not run".
# An empty answer is an ordinary outcome here — a profile with no address, a
# store with no extra directories — but jq exits above 1 for a broken program
# or unreadable input, and swallowing that would drop directories or blank
# every label with nothing anywhere saying why.
jq_read() {
    local out status
    out=$(jq -r "$@" 2>/dev/null)
    status=$?
    if (( status > 1 )); then
        printf 'vshell-ai-usage: jq exited %d; continuing without what it was asked for\n' "$status" >&2
        return "$status"
    fi
    # Terminate the answer: callers that read it line by line drop a final line
    # with no newline behind it, which silently loses the last directory. A
    # single-value caller's command substitution strips this again.
    printf '%s\n' "$out"
}

extra_dirs() {
    [[ -f "$SOURCES_FILE" ]] || return 0
    # shellcheck disable=SC2016  # $p is a jq variable bound by --arg, not a shell expansion
    jq_read --arg p "$provider" \
        '((.dirs[$p] // []) | .[] | select(type == "string") | select(. != ""))' \
        -- "$SOURCES_FILE" || return 0
}

# Both providers are found the same way: a directory holding this provider's
# own login file. Codex used to be looked for under two exact names while
# Claude took any ~/.*claude* directory, so a second Codex account in a
# directory whose name did not start with .codex- was simply never found.
candidate_dirs() {
    local xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
    case "$provider" in
        claude) printf '%s\n' "$HOME/.claude" "$HOME"/.*claude* "$xdg/claude" "$xdg"/claude-* ;;
        codex)  printf '%s\n' "$HOME/.codex"  "$HOME"/.*codex*  "$xdg/codex"  "$xdg"/codex-* ;;
    esac
}

# Whether this directory holds a login the engine can actually poll. Claude
# profiles whose tokens live in the desktop keyring instead (mcpOAuth only) are
# not pollable over this API and are left out rather than shown permanently
# broken; a Codex directory without an access token is the same case.
dir_usable() {
    local dir="$1"
    case "$provider" in
        claude)
            [[ -f "$dir/.credentials.json" ]] || return 1
            jq -e '.claudeAiOauth.accessToken // empty' -- "$dir/.credentials.json" >/dev/null 2>&1
            ;;
        codex)
            [[ -f "$dir/auth.json" ]] || return 1
            jq -e '.tokens.access_token // empty' -- "$dir/auth.json" >/dev/null 2>&1
            ;;
        *) return 1 ;;
    esac
}

# Every candidate that holds a usable login, deduplicated, discovery first.
discover() {
    local dir
    { candidate_dirs; extra_dirs; } | while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        dir="${dir%/}"
        [[ -d "$dir" ]] || continue
        dir_usable "$dir" || continue
        printf '%s\n' "$dir"
    done | awk '!seen[$0]++'
}

# The signed-in address for a directory, so two accounts on the same plan are
# told apart before either has been fetched. Claude keeps it in a profile file;
# Codex keeps it in the id_token, a JWT whose payload carries it.
jwt_field() {
    local token="$1" field="$2" payload decoded
    payload=$(cut -d. -f2 <<<"$token")
    [[ -n "$payload" && "$payload" != "$token" ]] || return 0
    payload="${payload//-/+}"
    payload="${payload//_//}"
    while (( ${#payload} % 4 != 0 )); do payload+="="; done
    decoded=$(base64 -d <<<"$payload" 2>/dev/null) || return 0
    # shellcheck disable=SC2016  # $f is a jq variable bound by --arg, not a shell expansion
    jq_read --arg f "$field" '.[$f] // empty' <<<"$decoded" || return 0
}

label_for() {
    local dir="$1" email="" token
    case "$provider" in
        claude)
            if [[ -f "$dir/.claude.json" ]]; then
                email=$(jq_read '.oauthAccount.emailAddress // empty' -- "$dir/.claude.json") || email=""
            fi
            # Only the default config dir falls back to the home-root profile. The
            # loop this replaced skipped that guard whenever the alt directory had
            # no profile file of its own -- exactly the case the guard is for -- so
            # every such directory was labelled with the DEFAULT account's address.
            if [[ -z "$email" && "$dir" == "$HOME/.claude" && -f "$HOME/.claude.json" ]]; then
                email=$(jq_read '.oauthAccount.emailAddress // empty' -- "$HOME/.claude.json") || email=""
            fi
            if [[ -z "$email" && -f "$dir/.auth-email-cache" ]]; then
                email=$(head -n1 -- "$dir/.auth-email-cache" 2>/dev/null) || email=""
            fi
            ;;
        codex)
            if [[ -f "$dir/auth.json" ]]; then
                token=$(jq_read '.tokens.id_token // empty' -- "$dir/auth.json") || token=""
                [[ -n "$token" ]] && email=$(jwt_field "$token" email)
            fi
            ;;
    esac
    printf '%s' "$email"
}

mapfile -t dirs < <(discover)

# --- Source reporting (the widget's provider setup page) ---------------------
# Answered from the same discovery the fetch uses, so the page cannot list a
# directory the fetch ignores, or miss one it reads.
if [[ "$mode" == "dirs" ]]; then
    dirs_json="[]"
    for dir in "${dirs[@]}"; do
        dirs_json=$(jq -c --argjson acc "$dirs_json" --arg path "$dir" --arg label "$(label_for "$dir")" \
            '$acc + [{path:$path, label:$label, managed:"discovered", usable:true}]' <<<'null')
    done
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        dir="${dir%/}"
        usable=false
        if [[ -d "$dir" ]] && dir_usable "$dir"; then
            usable=true
        fi
        # An extra directory discovery also found is reported once, as the
        # user's, so the row that can be removed is the one on screen.
        dirs_json=$(jq -c --argjson acc "$dirs_json" --arg path "$dir" \
            --arg label "$(label_for "$dir")" --argjson usable "$usable" \
            '($acc | map(select(.path != $path))) + [{path:$path, label:$label, managed:"extra", usable:$usable}]' <<<'null')
    done < <(extra_dirs)
    jq -nc --arg p "$provider" --argjson dirs "$dirs_json" '{ok:true, provider:$p, dirs:$dirs}'
    exit 0
fi

if ((${#dirs[@]} == 0)); then
    jq -nc --arg p "$provider" '{ok:false,provider:$p,error:"no signed-in accounts found"}'
    exit 0
fi

# --- Per-account collection --------------------------------------------------
# Sequential on purpose: each engine keeps its own short-lived cache and fetch
# lock per account, so walking them in turn spreads any real API calls out
# instead of firing every account at once.

accounts_json="[]"
for dir in "${dirs[@]}"; do
    id="$(basename "$dir")"
    id="${id#.}"
    raw="$("$engine" --config-dir "$dir" --emit-json 2>/dev/null || true)"
    if [[ -z "$raw" ]] || ! jq -e . >/dev/null 2>&1 <<<"$raw"; then
        raw='{"ok":false,"error":"no output from engine"}'
    fi

    label="$(label_for "$dir")"
    [[ -z "$label" ]] && label="$(jq -r '.email // empty' <<<"$raw" 2>/dev/null || true)"
    [[ -z "$label" ]] && label="$id"

    # An unreadable account must not abort collection for the other accounts.
    # Report its error on stderr and return an unavailable entry.
    normalized=""
    if ! normalized="$(jq -c \
        --argjson acc "$accounts_json" \
        --argjson entry "$raw" \
        --arg id "$id" \
        --arg label "$label" \
        --arg dir "$dir" \
        '
        # The widget renders plain text, so remove engine Pango markup here.
        # Strip tags before decoding entities to preserve escaped literal tags.
        # Decode &amp; last to avoid decoding the same text twice.
        # gsub with flags needs jq >= 1.5, the floor config/vshell/dependencies.json probes.
        def pango:
          if . == null then null
          else gsub("</?(b|i|u|s|tt|big|small|sub|sup|span|markup)([ \t\r\n][^>]*)?>"; ""; "i")
               | gsub("&lt;"; "<") | gsub("&gt;"; ">")
               | gsub("&quot;"; "\"")
               # Build the apostrophe from its code point because this jq program is
               # inside a single-quoted Bash argument.
               | gsub("&(apos|#0*39);"; ([39] | implode); "i")
               | gsub("&amp;"; "&")
          end;
        $acc + [{
            id: $id,
            label: $label,
            configDir: $dir,
            ok: ($entry.ok == true),
            # Flatten literal escape sequences so the widget does not display them raw.
            error: (($entry.error // null) | if . == null then null
                    else gsub("\\\\n"; " ") | gsub("\\\\t"; " ") | pango
                         | gsub("[[:space:]]+"; " ") | sub("^ +"; "") | sub(" +$"; "") end),
            plan: (($entry.plan // "") | pango),
            # Keep account type explicit so the UI can group spend-based accounts
            # without guessing from email domains.
            enterprise: (((($entry.plan // "") | ascii_downcase) | startswith("enterprise"))
                         or ($entry.spend != null)),
            class: ($entry.class // "low"),
            session: ($entry.session // null),
            weekly: ($entry.weekly // null),
            # Normalize model labels and spend details for the same plain-text widget.
            models: (($entry.models // [])
                     | map(if type == "object" and (.label | type) == "string"
                           then .label = (.label | pango) else . end)),
            spend: (($entry.spend // null)
                    | if type == "object" and (.detail | type) == "string"
                      then .detail = (.detail | pango) else . end)
        }]' <<<'null')"; then
        printf 'vshell-ai-usage: jq failed normalizing account %s (%s); reporting it as unavailable\n' \
            "$id" "$(jq --version 2>/dev/null || echo 'jq version unknown')" >&2
        normalized="$(jq -c \
            --argjson acc "$accounts_json" \
            --arg id "$id" \
            --arg label "$label" \
            --arg dir "$dir" \
            '$acc + [{id:$id, label:$label, configDir:$dir, ok:false,
                      error:"account payload could not be normalized"}]' <<<'null')"
    fi
    accounts_json="$normalized"
done

# --- Aggregate + backward-compatible top level -------------------------------
# The pill shows consumption against the whole pool, so each account counts for
# one 100% allowance and the aggregate is consumed/available across them — five
# accounts at 50% read as 50%, never 250%.

jq -nc \
    --arg provider "$provider" \
    --argjson accounts "$accounts_json" \
    '
    ($accounts | map(select(.ok))) as $live
    | ($live | map(select(.session != null))) as $sess
    | ($live | map(select(.weekly  != null))) as $week
    | (if ($sess | length) > 0 then (($sess | map(.session.pct) | add) / ($sess | length) | round) else null end) as $aggSession
    | (if ($week | length) > 0 then (($week | map(.weekly.pct)  | add) / ($week | length) | round) else null end) as $aggWeekly
    # Average the highest usage percentage per account across its reported
    # windows. Averaging each window separately can hide an exhausted account.
    | ($live | map([ (.session.pct // empty), (.weekly.pct // empty),
                     (.models[]?.pct // empty), (.spend.pct // empty) ]
                   | map(select(. != null)) | max // 0)) as $tightest
    | (if ($tightest | length) > 0
       then (($tightest | add) / ($tightest | length) | round) else 0 end) as $aggPct
    | ([ $aggSession, $aggWeekly,
         ($live | map(.models[]?.pct) | max),
         ($live | map(.spend?.pct // empty) | max) ] | map(select(. != null)) | max // 0) as $peak
    | (if   $peak >= 90 then "critical"
       elif $peak >= 75 then "high"
       elif $peak >= 50 then "mid"
       else "low" end) as $aggClass
    # Top-level fields describe the primary account for single-account consumers.
    | ($live[0] // $accounts[0]) as $primary
    | ($primary.models // []) as $pm
    | if ($live | length) == 0 then
        {ok:false, provider:$provider,
         error: ($accounts[0].error // "usage unavailable"),
         accounts:$accounts}
      else
        {ok:true, provider:$provider,
         plan: ($primary.plan // ""),
         class: $aggClass,
         session: $primary.session,
         weekly: $primary.weekly,
         third: (if ($pm | length) > 0
                 then ($pm | max_by(.pct) | {label:.label, pct:.pct, reset:.reset, resetAt:(.resetAt // 0)})
                 else null end),
         accounts: $accounts,
         aggregate: {count: ($live | length),
                     total: ($accounts | length),
                     pct: $aggPct,
                     session: $aggSession,
                     weekly: $aggWeekly,
                     class: $aggClass}}
      end
    '
