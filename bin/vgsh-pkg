#!/usr/bin/env node
// vgsh pkg: the system's package managers, read from the one table,
// shell/Core/PackageManagers.js, loaded here under node (D034).
//
//   vgsh-pkg detect [--json]
//       the primary manager and every overlay and source present, as
//       `primary=<id> binary=<command>` (`primary=none` when no row serves
//       the system), `overlay=<id> binary=<command>` and
//       `source=<id> binary=<command>` lines, or with --json one line
//       `{ primary, overlays, sources }`, each entry `{ id, binary }` and
//       primary null when none
//   vgsh-pkg present <command>...
//       one JSON line `{ present, missing }` naming each command found and
//       not found on PATH; exit 0 when none is missing, 1 when one is
//   vgsh-pkg plan install|remove|upgrade <manager> [names...]
//       one JSON line `{ manager, binary, action, elevate, steps }`: the
//       argv of each step the action takes, in order, and whether it needs
//       root. Runs nothing. install and remove take one name or more,
//       upgrade none.
//   vgsh-pkg check [--json] [--source <manager>]
//       counts the updates each detected manager offers, through the
//       unprivileged query its table row names, or manager <manager> alone.
//       With --json one line, an array of `{ source, count, packages,
//       checkedAt, error }`, each package `{ name, old, new }` (old null
//       where the manager prints no installed version); without it a
//       `source=<id> count=<n>` or `source=<id> error=<error>` line per
//       source, each package after it as `  <name> <old|?> -> <new>`.
//       A source that could not be read has count null, no packages and an
//       error: `exit=<n>` (a status its row does not list), `timeout=<s>`,
//       `signal=<name>`, `absent=<command>`, `spawn=<code>`, the parser's
//       `unparseable ...`, or `skipped=on-demand` (a query that runs only
//       when named by --source) and `skipped=no-check` (no read-only query
//       exists), where checkedAt is null too. Exit 0 once the result is
//       printed, whatever each source answered. A check stopped by SIGINT,
//       SIGTERM or SIGHUP prints nothing and exits 128 plus the signal's
//       number once every query has ended.
//   vgsh-pkg run install|remove|upgrade [--manager <id>] [names...]
//       run the plan for manager <id>, else the detected primary, in this
//       terminal: install and remove take one name or more, upgrade none.
//       Each step of a row whose `elevate` is true runs behind the
//       elevation command: shell.json's `packages.elevate` when set, else
//       the first of sudo, doas and run0 on PATH (the table's ELEVATORS).
//       The steps run from $HOME, as check's queries do, through
//       bin/lib/pkg-run.sh, whose header states the sudo session and how
//       each step is shown; the exit status is the
//       first failing step's, or 0. A run prints no Done or Failed:
//       `vgsh-tui present` owns the ending. Once the steps end, however
//       they end, it runs `vgsh plugin rescan`, whose `shell=` line follows
//       them, so a running shell reports the requirements the change
//       brought or took away; the exit status stays the steps'.
//   vgsh-pkg install|remove [--manager <id>] [names...]
//       with names, `run install|remove` with them. Without, fzf lists the
//       manager's packages, available for install and explicitly installed
//       for remove, with the table's preview of the one under the cursor,
//       and the names picked are run. Without --manager, install first asks
//       which manager to pick from when the primary and an overlay both
//       offer a picker, the AUR beside pacman; else it is the primary's.
//       Picking nothing exits 0 and runs nothing; leaving fzf with Esc or
//       Ctrl-C exits 130.
//   vgsh-pkg owner <path>
//       one JSON line `{ manager, package, version }`: the package the
//       primary manager's owner query names for the absolute file path, and
//       its installed upstream version from the manager's installed query,
//       null when the table holds none for the manager. Runs the two
//       read-only queries and changes nothing.
//
// A check holds flock on $XDG_RUNTIME_DIR/vgs/pkg-check.lock until it
// exits, so a second one waits for the first. Each query runs in its own
// process group, which gets SIGTERM and, KILL_GRACE_MS later, SIGKILL when
// the query passes its row's timeout or the check itself is stopped by a
// signal; a stopped check exits only after every group has ended, so it
// releases the lock with no query left running. The queries run at once,
// from $HOME with LC_ALL=C, so every format reads in English. checkupdates
// syncs its own copy of the databases unless VGS's last successful synced
// check is under FRESH_MS old and that copy still holds a database, when it
// runs with -n: a check right after a short upgrade does not download the
// databases again. $XDG_RUNTIME_DIR/vgs/pkg-check.synced records that
// sync's time.
//
// The system's identity is /etc/os-release, else /usr/lib/os-release, as
// os-release(5) orders them; with neither, no primary is detected. A
// command is found on PATH as bin/lib/judge-files.js's onPath finds it.
//
// Every refusal is one line on stderr, `vgsh: refused: <key>=<value>`,
// through bin/lib/judge-files.js. Exit 1 for a refusal: `manager=<id>
// reason=unknown`, `manager=<id> action=<action> reason=unsupported` (the
// table plans nothing for it), `manager=<id> reason=absent
// binaries=<list>`, `name=<json> reason=grammar`,
// `os-release=unreadable path=<file> error=<code>`, `runtime-dir=unset`
// and `lock=failed path=<file> error=<code>`, and for `owner`:
// `manager=none` (no primary serves the system), `manager=<id>
// query=owner reason=unsupported`, `path=<file> reason=unowned
// manager=<id> exit=<n>` (the query exited non-zero, as every manager does
// for a file no package owns), `package=<name> reason=not-installed
// manager=<id> exit=<n>`, `query=<argv0> reason=failed error=<code>` (the
// query did not run or outlived its timeout) and `manager=<id>
// query=owner|installed reason=unreadable` (its first line did not match
// the table's pattern); the query's own stderr follows the line. For `run`,
// `install` and `remove`, before anything else runs: `caller=shell
// verb=<verb>` when VGSH_RUNNER_PID is set, the variable `vgsh run` exports
// to the shell and so to every process the shell starts, apart from the
// programs it opens for the user (shell.run.detached and a floating TUI's
// terminal), and `<verb>=no-terminal` when /dev/tty does not open; then
// `manager=none` without --manager where no primary is detected,
// `elevate=<command> reason=absent source=packages.elevate`, `elevate=none
// candidates=sudo,doas,run0`, `shipped-config=` and `user-config=` with
// `unreadable`, `unparseable` or `malformed` for a shell.json layer
// bin/lib/judge-files.js's readConfig refuses, `runner=failed
// error=<code>`, and for a picker `manager=<id> picker=<action>
// reason=unsupported`, `picker=fzf reason=absent`, `picker=fzf
// reason=failed exit=<n>|error=<code>` and `query=<argv0> reason=failed
// exit=<n>|error=<code>` for a list query, its stderr after the line. Exit 2
// for a bad
// invocation, a command that is not a bare file name among them:
// `command=<json>`. `present` alone also exits 1 with no refusal line, for
// a missing command.
"use strict";
const childProcess = require("child_process");
const fs = require("fs");
const os = require("os");
const path = require("path");

const repo = path.join(__dirname, "..");
const table = require(path.join(__dirname, "lib", "qml-library.js")).load(path.join(repo, "shell", "Core", "PackageManagers.js"));
const { Refusal, refuse, main, onPath, readConfig, refuseOutsideTerminal, shellWord } = require(path.join(__dirname, "lib", "judge-files.js"));

const OS_RELEASE = ["/etc/os-release", "/usr/lib/os-release"];
const RUNNER = path.join(__dirname, "lib", "pkg-run.sh");
const SHIPPED_CONFIG = path.join(repo, "config", "shell.json");
// A picker's list and fzf's answer: a system's whole repository fits.
const LIST_BUFFER = 256 * 1024 * 1024;
const HEX_COLOUR = /^#[0-9a-fA-F]{6}$/;
const KILL_GRACE_MS = 5000;
const FRESH_MS = 10 * 60 * 1000;
// The seconds one owner or installed query may take: a package database
// query reads local files.
const QUERY_TIMEOUT = 30;

function usage(first) {
    process.stderr.write("vgsh: refused: " + first + "\nusage: vgsh pkg detect [--json] | present <command>... | plan install|remove|upgrade <manager> [names...] | run install|remove|upgrade [--manager <id>] [names...] | install|remove [--manager <id>] [names...] | check [--json] [--source <manager>] | owner <path>\n");
    process.exit(2);
}

// The first os-release file's text, or "" when neither exists.
function osRelease() {
    for (const file of OS_RELEASE) {
        try {
            return fs.readFileSync(file, "utf8");
        } catch (e) {
            if (e.code !== "ENOENT") refuse("os-release=unreadable path=" + file + " error=" + e.code);
        }
    }
    return "";
}

// Take the check lock on a descriptor this process keeps open: flock(1)
// locks the open file it inherits, and the lock stays while this process
// holds that file, so it outlives the flock process. The queries do not
// inherit the descriptor, since node opens every file close-on-exec.
function holdCheckLock(dir) {
    const file = path.join(dir, "pkg-check.lock");
    let fd;
    try {
        fs.mkdirSync(dir, { recursive: true });
        fd = fs.openSync(file, "a");
    } catch (e) {
        refuse("lock=failed path=" + file + " error=" + e.code);
    }
    const r = childProcess.spawnSync("flock", ["3"], { stdio: ["ignore", "ignore", "ignore", fd] });
    if (r.error !== undefined) refuse("lock=failed path=" + file + " error=" + r.error.code);
    if (r.status !== 0) refuse("lock=failed path=" + file + " error=exit-" + r.status);
}

// Whether checkupdates may skip its sync: VGS synced its copy of the
// databases within FRESH_MS, and that copy, where checkupdates keeps it,
// still holds a database. Without one, `-n` would compare against nothing
// and report no updates.
function pacmanFresh(stamp) {
    try {
        if (Date.now() - fs.statSync(stamp).mtimeMs > FRESH_MS) return false;
    } catch (e) {
        if (e.code === "ENOENT") return false;
        throw e;
    }
    const db = process.env.CHECKUPDATES_DB || path.join(process.env.TMPDIR || "/tmp", "checkup-db-" + process.getuid());
    try {
        return fs.readdirSync(path.join(db, "sync")).some(name => name.endsWith(".db"));
    } catch (e) {
        if (e.code === "ENOENT" || e.code === "ENOTDIR") return false;
        throw e;
    }
}

// Every running query's process group: its leader's pid mapped to the
// function that signals the whole group.
const liveGroups = new Map();
// The exit status of a check a signal stopped, or null while none has.
let stopStatus = null;

// End every running query group, as a timeout does, then exit with 128
// plus SIGNAL's number once the last one has closed. A second signal while
// stopping changes nothing.
function stopQueries(signal) {
    if (stopStatus !== null) return;
    stopStatus = 128 + os.constants.signals[signal];
    if (liveGroups.size === 0) process.exit(stopStatus);
    for (const signalGroup of liveGroups.values()) signalGroup("SIGTERM");
    setTimeout(() => {
        for (const signalGroup of liveGroups.values()) signalGroup("SIGKILL");
    }, KILL_GRACE_MS).unref();
}

// Run CHECK's argv and resolve to what it printed means: `{ packages }` or
// `{ error }`, judged by the table's checkOutcome.
function runCheck(check) {
    return new Promise(resolve => {
        if (!onPath(check.argv[0])) {
            resolve({ error: "absent=" + check.argv[0] });
            return;
        }
        const child = childProcess.spawn(check.argv[0], check.argv.slice(1), {
            cwd: process.env.HOME || "/",
            env: Object.assign({}, process.env, { LC_ALL: "C" }),
            stdio: ["ignore", "pipe", "ignore"],
            detached: true
        });
        const chunks = [];
        let timedOut = false;
        let failed = null;
        const signalGroup = signal => {
            try {
                process.kill(-child.pid, signal);
            } catch (e) {
                if (e.code !== "ESRCH") throw e;
            }
        };
        let grace = null;
        const timer = setTimeout(() => {
            timedOut = true;
            signalGroup("SIGTERM");
            grace = setTimeout(() => signalGroup("SIGKILL"), KILL_GRACE_MS);
        }, check.timeout * 1000);
        if (child.pid !== undefined) liveGroups.set(child.pid, signalGroup);
        child.stdout.on("data", chunk => chunks.push(chunk));
        child.on("error", e => { failed = e.code; });
        child.on("close", (status, signal) => {
            clearTimeout(timer);
            if (grace !== null) clearTimeout(grace);
            liveGroups.delete(child.pid);
            if (stopStatus !== null) {
                if (liveGroups.size === 0) process.exit(stopStatus);
                return;
            }
            if (timedOut) resolve({ error: "timeout=" + check.timeout });
            else if (failed !== null) resolve({ error: "spawn=" + failed });
            else if (signal !== null) resolve({ error: "signal=" + signal });
            else resolve(table.checkOutcome(check, status, Buffer.concat(chunks).toString("utf8")));
        });
    });
}

// One source's result row.
async function checkSource(entry, named, stamp) {
    const row = (count, packages, checkedAt, error) => ({ source: entry.id, count, packages, checkedAt, error });
    const found = table.checkFor(entry.id, entry.binary, named);
    if (found.skipped !== undefined) return row(null, [], null, "skipped=" + found.skipped);
    const check = found.check;
    const syncs = entry.id === "pacman" && !pacmanFresh(stamp);
    if (entry.id === "pacman" && !syncs) check.argv.push("-n");
    const outcome = await runCheck(check);
    const checkedAt = new Date().toISOString();
    if (outcome.error !== undefined) return row(null, [], checkedAt, outcome.error);
    if (syncs) fs.writeFileSync(stamp, checkedAt + "\n");
    return row(outcome.packages.length, outcome.packages, checkedAt, null);
}

// Run manager ID's QUERY over VALUE and read its answer. A query that exits
// non-zero refuses with UNANSWERED, the keyed line its caller names.
function query(id, name, value, unanswered) {
    const q = table.queryArgv(id, name, value, onPath);
    if (!q.ok) refuse(q.error);
    const run = childProcess.spawnSync(q.argv[0], q.argv.slice(1), { encoding: "utf8", timeout: QUERY_TIMEOUT * 1000, stdio: ["ignore", "pipe", "pipe"], env: Object.assign({}, process.env, { LC_ALL: "C" }) });
    if (run.error !== undefined) refuse("query=" + q.argv[0] + " reason=failed error=" + run.error.code);
    if (run.status !== 0) refuse(unanswered + " manager=" + id + " exit=" + (run.status === null ? run.signal : run.status), undefined, 1, run.stderr);
    const answer = table.queryAnswer(id, name, run.stdout);
    if (answer === null) refuse("manager=" + id + " query=" + name + " reason=unreadable", undefined, 1, run.stdout);
    return answer;
}

// The detected primary's id; refuses `manager=none` when no row serves the
// system.
function primaryId() {
    const found = table.detect(table.osReleaseIds(osRelease()), onPath);
    if (found.primary === null) refuse("manager=none");
    return found.primary.id;
}

// `[--manager <id>] [names...]` for run, install and remove.
function managerAndNames(rest) {
    if (rest[0] !== "--manager") return { manager: null, names: rest };
    if (rest.length < 2) usage("option=--manager value=missing");
    return { manager: rest[1], names: rest.slice(2) };
}

const SHELL_CALLER = "the shell never changes a package; run this in a terminal or open core/pkg-install";

// The effective shell.json's `packages.elevate`, or undefined: the shipped
// layer merged with the user's as the shell merges them, each judged by
// PluginLogic.configError, which accepts only one of the table's ELEVATORS.
function configuredElevator() {
    const logic = require(path.join(__dirname, "lib", "qml-library.js")).load(path.join(repo, "shell", "Core", "PluginLogic.js"));
    const configHome = process.env.XDG_CONFIG_HOME || path.join(process.env.HOME || os.homedir(), ".config");
    const shipped = readConfig(logic, SHIPPED_CONFIG, "shipped-config");
    const user = readConfig(logic, path.join(configHome, "vgs", "shell.json"), "user-config", true);
    const packages = logic.effectiveConfig(shipped, user).packages;
    return packages === undefined ? undefined : packages.elevate;
}

// Run ACTION's plan for MANAGER over NAMES through bin/lib/pkg-run.sh, and
// exit with its status. The steps travel as argv, each led by its length,
// so no shell reads them, and run from $HOME, as a check's queries do, so
// no project's configuration in the caller's directory (a mise.toml) makes
// a step do other than what the check counted.
function run(action, manager, names) {
    const r = table.plan(manager, action, names, onPath);
    if (!r.ok) refuse(r.error);
    let command = "none";
    if (r.plan.elevate) {
        const chosen = table.elevator(configuredElevator(), onPath);
        if (!chosen.ok) refuse(chosen.error);
        command = chosen.command;
    }
    const argv = [RUNNER, command];
    for (const step of r.plan.steps) argv.push(String(step.length), ...step);
    return new Promise((resolve, reject) => {
        const child = childProcess.spawn("bash", argv, { stdio: "inherit", cwd: process.env.HOME || "/" });
        // The terminal sends Ctrl-C and a hangup to its whole foreground
        // group, the runner included, which ends its step and its sudo
        // session; this process outlives them to exit with the runner's
        // status. A SIGTERM sent to this process alone is passed on.
        process.on("SIGINT", () => {});
        process.on("SIGHUP", () => {});
        process.on("SIGTERM", () => child.kill("SIGTERM"));
        child.on("error", e => reject(new Refusal("runner=failed error=" + e.code)));
        child.on("close", (status, signal) => {
            rescanShell();
            process.exit(status !== null ? status : 128 + os.constants.signals[signal]);
        });
    });
}

// Once a run's steps have ended, however they ended, a running shell scans
// the plugin directories again, so each requirement a package change
// brought or took away is reported by its new state: `vgsh plugin rescan`,
// whose line follows the steps. The run's exit status stays the steps'; a
// rescan that could not start prints its refusal and changes nothing else.
function rescanShell() {
    const r = childProcess.spawnSync(path.join(__dirname, "vgsh"), ["plugin", "rescan"], { stdio: ["ignore", "inherit", "inherit"] });
    if (r.error !== undefined) process.stderr.write("vgsh: refused: rescan=failed error=" + r.error.code + "\n");
}

// fzf runs a preview as a shell command string, `$SHELL -c`, so ARGV, the
// table's preview, becomes one: every word single-quoted, and "{name}"
// replaced by fzf's own placeholder {1}, which fzf fills with the first
// field of the line under the cursor, quoted. The table's preview words
// hold no brace (scripts/test-vgsh-pkg-table.js), so fzf finds no other
// placeholder, and fzf runs with SHELL=/bin/sh, so the quoting is POSIX's
// whatever the user's login shell.
function previewCommand(argv) {
    return argv.map(word => word === "{name}" ? "{1}" : shellWord(word)).join(" ");
}

// A gum.env colour `vgsh-tui present` exported, or FALLBACK, one of fzf's
// ANSI colour names, outside the presentation or for a value that is not
// #rrggbb.
function colour(variable, fallback) {
    const value = process.env[variable];
    return value !== undefined && HEX_COLOUR.test(value) ? value : fallback;
}

// The lines LINES the user picks in fzf with ARGS: `{ picked }`, empty when
// the user accepted no line, or `{ cancelled: true }` for Esc or Ctrl-C,
// fzf's 130. fzf draws on /dev/tty and reads the list on stdin.
function fzf(args, lines) {
    const r = childProcess.spawnSync("fzf", args, {
        input: lines.map(line => line + "\n").join(""),
        stdio: ["pipe", "pipe", "inherit"],
        encoding: "utf8",
        maxBuffer: LIST_BUFFER,
        env: Object.assign({}, process.env, { SHELL: "/bin/sh" })
    });
    if (r.error !== undefined) refuse("picker=fzf reason=failed error=" + r.error.code);
    if (r.status === 130) return { cancelled: true };
    if (r.status === 1) return { picked: [] };
    if (r.status !== 0) refuse("picker=fzf reason=failed exit=" + (r.status === null ? r.signal : r.status));
    return { picked: r.stdout.split("\n").filter(line => line !== "") };
}

// The package names a picker's LIST query prints: the first field of each
// line, blank lines dropped and each name once, in the query's order.
function listed(list) {
    const r = childProcess.spawnSync(list[0], list.slice(1), { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], maxBuffer: LIST_BUFFER });
    if (r.error !== undefined) refuse("query=" + list[0] + " reason=failed error=" + r.error.code);
    if (r.status !== 0) refuse("query=" + list[0] + " reason=failed exit=" + (r.status === null ? r.signal : r.status), undefined, 1, r.stderr);
    const names = new Set();
    for (const line of r.stdout.split("\n")) {
        const first = line.trim().split(/\s+/)[0];
        if (first !== "") names.add(first);
    }
    return Array.from(names);
}

// The manager whose picker ACTION opens when none is named, answered as
// fzf answers: the detected primary and each overlay whose row offers one,
// asked in fzf when more than one does.
function pickerManager(action) {
    const found = table.detect(table.osReleaseIds(osRelease()), onPath);
    if (found.primary === null) refuse("manager=none");
    const offered = [found.primary].concat(found.overlays).map(entry => entry.id).filter(id => table.managerRow(id).picker[action] !== null);
    if (offered.length === 0) refuse("manager=" + found.primary.id + " picker=" + action + " reason=unsupported");
    if (offered.length === 1) return { picked: offered };
    const tone = colour("VGS_TUI_ACCENT", "yellow");
    return fzf(["--prompt=" + (action === "install" ? "Install from" : "Remove from") + "> ", "--color=pointer:" + tone], offered);
}

// Omarchy's picker, omarchy-pkg-install and omarchy-pkg-remove: several
// names, the preview under the list, and its keys, in the theme's success
// colour for an install and its danger colour for a removal.
function pick(action, manager) {
    const spec = table.pickerFor(manager, action, onPath);
    if (!spec.ok) refuse(spec.error);
    const tone = action === "install" ? colour("VGS_TUI_SUCCESS", "green") : colour("VGS_TUI_DANGER", "red");
    return fzf([
        "--multi",
        "--preview=" + previewCommand(spec.preview),
        "--preview-label=alt-p: toggle description, alt-j/k: scroll, tab: multi-select",
        "--preview-label-pos=bottom",
        "--preview-window=down:65%:wrap",
        "--bind=alt-p:toggle-preview",
        "--bind=alt-d:preview-half-page-down,alt-u:preview-half-page-up",
        "--bind=alt-k:preview-up,alt-j:preview-down",
        "--color=pointer:" + tone + ",marker:" + tone
    ], listed(spec.list));
}

const [verb, ...args] = process.argv.slice(2);
main(() => {
    switch (verb) {
    case "detect": {
        const json = args[0] === "--json";
        if (args.length > (json ? 1 : 0)) usage("argument=" + args[json ? 1 : 0]);
        const found = table.detect(table.osReleaseIds(osRelease()), onPath);
        if (json) {
            process.stdout.write(JSON.stringify(found) + "\n");
            break;
        }
        const lines = [found.primary === null ? "primary=none" : "primary=" + found.primary.id + " binary=" + found.primary.binary];
        for (const entry of found.overlays) lines.push("overlay=" + entry.id + " binary=" + entry.binary);
        for (const entry of found.sources) lines.push("source=" + entry.id + " binary=" + entry.binary);
        process.stdout.write(lines.join("\n") + "\n");
        break;
    }
    case "present": {
        if (args.length === 0) usage("command=missing");
        for (const command of args)
            if (!table.validCommand(command)) usage("command=" + JSON.stringify(command));
        const present = args.filter(onPath);
        const missing = args.filter(command => !present.includes(command));
        process.stdout.write(JSON.stringify({ present, missing }) + "\n");
        process.exitCode = missing.length === 0 ? 0 : 1;
        break;
    }
    case "plan": {
        const [action, manager, ...names] = args;
        if (!table.ACTIONS.includes(action)) usage("action=" + (action === undefined ? "missing" : action));
        if (manager === undefined) usage("manager=missing");
        if (action === "upgrade" && names.length > 0) usage("argument=" + names[0]);
        if (action !== "upgrade" && names.length === 0) usage("names=missing");
        const r = table.plan(manager, action, names, onPath);
        if (!r.ok) refuse(r.error);
        process.stdout.write(JSON.stringify(r.plan) + "\n");
        break;
    }
    case "run": {
        const [action, ...rest] = args;
        if (!table.ACTIONS.includes(action)) usage("action=" + (action === undefined ? "missing" : action));
        const { manager, names } = managerAndNames(rest);
        if (action === "upgrade" && names.length > 0) usage("argument=" + names[0]);
        if (action !== "upgrade" && names.length === 0) usage("names=missing");
        refuseOutsideTerminal(verb, SHELL_CALLER);
        return run(action, manager === null ? primaryId() : manager, names);
    }
    case "install":
    case "remove": {
        const { manager, names } = managerAndNames(args);
        refuseOutsideTerminal(verb, SHELL_CALLER);
        if (names.length > 0) return run(verb, manager === null ? primaryId() : manager, names);
        if (!onPath("fzf")) refuse("picker=fzf reason=absent");
        let chosen = manager;
        if (chosen === null) {
            const source = pickerManager(verb);
            if (source.cancelled) process.exit(130);
            if (source.picked.length === 0) break;
            chosen = source.picked[0];
        }
        const answer = pick(verb, chosen);
        if (answer.cancelled) process.exit(130);
        if (answer.picked.length === 0) break;
        return run(verb, chosen, answer.picked);
    }
    case "check": {
        let json = false;
        let source = null;
        for (let i = 0; i < args.length; i++) {
            if (args[i] === "--json" && !json) json = true;
            else if (args[i] === "--source" && source === null && i + 1 < args.length) source = args[++i];
            else usage("argument=" + args[i]);
        }
        let entries;
        if (source !== null) {
            const found = table.presentManager(source, onPath);
            if (!found.ok) refuse(found.error);
            entries = [{ id: source, binary: found.binary }];
        } else {
            const found = table.detect(table.osReleaseIds(osRelease()), onPath);
            entries = (found.primary === null ? [] : [found.primary]).concat(found.overlays, found.sources);
        }
        if (!process.env.XDG_RUNTIME_DIR) refuse("runtime-dir=unset");
        const dir = path.join(process.env.XDG_RUNTIME_DIR, "vgs");
        holdCheckLock(dir);
        for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(signal, () => stopQueries(signal));
        const stamp = path.join(dir, "pkg-check.synced");
        Promise.all(entries.map(entry => checkSource(entry, source !== null, stamp))).then(rows => {
            if (json) {
                process.stdout.write(JSON.stringify(rows) + "\n");
                return;
            }
            const lines = [];
            for (const r of rows) {
                lines.push("source=" + r.source + (r.error === null ? " count=" + r.count : " error=" + r.error));
                for (const p of r.packages) lines.push("  " + p.name + " " + (p.old === null ? "?" : p.old) + " -> " + p.new);
            }
            if (lines.length > 0) process.stdout.write(lines.join("\n") + "\n");
        });
        break;
    }
    case "owner": {
        if (args.length === 0) usage("path=missing");
        if (args.length > 1) usage("argument=" + args[1]);
        const found = table.detect(table.osReleaseIds(osRelease()), onPath);
        if (found.primary === null) refuse("manager=none");
        const id = found.primary.id;
        const pkg = query(id, "owner", args[0], "path=" + args[0] + " reason=unowned");
        const version = table.managerRow(id).installed === null ? null : query(id, "installed", pkg, "package=" + pkg + " reason=not-installed");
        process.stdout.write(JSON.stringify({ manager: id, package: pkg, version }) + "\n");
        break;
    }
    default:
        usage("pkg-subcommand=" + (verb === undefined ? "missing" : verb));
    }
});
