#!/usr/bin/env python3
"""Entry point for the VanillaGreen Shell runtime helper; the code is bin/vshell_helper.py.

CPython compiles the script it runs on every call and caches bytecode only for
the modules that script imports, so the helper body is a module and this stub
stays small.
"""
import sys
from pathlib import Path

_HELPER_MODULE_DIR = str(Path(__file__).resolve().parent)
if _HELPER_MODULE_DIR not in sys.path:
    sys.path.insert(0, _HELPER_MODULE_DIR)

import vshell_helper

raise SystemExit(vshell_helper.main())
