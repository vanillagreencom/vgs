#!/usr/bin/env node
// The decisions `vgsh theme list`, `apply` and `reload` need, made by the
// shell's own theme judge, shell/Commons/ThemeLogic.js, loaded here under
// node with the token table, shell/Commons/Tokens.js.
//
//   vgsh-theme-judge packages [DIR]
//       judge every package directly under DIR (default: the shipped
//       themes/) as shipped, then render every target under DIR/targets
//       against DIR's `vgs` package; one line per package and per target.
//       Exit 0 when every package and target is accepted, 1 when any is
//       refused, 2 when DIR, a package or target directory or a required
//       file cannot be read, or when targets exist and DIR holds no
//       accepted `vgs` package with terminal slots.
//   vgsh-theme-judge catalog-check [DIR]
//       judge DIR/catalog (DIR default: the shipped themes/): its index.json
//       and every package it names as the installed package it becomes,
//       whose index mode and palette must be its own, with no curated file
//       on a target under DIR/targets whose files run code, none no target
//       writes, none apply would not take, and no symlink. One line per
//       entry. Exit 0 when the index and every entry are accepted, 1 when
//       any is refused, 2 when the index or a file cannot be read.
//   vgsh-theme-judge list <text|json> <config-dir> <state-dir>
//       every shipped package and every package under <config-dir>/themes,
//       and the state of <config-dir>/theme.json, `modified` read against
//       the apply <state-dir>/applied.json records.
//   vgsh-theme-judge apply <text|json> <config-dir> <state-dir> <held|busy|failed> <name>
//       apply one package and every enabled shipped target; the fourth
//       argument is the caller's verdict on the flock of
//       <config-dir>/theme.lock, which it holds for as long as this process
//       runs when the verdict is `held`. <config-dir> is the vgs directory
//       of the configuration home, whose parent a target's wiring file is
//       relative to unless its wiring names a profiles.ini. Each target
//       whose reload is due runs its hook last.
//   vgsh-theme-judge follow <text|json> <config-dir> <state-dir> <held|busy|failed> [<name>]
//       apply again the package <state-dir>/applied.json records when its
//       content changed and the theme file still holds the bytes that
//       apply wrote, under the same lock verdict; with NAME, only when the
//       record names that package.
//   vgsh-theme-judge reload <text|json> <config-dir> <state-dir> <held|busy|failed>
//       run the hook of every target <state-dir>/reload-pending.json lists
//       again, under the same lock verdict.
//   vgsh-theme-judge background <text|json> <next|previous> <config-dir> <state-dir> <held|busy|failed>
//       make the next or the previous image of the applied package's
//       backgrounds/ the current background and remember it for that
//       package, under the same lock verdict; prints `ok background=<file>
//       theme=<name> path=<image>`, or under `json` the result
//       `{ state, background, theme, path, reason }`.
//   vgsh-theme-judge background <text|json> set <config-dir> <state-dir> <held|busy|failed> <path> [<output>]
//       make the image at PATH, in an accepted package's backgrounds/ or
//       the user folder <config-dir>/backgrounds, the current background,
//       or with OUTPUT that screen's own, under the same lock verdict;
//       prints `ok background=<file> theme=<name|-> path=<image>[
//       screen=<output>]`, or under `json` `{ state, background, theme,
//       path, screen, reason }`.
//   vgsh-theme-judge background <text|json> list <config-dir> <state-dir> <applied|all>
//       the applied package's images, or with `all` every accepted
//       package's and the user folder's; one `background=<file>
//       theme=<name|-> path=<image>` line each, or under `json`
//       `{ state, images: [{ background, theme, path }], reason }`.
//   vgsh-theme-judge accept <dir> [<name>]
//       judge the package in DIR as an installed package, for `vgsh theme
//       add` (no NAME: it lands under its document's own name) and `vgsh
//       theme update` (NAME: it must still be that package). Prints the
//       accepted name and exits 0; prints one verdict line on stdout,
//       `reason=<key>[ token=<path>][ <detail>]`, and exits 1 on a refusal.
//   vgsh-theme-judge installed <config-dir> <name>
//       print the directory of installed package NAME under
//       <config-dir>/themes, which `vgsh theme update` and `remove` act on.
//
// list, apply, follow, reload, background and installed refuse with one
// line on stderr, `vgsh: refused: <key>=...`, through
// bin/lib/judge-files.js: exit 1, or 75 for `reason=busy`. Under `json`,
// apply prints its structured result on stdout first, refusals included,
// and so do follow, reload and background. A partial apply, follow or
// reload prints one such line per failed or reload-pending target and
// exits 3. A
// malformed invocation exits 2.
// docs/architecture/themes.md § Runner and § Install, theme-apply.md,
// theme-targets.md, theme-backgrounds.md and theme-catalog.md hold the
// rules this file implements; the target renderer is
// bin/lib/theme-render.js, the background state bin/lib/theme-backgrounds.js,
// and the edit a target's `select` keeps in its application's settings file
// bin/lib/theme-select.js.
"use strict";
const crypto = require("crypto");
const fs = require("fs");
const os = require("os");
const path = require("path");

const repo = path.join(__dirname, "..");
const { load } = require(path.join(__dirname, "lib", "qml-library.js"));
const logic = load(path.join(repo, "shell", "Commons", "ThemeLogic.js"));
const tokens = load(path.join(repo, "shell", "Commons", "Tokens.js")).TOKENS;
const pluginLogic = load(path.join(repo, "shell", "Core", "PluginLogic.js"));
const { spawnSync } = require("child_process");
const { Refusal, refuse, main, readJson, readConfig, writing, replaceFile, editFile, onPath } = require(path.join(__dirname, "lib", "judge-files.js"));
const render = require(path.join(__dirname, "lib", "theme-render.js"));
const backgrounds = require(path.join(__dirname, "lib", "theme-backgrounds.js"));
const select = require(path.join(__dirname, "lib", "theme-select.js"));

const SHIPPED = path.join(repo, "themes");
const SHIPPED_CONFIG = path.join(repo, "config", "shell.json");
// The directory of a themes directory that holds targets, and the one that
// holds the catalog, with its index file. Neither is ever a package:
// ThemeLogic.RESERVED_DIRECTORIES names both.
const TARGETS = "targets";
const CATALOG = "catalog";
const CATALOG_INDEX = "index.json";
const FORMATS = ["text", "json"];
const LOCK_VERDICTS = ["held", "busy", "failed"];

function usage(first) {
    console.error("vgsh-theme-judge: refused: " + first);
    process.exit(2);
}

// The names of the directories directly under BASE, sorted; a symlink to
// a directory is one. Null when BASE is absent; any other failure throws
// the fs error.
function childDirs(base) {
    let entries;
    try {
        entries = fs.readdirSync(base, { withFileTypes: true });
    } catch (e) {
        if (e.code === "ENOENT") return null;
        throw e;
    }
    const isDir = entry => entry.isDirectory() ||
        (entry.isSymbolicLink() && fs.statSync(path.join(base, entry.name), { throwIfNoEntry: false })?.isDirectory() === true);
    return entries.filter(isDir).map(entry => entry.name).sort();
}

// The package directory names under BASE, as childDirs answers them, less
// the targets and the catalog directory.
function packageDirs(base) {
    const names = childDirs(base);
    return names === null ? null : names.filter(name => !logic.RESERVED_DIRECTORIES.includes(name));
}

// The bytes of FILE, or undefined when it is absent; any other failure
// throws the fs error.
function readIfPresent(file) {
    try {
        return fs.readFileSync(file);
    } catch (e) {
        if (e.code === "ENOENT") return undefined;
        throw e;
    }
}

// File RELATIVE, `/`-separated, of the package in PKG as the package
// contributes it: `{ state: "file", bytes }`, `{ state: "absent" }`, or
// `{ state: "linked" }` when it or a directory between it and PKG is a
// symlink, which is never followed. No package contributes a symlink below
// its own directory: D031. PKG itself may be one. Any other failure throws
// the fs error.
function packageFile(pkg, relative) {
    let at = pkg;
    for (const part of relative.split("/")) {
        at = path.join(at, part);
        const stat = fs.lstatSync(at, { throwIfNoEntry: false });
        if (stat === undefined) return { state: "absent" };
        if (stat.isSymbolicLink()) return { state: "linked" };
    }
    return { state: "file", bytes: fs.readFileSync(at) };
}

function text(bytes) {
    return bytes === undefined ? undefined : bytes.toString("utf8");
}

// BYTES as latin1 text, one character per byte, or undefined for undefined.
function latin1(bytes) {
    return bytes === undefined ? undefined : bytes.toString("latin1");
}

// A package's two files as bytes, absent ones undefined, and the judge's
// verdict on their text. `acceptPackage` is the only judge of a package.
// It judges the name before the document, so a package it refuses by name
// is refused, with `files` null, whether or not its files can be read: an
// unreadable installed `vgs` stays reserved. A package whose theme.json or
// terminal.json is a symlink is refused `symlink`, with `files` null. Any
// other read failure throws the fs error.
function readPackage(dir, shipped) {
    const judge = files => logic.acceptPackage(tokens, {
        directoryName: path.basename(dir),
        themeJson: text(files.theme),
        terminalJson: text(files.terminal),
        shipped: shipped
    });
    // `package-theme` is the judge reaching the document it was not given.
    const byName = () => judge({});
    let read;
    try {
        read = packageFiles(dir);
    } catch (e) {
        if (byName().reason === "package-theme") throw e;
        return { files: null, verdict: byName() };
    }
    if (read.linked !== null) {
        const verdict = byName();
        return { files: null, verdict: verdict.reason === "package-theme" ? logic.refusal("symlink", "", "file=" + read.linked) : verdict };
    }
    return { files: read.files, verdict: judge(read.files) };
}

// The package in DIR's theme.json and terminal.json as `{ files: { theme,
// terminal }, linked }`: each file's bytes, undefined when absent, and
// `linked`, the first of the two that is a symlink, or null. packageFile's
// fs failure throws.
function packageFiles(dir) {
    const read = { files: { theme: undefined, terminal: undefined }, linked: null };
    for (const [key, name] of [["theme", "theme.json"], ["terminal", "terminal.json"]]) {
        const file = packageFile(dir, name);
        if (file.state === "linked" && read.linked === null) read.linked = name;
        if (file.state === "file") read.files[key] = file.bytes;
    }
    return read;
}

// --- packages

function unreadable(where, cause) {
    console.log("vgsh-theme-judge: unreadable: " + where + ": " + cause);
    process.exit(2);
}

function checkPackages(dirArg) {
    const base = path.resolve(dirArg || SHIPPED);
    let names;
    try {
        names = packageDirs(base);
    } catch (e) {
        unreadable(base, e.code);
    }
    if (names === null) unreadable(base, "ENOENT");
    if (names.length === 0) unreadable(base, "no theme packages");
    let refused = 0;
    let defaults = null;
    for (const name of names) {
        const dir = path.join(base, name);
        let judged;
        try {
            judged = readPackage(dir, true);
        } catch (e) {
            unreadable(e.path || dir, e.code);
        }
        if (judged.files !== null && judged.files.theme === undefined) unreadable(path.join(dir, "theme.json"), "ENOENT");
        if (judged.verdict.ok) {
            if (judged.verdict.name === logic.DEFAULT_NAME) defaults = judged.verdict;
            console.log("ok       " + judged.verdict.name);
            continue;
        }
        console.log("refused  " + dir + ": " + logic.refusalLine(judged.verdict));
        refused += 1;
    }
    refused += checkTargets(path.join(base, TARGETS), defaults);
    if (refused > 0) {
        console.log("vgsh-theme-judge: refused=" + refused);
        process.exit(1);
    }
    console.log("vgsh-theme-judge: ok");
}

// A target directory's judged target.json and the text of every template
// it names, or `templates` null for a refused target. Any read failure
// throws the fs error.
function readTarget(dir) {
    const verdict = render.acceptTarget(logic, path.basename(dir), fs.readFileSync(path.join(dir, render.TARGET_FILE), "utf8"));
    if (!verdict.ok) return { verdict, templates: null };
    const templates = new Map();
    for (const file of verdict.target.files)
        if (!templates.has(file.template)) templates.set(file.template, fs.readFileSync(path.join(dir, file.template), "utf8"));
    return { verdict, templates };
}

// Render every target under BASE against DEFAULTS, the accepted `vgs`
// verdict of the same themes directory or null, and answer how many were
// refused. Every template is rendered whatever a package curates, so this
// judges every placeholder of every target. An absent BASE holds no target.
function checkTargets(base, defaults) {
    let names;
    try {
        names = childDirs(base);
    } catch (e) {
        unreadable(base, e.code);
    }
    if (names === null || names.length === 0) return 0;
    if (defaults === null || defaults.terminal === null) unreadable(path.join(path.dirname(base), logic.DEFAULT_NAME), "no accepted package with terminal slots");
    let refused = 0;
    for (const name of names) {
        const dir = path.join(base, name);
        let judged;
        try {
            judged = readTarget(dir);
        } catch (e) {
            unreadable(e.path || dir, e.code);
        }
        const verdict = judged.verdict.ok
            ? render.renderTarget(logic, tokens, judged.verdict.target, judged.templates, { values: defaults.values, slots: defaults.terminal, curated: new Map(), installed: false })
            : judged.verdict;
        if (verdict.ok) {
            console.log("ok       " + TARGETS + "/" + name);
            continue;
        }
        console.log("refused  " + dir + ": " + render.refusalLine(name, verdict));
        refused += 1;
    }
    return refused;
}

// --- catalog

// Every destination a target under BASE writes, mapped to its target's
// name, `runsCode` and accepted `files` entry, and the number of targets
// acceptTarget refused, each printed as `packages` prints it. An absent
// BASE holds no target. Any read failure is unreadable.
function targetDestinations(base) {
    let names;
    try {
        names = childDirs(base);
    } catch (e) {
        unreadable(base, e.code);
    }
    const destinations = new Map();
    let refused = 0;
    for (const name of names || []) {
        const dir = path.join(base, name);
        let verdict;
        try {
            verdict = readTarget(dir).verdict;
        } catch (e) {
            unreadable(e.path || dir, e.code);
        }
        if (!verdict.ok) {
            console.log("refused  " + dir + ": " + render.refusalLine(name, verdict));
            refused += 1;
            continue;
        }
        for (const file of verdict.target.files) destinations.set(file.destination, { name, runsCode: verdict.target.runsCode, file });
    }
    return { destinations, refused };
}

// The judge's refusal of the curated files in DIR/targets, or null: a
// catalogued package becomes an installed one, whose curated file on a
// `runsCode` target apply drops, so the catalog carries none there, nor one
// no target writes, nor one of a shape apply would not take in place of the
// render (render.curatedTaken), nor a symlink. Any read failure throws the
// fs error.
function curatedRefusal(dir, destinations) {
    const base = path.join(dir, TARGETS);
    const stat = fs.lstatSync(base, { throwIfNoEntry: false });
    if (stat === undefined) return null;
    if (stat.isSymbolicLink()) return logic.refusal("symlink", "", "file=" + TARGETS);
    if (!stat.isDirectory()) return logic.refusal("curated-file", "", "file=" + TARGETS);
    for (const entry of fs.readdirSync(base, { withFileTypes: true }).sort((a, b) => a.name < b.name ? -1 : 1)) {
        const file = TARGETS + "/" + entry.name;
        if (entry.isSymbolicLink()) return logic.refusal("symlink", "", "file=" + file);
        if (!entry.isFile()) return logic.refusal("curated-file", "", "file=" + file);
        const target = destinations.get(entry.name);
        if (target === undefined) return logic.refusal("curated-unknown", "", "file=" + file);
        if (target.runsCode) return logic.refusal("curated-code", "", "file=" + file + " target=" + target.name);
        if (!render.curatedTaken(logic, target.file, fs.readFileSync(path.join(base, entry.name)))) return logic.refusal("curated-shape", "", "file=" + file + " target=" + target.name);
    }
    return null;
}

// The judge's verdict on catalogued package ENTRY in CATALOG_DIR: its
// package files through ThemeLogic.acceptCatalogEntry, its curated files,
// and its thumbnail, which must be a file in the catalog reached through no
// symlink. Any read failure throws the fs error.
function catalogVerdict(catalogDir, entry, destinations) {
    const dir = path.join(catalogDir, entry.name);
    const stat = fs.lstatSync(dir, { throwIfNoEntry: false });
    if (stat === undefined) return logic.refusal("absent", "", "file=" + entry.name);
    if (stat.isSymbolicLink()) return logic.refusal("symlink", "", "file=" + entry.name);
    const read = packageFiles(dir);
    if (read.linked !== null) return logic.refusal("symlink", "", "file=" + entry.name + "/" + read.linked);
    if (read.files.theme === undefined) return logic.refusal("absent", "", "file=" + entry.name + "/theme.json");
    const verdict = logic.acceptCatalogEntry(tokens, entry, { themeJson: text(read.files.theme), terminalJson: text(read.files.terminal) });
    if (!verdict.ok) return verdict;
    const curated = curatedRefusal(dir, destinations);
    if (curated !== null) return curated;
    if (entry.thumbnail !== null) {
        const thumbnail = packageFile(catalogDir, entry.thumbnail);
        if (thumbnail.state === "linked") return logic.refusal("symlink", "", "file=" + entry.thumbnail);
        if (thumbnail.state === "absent") return logic.refusal("absent", "", "file=" + entry.thumbnail);
    }
    return verdict;
}

// Judge DIR/catalog, DIR a themes directory (default: the shipped themes/):
// its index through ThemeLogic.acceptCatalogIndex, then every entry against
// the targets under DIR/targets. One line per entry; exit 0 when the index
// and every entry are accepted, 1 when any is refused, 2 when the index or
// a file cannot be read.
function checkCatalog(dirArg) {
    const base = path.resolve(dirArg || SHIPPED);
    const catalogDir = path.join(base, CATALOG);
    const indexFile = path.join(catalogDir, CATALOG_INDEX);
    let indexText;
    try {
        indexText = fs.readFileSync(indexFile, "utf8");
    } catch (e) {
        unreadable(indexFile, e.code);
    }
    const index = logic.acceptCatalogIndex(tokens, indexText);
    if (!index.ok) {
        console.log("refused  " + indexFile + ": " + logic.refusalLine(index));
        console.log("vgsh-theme-judge: refused=1");
        process.exit(1);
    }
    const { destinations, refused: targetsRefused } = targetDestinations(path.join(base, TARGETS));
    let refused = targetsRefused;
    for (const entry of index.entries) {
        let verdict;
        try {
            verdict = catalogVerdict(catalogDir, entry, destinations);
        } catch (e) {
            unreadable(e.path || path.join(catalogDir, entry.name), e.code);
        }
        if (verdict.ok) {
            console.log("ok       " + CATALOG + "/" + entry.name);
            continue;
        }
        console.log("refused  " + path.join(catalogDir, entry.name) + ": " + logic.refusalLine(verdict));
        refused += 1;
    }
    if (refused > 0) {
        console.log("vgsh-theme-judge: refused=" + refused);
        process.exit(1);
    }
    console.log("vgsh-theme-judge: ok");
}

// --- the package set list and apply share

// One package: `state` is `ok`, `refused` with its `reason`, or `shadowed`
// by an installed package of its name, which is never read. `palette` is
// the resolved palette group of an accepted package. `files`, `values`, the
// judge's resolved tokens, and `terminal`, its slots or null, stay in this
// process.
function packageRow(base, name, source) {
    const dir = path.join(base, name);
    const row = { name, source, path: dir, state: "refused", reason: null, palette: null, files: null, values: null, terminal: null };
    let judged;
    try {
        judged = readPackage(dir, source === "shipped");
    } catch (e) {
        row.reason = "unreadable";
        return row;
    }
    row.files = judged.files;
    if (!judged.verdict.ok) {
        row.reason = judged.verdict.reason;
        return row;
    }
    row.state = "ok";
    row.values = judged.verdict.values;
    row.palette = row.values.palette;
    row.terminal = judged.verdict.terminal;
    return row;
}

// Every package under the shipped and the installed directory, and the
// one each name resolves to. An installed package hides the shipped
// package of its name, which is listed as shadowed, unless the judge
// refused it for its reserved name: the shipped defaults are always
// what `apply vgs` takes. KEY leads a refusal for a directory that
// cannot be read.
function packageSet(configDir, key) {
    const dirs = (base, required) => {
        let names;
        try {
            names = packageDirs(base);
        } catch (e) {
            refuse(key + "=unreadable path=" + base + " error=" + e.code, "unreadable");
        }
        if (names === null && required) refuse(key + "=unreadable path=" + base + " error=ENOENT", "unreadable");
        return names || [];
    };
    const installedBase = path.join(configDir, "themes");
    const rows = [];
    const resolved = new Map();
    for (const name of dirs(installedBase, false)) {
        const row = packageRow(installedBase, name, "installed");
        rows.push(row);
        if (row.reason !== "reserved-name") resolved.set(name, row);
    }
    for (const name of dirs(SHIPPED, true)) {
        if (resolved.has(name)) {
            rows.push({ name, source: "shipped", path: path.join(SHIPPED, name), state: "shadowed", reason: null, palette: null, files: null, values: null, terminal: null });
            continue;
        }
        const row = packageRow(SHIPPED, name, "shipped");
        rows.push(row);
        resolved.set(name, row);
    }
    rows.sort((a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : a.source === "installed" ? -1 : 1);
    return { rows, resolved };
}

// The theme file as the shell reads it: `absent`, `unreadable`, `refused`
// by ThemeLogic.accept, or `loaded` with the document's name.
function themeFile(file) {
    let bytes;
    try {
        bytes = fs.readFileSync(file);
    } catch (e) {
        return { path: file, state: e.code === "ENOENT" ? "absent" : "unreadable", name: null, bytes: null };
    }
    const accepted = logic.accept(tokens, bytes.toString("utf8"));
    return { path: file, state: accepted.ok ? "loaded" : "refused", name: accepted.ok ? accepted.name : null, bytes };
}

// --- the applied record

// Beside theme.name. This judge is its only reader and writer.
const APPLIED_FILE = "applied.json";
const SHA256_HEX = /^[0-9a-f]{64}$/;

function sha256(bytes) {
    return crypto.createHash("sha256").update(bytes).digest("hex");
}

// The digest of package ROW's content as apply reads it: theme.json,
// terminal.json, an absent one marked as absent, and each file directly
// under its targets/, in name order; a symlink, which apply never reads,
// and a symlinked targets/ contribute nothing. Each part is framed by its
// name and length, so no two contents share a digest. Backgrounds are no
// colours and stay out. KEY leads the refusal for a targets/ or a file in
// it that cannot be read.
function packageDigest(row, key) {
    const hash = crypto.createHash("sha256");
    const part = (name, bytes) => {
        hash.update(name + "\0" + (bytes === undefined ? "absent" : String(bytes.length)) + "\0");
        if (bytes !== undefined) hash.update(bytes);
    };
    part("theme.json", row.files.theme);
    part("terminal.json", row.files.terminal);
    const dir = path.join(row.path, TARGETS);
    let names;
    try {
        names = fs.lstatSync(dir).isSymbolicLink() ? [] : fs.readdirSync(dir).sort();
    } catch (e) {
        if (e.code !== "ENOENT") refuse(key + "=unreadable path=" + dir + " error=" + e.code, "unreadable");
        names = [];
    }
    for (const name of names) {
        const file = path.join(dir, name);
        let bytes;
        try {
            if (fs.lstatSync(file, { throwIfNoEntry: false })?.isFile() !== true) continue;
            bytes = fs.readFileSync(file);
        } catch (e) {
            refuse(key + "=unreadable path=" + file + " error=" + e.code, "unreadable");
        }
        part(TARGETS + "/" + name, bytes);
    }
    return hash.digest("hex");
}

// The apply <state-dir>/applied.json records, `{ schemaVersion: 1, name,
// file, package }`: the package's name, the sha256 of the theme.json bytes
// it wrote to the theme file and its packageDigest. Null when absent. KEY
// leads the refusal for a file that cannot be read or parsed, or is no
// such record.
function readApplied(stateDir, key) {
    const file = path.join(stateDir, APPLIED_FILE);
    const doc = readJson(file, key, true);
    if (doc === null) return null;
    const isDigest = value => typeof value === "string" && SHA256_HEX.test(value);
    const shaped = logic.isPlainObject(doc) && Object.keys(doc).length === 4 && doc.schemaVersion === 1 &&
        logic.isPackageName(doc.name) && isDigest(doc.file) && isDigest(doc.package);
    if (!shaped) refuse(key + "=malformed path=" + file, "malformed");
    return doc;
}

// Whether the file differs from what its named package gave it: false when
// that package is accepted and the file holds either its theme.json or the
// bytes APPLIED, the record, says the last apply of it wrote, a version a
// follow has yet to replace. An absent file is the defaults, unmodified; a
// refused one is no accepted package's bytes; an unreadable one cannot be
// compared, so null.
function modified(file, resolved, applied) {
    switch (file.state) {
    case "absent": return false;
    case "unreadable": return null;
    case "refused": return true;
    case "loaded": {
        const row = resolved.get(file.name);
        if (row === undefined || row.state !== "ok") return true;
        if (row.files.theme.equals(file.bytes)) return false;
        return !(applied !== null && applied.name === file.name && sha256(file.bytes) === applied.file);
    }
    default: throw new Error("vgsh-theme-judge: file state " + file.state + " is none of absent, unreadable, refused, loaded");
    }
}

// --- list

function list(format, configDir, stateDir) {
    const { rows, resolved } = packageSet(configDir, "themes");
    const applied = readApplied(stateDir, "themes");
    const file = themeFile(path.join(configDir, "theme.json"));
    const current = file.state === "loaded" ? resolved.get(file.name) : undefined;
    const packages = rows.map(row => ({ name: row.name, source: row.source, path: row.path, state: row.state, reason: row.reason, current: row === current, palette: row.palette }));
    const report = { file: { path: file.path, state: file.state, name: file.name, modified: modified(file, resolved, applied) }, packages };
    if (format === "json") {
        process.stdout.write(JSON.stringify(report) + "\n");
        return;
    }
    console.log("file path=" + file.path + " state=" + file.state + " name=" + (file.name === null ? "-" : file.name) + " modified=" + report.file.modified);
    for (const p of packages) {
        let line = "theme=" + p.name + " source=" + p.source + " state=" + p.state;
        if (p.reason !== null) line += " reason=" + p.reason;
        line += " current=" + p.current;
        if (p.palette !== null) line += " palette=" + Object.keys(p.palette).map(k => k + ":" + p.palette[k]).join(",");
        console.log(line);
    }
}

// --- apply

// The exit status of an apply a target failed in: the shell took the theme
// and at least one application did not.
const PARTIAL_STATUS = 3;

// The target names the effective shell.json lists in `disabledTargets`: the
// shipped layer merged with the user's by PluginLogic.effectiveConfig, each
// judged by configError first. A layer the judge refuses refuses the apply,
// since no target's enablement can then be known.
function disabledTargets(configDir, key) {
    const shipped = readConfig(pluginLogic, SHIPPED_CONFIG, key);
    const user = readConfig(pluginLogic, path.join(configDir, "shell.json"), key, true);
    const effective = pluginLogic.effectiveConfig(shipped, user);
    return Array.isArray(effective.disabledTargets) ? effective.disabledTargets : [];
}

// Run READ, whose fs failure is the target's own: answers READ's value, or
// FAILED, the target entry naming the file and the error code. Any other
// throw is no read failure and propagates.
function reading(name, dir, read, failed) {
    try {
        return { ok: true, value: read() };
    } catch (e) {
        if (typeof e.code !== "string") throw e;
        return { ok: false, entry: failed("unreadable", "target=" + name + " reason=unreadable path=" + (e.path || dir) + " error=" + e.code) };
    }
}

// One shipped target judged and rendered for package ROW, in memory, before
// any file moves. `state` is `skipped` or `failed` with its `reason`, a
// failed one carrying `failure`, its keyed line; a rendered one is `pending`
// with its `target`, `files` and `dropped`, the destinations whose curated
// file was not taken because it is a symlink or the renderer dropped it,
// until the stage compares their bytes. A
// disabled target keeps its `target`, whose wiring apply removes.
// SLOTS are the terminal slots terminalSource chose; LIVE is the state
// directory's theme/, which an entry target's links point into and a
// selection's value may name.
function planTarget(dir, row, slots, disabled, configHome, live) {
    const name = path.basename(dir);
    const skipped = reason => ({ name, state: "skipped", reason });
    const failed = (reason, failure) => ({ name, state: "failed", reason, failure });
    const judged = reading(name, dir, () => readTarget(dir), failed);
    if (!judged.ok) return judged.entry;
    const verdict = judged.value.verdict;
    if (!verdict.ok) return failed(verdict.reason, render.refusalLine(name, verdict));
    const target = verdict.target;
    if (disabled.includes(name)) return { name, state: "skipped", reason: "disabled", target };
    const found = reading(name, dir, () => {
        if (!render.detected(target.detect, onPath)) return "not-detected";
        if (!render.setupDone(target, onPath)) return "setup-absent";
        switch (render.wiringForm(target.wiring)) {
        case "include": {
            const files = includeFiles(target, configHome);
            if (files.length === 0) return "wiring-file-absent";
            if (!target.wiring.create && files.some(file => fs.statSync(file, { throwIfNoEntry: false }) === undefined)) return "wiring-file-absent";
            return null;
        }
        case "entry": {
            return null;
        }
        case "none":
            return null;
        default:
            throw new Error("vgsh-theme-judge: planTarget: target " + name + " has no known wiring form");
        }
    }, failed);
    if (!found.ok) return found.entry;
    if (found.value !== null) return skipped(found.value);
    // A settings file that is absent, or whose key the edit refuses, skips
    // the target before anything lands, so its application keeps its theme.
    if (target.select !== undefined) {
        const selected = reading(name, dir, () => {
            const selection = selectionEdit(target, configHome, live);
            const verdict = selection.edit(latin1(readIfPresent(selection.file)));
            return verdict === null || typeof verdict === "string" ? null : verdict.reason;
        }, failed);
        if (!selected.ok) return selected.entry;
        if (selected.value !== null) return skipped(selected.value);
    }
    const curated = reading(name, dir, () => {
        const files = new Map();
        const linked = [];
        for (const file of target.files) {
            const read = packageFile(row.path, TARGETS + "/" + file.destination);
            if (read.state === "linked") linked.push(file.destination);
            if (read.state === "file") files.set(file.destination, read.bytes);
        }
        return { files, linked };
    }, failed);
    if (!curated.ok) return curated.entry;
    const rendered = render.renderTarget(logic, tokens, target, judged.value.templates,
        { values: row.values, slots, curated: curated.value.files, installed: row.source === "installed" });
    if (!rendered.ok) return failed(rendered.reason, render.refusalLine(name, rendered));
    // A symlinked curated file is never read, so the template renders in
    // its place; the renderer drops the rest, on runsCode targets.
    const dropped = target.files.map(file => file.destination)
        .filter(destination => curated.value.linked.includes(destination) || rendered.dropped.includes(destination));
    let entryPlan;
    if (render.wiringForm(target.wiring) === "entry") {
        const planned = reading(name, dir, () => {
            const dirs = entryDirs(target, configHome);
            if (dirs.length === 0) return "wiring-file-absent";
            const plan = planEntries(target, dirs, live, rendered.files);
            return entryOccupied(plan) === null ? plan : "entry-occupied";
        }, failed);
        if (!planned.ok) return planned.entry;
        if (planned.value === "wiring-file-absent" || planned.value === "entry-occupied") return skipped(planned.value);
        entryPlan = planned.value;
    }
    return { name, state: "pending", reason: null, target, files: rendered.files, dropped, entryPlan };
}

// Every shipped target under themes/targets/, planned by planTarget, in
// name order. KEY leads the refusal for a targets directory that cannot be
// listed; an absent one holds no target.
function planTargets(row, slots, disabled, configHome, live, key) {
    const base = path.join(SHIPPED, TARGETS);
    let names;
    try {
        names = childDirs(base);
    } catch (e) {
        refuse(key + "=unreadable path=" + base + " error=" + e.code, "unreadable");
    }
    return (names || []).map(name => planTarget(path.join(base, name), row, slots, disabled, configHome, live));
}

// Whether every file of a rendered target already stands in LIVE with the
// same bytes. A file that cannot be read there is taken as changed: the
// stage replaces it whatever it held.
function sameBytes(live, files) {
    return files.every(file => {
        let bytes;
        try {
            bytes = readIfPresent(path.join(live, file.destination));
        } catch (e) {
            if (typeof e.code !== "string") throw e;
            return false;
        }
        return bytes !== undefined && bytes.equals(file.bytes);
    });
}

// The files the state directory's theme/ holds for its package, never a
// target's.
const PACKAGE_FILES = ["theme.json", "terminal.json"];

// The files target NAME landed in LIVE on an earlier apply, as
// { destination, bytes }. A destination is `<target>.<ext>` and a target
// name holds no dot, so the text before a file's first dot names its target,
// whether or not target.json can still be read. An absent LIVE holds none;
// KEY leads the refusal for one that cannot be read, since a file left out
// would leave its include line or link naming nothing.
function landedFiles(live, name, key) {
    let names;
    try {
        names = fs.readdirSync(live);
    } catch (e) {
        if (e.code === "ENOENT") return [];
        refuse(key + "=unreadable path=" + live + " error=" + e.code, "unreadable");
    }
    return names.filter(file => !PACKAGE_FILES.includes(file) && file.split(".")[0] === name).sort().map(file => {
        const at = path.join(live, file);
        try {
            return { destination: file, bytes: fs.readFileSync(at) };
        } catch (e) {
            refuse(key + "=unreadable path=" + at + " error=" + e.code, "unreadable");
        }
    });
}

// The first of RELATIVES under the home directory whose READ answers a
// value other than undefined. Only ENOENT is absence; any other fs failure
// is the target's and names the path tried.
function firstHomeRelative(relatives, read) {
    for (const relative of relatives) {
        const file = path.join(os.homedir(), relative);
        let value;
        try {
            value = read(file);
        } catch (e) {
            if (typeof e.code === "string") e.path = file;
            throw e;
        }
        if (value !== undefined) return { file, value };
    }
    return null;
}

// FILE when it exists, following symlinks, or undefined when it is absent.
// A dangling symlink is absent; non-ENOENT stat failures throw.
function existingPath(file) {
    try {
        fs.statSync(file);
        return file;
    } catch (e) {
        if (e.code === "ENOENT") return undefined;
        throw e;
    }
}

// The configuration files include TARGET keeps its line in: its `file`
// under CONFIG_HOME; with `fallbacks`, the first existing fallback path
// under HOME when that file is absent; or, with `profiles`, under every
// profile directory the first of those profiles.ini paths under the home
// directory that exists lists, a relative one under the ini's own
// directory. A listed profile whose directory does not exist is left out,
// so a stale entry never makes apply create a profile; no ini lists none.
// Throws the fs error of an ini, fallback or profile that cannot be read,
// its `path` the file's: a read error such as EISDIR carries none of its own.
function includeFiles(target, configHome) {
    const wiring = target.wiring;
    if (wiring.profiles === undefined) {
        const configFile = path.join(configHome, wiring.file);
        if (wiring.fallbacks === undefined || existingPath(configFile) !== undefined) return [configFile];
        const fallback = firstHomeRelative(wiring.fallbacks, existingPath);
        return [fallback === null ? configFile : fallback.value];
    }
    const selected = firstHomeRelative(wiring.profiles, readIfPresent);
    if (selected === null) return [];
    return render.profileDirs(selected.value.toString("utf8"))
        .map(dir => dir.relative ? path.join(path.dirname(selected.file), dir.path) : dir.path)
        .filter(isDirectory)
        .map(dir => path.join(dir, wiring.file));
}

// Whether DIR is a directory, a symlink to one included. A path that is
// absent, or under a file, is none; any other stat failure throws.
function isDirectory(dir) {
    try {
        return fs.statSync(dir).isDirectory();
    } catch (e) {
        if (e.code === "ENOENT" || e.code === "ENOTDIR") return false;
        throw e;
    }
}

// Edit every configuration file of TARGET, includeFiles' list, as editFile
// edits one, stopping at the first failure. EDIT maps a file's text, or
// undefined for an absent file, the include line pointing at LIVE and the
// wiring's section, undefined when it names none, to what editFile takes.
// Answers null, or the failure's { reason, failure } for target NAME.
function editWiring(name, target, configHome, live, edit) {
    const key = "target=" + name + " reason";
    let files;
    try {
        files = includeFiles(target, configHome);
    } catch (e) {
        if (typeof e.code !== "string") throw e;
        return { reason: "unreadable", failure: key + "=unreadable path=" + e.path + " error=" + e.code };
    }
    const edited = text => edit(text, Buffer.from(render.wiringLine(target, live), "utf8").toString("latin1"), target.wiring.section);
    for (const file of files) {
        const failure = editFile(key, file, target.wiring.create, edited);
        if (failure !== null) return failure;
    }
    return null;
}

// The directory BASE names, which an entry's `dir` or `vaults` and a
// selection's `file` are relative to: the configuration home, CONFIG_HOME,
// the home directory or the cache home, ${XDG_CACHE_HOME:-~/.cache}.
function baseDir(base, configHome) {
    switch (base) {
    case "config": return configHome;
    case "home": return os.homedir();
    case "cache": return process.env.XDG_CACHE_HOME || path.join(os.homedir(), ".cache");
    default: throw new Error("vgsh-theme-judge: baseDir: base " + base + " is none of config, home, cache");
    }
}

// The directories entry TARGET's links stand in: its `dir` under its base,
// or, with `vaults`, under every vault that Obsidian registry, relative to
// the base, lists, one whose first `dir` segment is a directory in it, so
// a registered vault that is gone or was never opened gets nothing. An
// absent registry lists none. Throws the fs error of a registry that cannot
// be read, its `path` the registry's, and one with code `unparseable` for a
// registry vaultDirs cannot read a vault list from.
function entryDirs(target, configHome) {
    const wiring = target.wiring;
    const base = baseDir(wiring.base, configHome);
    if (wiring.vaults === undefined) return [path.join(base, wiring.dir)];
    const registry = path.join(base, wiring.vaults);
    let bytes;
    try {
        bytes = readIfPresent(registry);
    } catch (e) {
        if (typeof e.code === "string") e.path = registry;
        throw e;
    }
    if (bytes === undefined) return [];
    const vaults = render.vaultDirs(logic, bytes.toString("utf8"));
    if (vaults === null) throw Object.assign(new Error("unparseable vault registry " + registry), { code: "unparseable", path: registry });
    const first = wiring.dir.split("/")[0];
    return vaults.filter(vault => fs.statSync(path.join(vault, first), { throwIfNoEntry: false })?.isDirectory() === true)
        .map(vault => path.join(vault, wiring.dir));
}

// The failure of target NAME whose entryDirs threw E, keyed by KEY, or a
// rethrow of an E that is no read failure.
function entryDirsFailure(key, e) {
    if (typeof e.code !== "string") throw e;
    return { reason: "unreadable", failure: key + "=unreadable path=" + e.path + " error=" + e.code };
}

// The entry items of TARGET with the bytes they are allowed to manage. A
// copy may replace a file whose bytes equal the render the plan saw before
// the swap, or the render this apply is landing.
function planEntries(target, dirs, live, files) {
    const bytes = new Map(files.map(file => [file.destination, file.bytes]));
    const items = render.entryItems(target, live).map(item => {
        const next = bytes.get(item.destination);
        if (next === undefined) throw new Error("vgsh-theme-judge: planEntries: target " + target.name + " has no bytes for " + item.destination);
        return Object.assign({}, item, { oldBytes: readIfPresent(item.to), newBytes: next });
    });
    return { dirs, items };
}

function currentEntries(target, dirs, live) {
    const items = render.entryItems(target, live).map(item => {
        const oldBytes = readIfPresent(item.to);
        return Object.assign({}, item, { oldBytes, newBytes: oldBytes });
    });
    return { dirs, items };
}

// What stands at FILE for an entry ITEM: `absent`, `managed`, or
// `occupied`. A link is managed only when it is a symlink whose target is
// exactly ITEM.to. A copy is managed when it is that old link form, or a
// regular file whose bytes equal either the old bytes the plan saw or the
// new bytes this apply is landing.
function entryState(file, item) {
    const stat = fs.lstatSync(file, { throwIfNoEntry: false });
    if (stat === undefined) return "absent";
    switch (item.kind) {
    case "link":
        return stat.isSymbolicLink() && fs.readlinkSync(file) === item.to ? "managed" : "occupied";
    case "copy":
        if (stat.isSymbolicLink()) return fs.readlinkSync(file) === item.to ? "managed" : "occupied";
        if (!stat.isFile()) return "occupied";
        {
            const bytes = fs.readFileSync(file);
            if ((item.oldBytes !== undefined && bytes.equals(item.oldBytes)) || (item.newBytes !== undefined && bytes.equals(item.newBytes))) return "managed";
            return "occupied";
        }
    default:
        throw new Error("vgsh-theme-judge: entryState: entry kind " + item.kind + " is neither link nor copy");
    }
}

function copyNeedsWrite(file, item) {
    const stat = fs.lstatSync(file, { throwIfNoEntry: false });
    if (stat === undefined || stat.isSymbolicLink()) return true;
    if (!stat.isFile()) return false;
    return !fs.readFileSync(file).equals(item.newBytes);
}

// The first path that stops an entry plan from keeping its entries in place,
// or null: a directory of entryDirs that is no directory, or an entry's path
// something other than its managed form holds. A symlinked directory counts
// as the directory it names, so a dotfile manager's link serves. Throws the
// fs error of a path that cannot be read.
function entryOccupied(plan) {
    for (const dir of plan.dirs) {
        const stat = fs.statSync(dir, { throwIfNoEntry: false });
        if (stat === undefined) continue;
        if (!stat.isDirectory()) return dir;
        const occupied = plan.items.find(item => entryState(path.join(dir, item.name), item) === "occupied");
        if (occupied !== undefined) return path.join(dir, occupied.name);
    }
    return null;
}

// Keep entry TARGET's entries in each of its directories, each created with
// its parents when absent. A managed link is left as it is. A managed copy is
// replaced by rename only when its bytes differ or it is the old link form.
// Answers null, or the failure's { reason, failure } for target NAME:
// `entry-occupied` when a path came to be taken after the plan judged it
// free, else what the read or write met.
function keepEntries(name, target, configHome, live, plan) {
    const key = "target=" + name + " reason";
    try {
        if (plan === undefined) plan = currentEntries(target, entryDirs(target, configHome), live);
        for (const dir of plan.dirs) {
            writing(dir, key, () => fs.mkdirSync(dir, { recursive: true }));
            for (const item of plan.items) {
                const file = path.join(dir, item.name);
                const state = entryState(file, item);
                if (state === "occupied") return { reason: "entry-occupied", failure: key + "=entry-occupied path=" + file };
                if (item.kind === "link" && state === "absent") writing(file, key, () => fs.symlinkSync(item.to, file));
                else if (item.kind === "copy" && (state === "absent" || copyNeedsWrite(file, item))) replaceFile(file, item.newBytes, key, 0o644);
                else if (item.kind !== "link" && item.kind !== "copy") throw new Error("vgsh-theme-judge: keepEntries: entry kind " + item.kind + " is neither link nor copy");
            }
        }
    } catch (e) {
        if (e instanceof Refusal) return { reason: e.reason, failure: e.first };
        if (typeof e.code !== "string") throw e;
        return { reason: "unreadable", failure: key + "=unreadable path=" + (e.path || live) + " error=" + e.code };
    }
    return null;
}

// Remove entry TARGET's managed entries from each of its directories, and
// an `owned` one once it is empty. A path something else holds is not the
// target's and stays, and so does an owned directory holding anything else.
// Answers null, or the failure's { reason, failure } for target NAME.
function dropEntries(name, target, configHome, live) {
    const key = "target=" + name + " reason";
    let plan;
    try {
        plan = currentEntries(target, entryDirs(target, configHome), live);
    } catch (e) {
        return entryDirsFailure(key, e);
    }
    try {
        for (const dir of plan.dirs) {
            for (const item of plan.items) {
                const file = path.join(dir, item.name);
                if (entryState(file, item) === "managed") writing(file, key, () => fs.unlinkSync(file));
            }
            if (target.wiring.owned) writing(dir, key, () => {
                const stat = fs.lstatSync(dir, { throwIfNoEntry: false });
                if (stat === undefined || !stat.isDirectory()) return;
                try {
                    fs.rmdirSync(dir);
                } catch (e) {
                    if (e.code !== "ENOTEMPTY" && e.code !== "EEXIST") throw e;
                }
            });
        }
    } catch (e) {
        if (e instanceof Refusal) return { reason: e.reason, failure: e.first };
        if (typeof e.code !== "string") throw e;
        return { reason: "unreadable", failure: key + "=unreadable path=" + (e.path || live) + " error=" + e.code };
    }
    return null;
}

// The settings file TARGET's `select` names, under its base, and the edit
// theme-select.js makes in that file's latin1 text, the value's `@{state}`
// written as LIVE.
function selectionEdit(target, configHome, live) {
    const selection = target.select;
    const value = latin1(Buffer.from(render.selectValue(target, live), "utf8"));
    return {
        file: path.join(baseDir(selection.base, configHome), selection.file),
        edit: text => select.selectedText(selection.format, text, render.selectKeys(target), value)
    };
}

// Keep a landed ENTRY's wiring: its include line in its configuration file,
// or its links in its application's directory, and then its selection in
// its application's settings file, which is never created. Answers ENTRY,
// or its failed entry, which keeps the files it landed and so its `dropped`.
function wire(entry, configHome, live) {
    let failure;
    switch (render.wiringForm(entry.target.wiring)) {
    case "include": failure = editWiring(entry.name, entry.target, configHome, live, render.wiredText); break;
    case "entry": failure = keepEntries(entry.name, entry.target, configHome, live, entry.entryPlan); break;
    case "none": failure = null; break;
    default: throw new Error("vgsh-theme-judge: wire: target " + entry.name + " has no known wiring form");
    }
    if (failure === null && entry.target.select !== undefined) {
        const selection = selectionEdit(entry.target, configHome, live);
        failure = editFile("target=" + entry.name + " reason", selection.file, false, selection.edit);
    }
    return failure === null ? entry : Object.assign({ name: entry.name, state: "failed", dropped: entry.dropped }, failure);
}

// Undo a disabled TARGET's wiring: remove its include line or its links.
// Answers null, or the failure's { reason, failure } for target NAME.
function unwire(name, target, configHome, live) {
    switch (render.wiringForm(target.wiring)) {
    case "include": return editWiring(name, target, configHome, live, render.unwiredText);
    case "entry": return dropEntries(name, target, configHome, live);
    case "none": return null;
    default: throw new Error("vgsh-theme-judge: unwire: target " + name + " has no known wiring form");
    }
}

// Settle every target that does not land its own render this apply, before
// the stage, so no include line or link is left naming a file the swap
// drops. A disabled target's include line or links are removed and its files
// dropped; a removal that fails keeps them and fails the target. Every other target,
// failed or skipped, carries the files it landed before into the stage, so
// its application keeps its last theme.
function settle(entry, configHome, live, key) {
    if (entry.state === "skipped" && entry.reason === "disabled") {
        const failure = unwire(entry.name, entry.target, configHome, live);
        if (failure === null) return entry;
        entry = Object.assign({ name: entry.name, state: "failed" }, failure);
    }
    return Object.assign({}, entry, { files: landedFiles(live, entry.name, key) });
}

// Render the package and every enabled target into <state-dir>/next-theme/,
// with the files settle carries, move it over theme/, write theme.name,
// keep each landed target's wiring, then copy theme.json's bytes to the
// theme file, which the shell watches, so the shell restyles only after
// every application file is in place, and record the apply in
// applied.json. RESULT's `shell` follows the theme file and its `targets`
// are set once the swap has landed them; FAILURES takes each failed
// target's keyed line.
function applyTo(result, failures, configDir, stateDir, lock, name) {
    if (!logic.isPackageName(name)) refuse("theme=" + JSON.stringify(name) + " reason=malformed-name", "malformed-name");
    const key = "theme=" + name + " reason";
    if (lock === "busy") refuse(key + "=busy", "busy", 75);
    if (lock === "failed") refuse(key + "=lock-failed path=" + path.join(configDir, "theme.lock"), "lock-failed");
    const before = readPending(stateDir, key);
    const { rows, resolved } = packageSet(configDir, key);
    const row = resolved.get(name);
    if (row === undefined) refuse(key + "=unknown", "unknown");
    if (row.state !== "ok") refuse(key + "=" + row.reason + " path=" + row.path, row.reason);
    const defaults = rows.find(r => r.source === "shipped" && r.name === logic.DEFAULT_NAME && r.state === "ok");
    const source = render.terminalSource(row, defaults === undefined ? null : defaults);
    if (source === null) refuse(key + "=terminal-fallback path=" + path.join(SHIPPED, logic.DEFAULT_NAME), "terminal-fallback");
    const terminal = source.files.terminal;
    // The configuration home is the parent of the vgs configuration directory;
    // a target's wiring file is relative to it.
    const configHome = path.dirname(configDir);
    const live = path.join(stateDir, "theme");
    const targets = planTargets(row, source.terminal, disabledTargets(configDir, key), configHome, live, key);
    // Chosen before anything moves, so a background state or directory that
    // cannot be read refuses the apply whole.
    const shown = backgrounds.read(logic, stateDir, key);
    const background = backgrounds.stamped(row.path, backgrounds.choose(backgrounds.images(row.path, key), shown.themes[name]), key);
    // Taken before anything moves too, for the record written after the
    // theme file.
    const digest = packageDigest(row, key);

    const stage = path.join(stateDir, "next-theme");
    const aside = path.join(stateDir, "old-theme");
    const settled = targets.map(entry => {
        if (entry.state !== "pending") return settle(entry, configHome, live, key);
        entry.state = sameBytes(live, entry.files) ? "unchanged" : "written";
        return entry;
    });
    // Recorded before the swap, so an apply that dies after it still leaves
    // every written target pending.
    const due = settled.filter(entry => reloadDue(entry, before)).map(entry => entry.name);
    writePending(stateDir, due, before, key);
    try {
        // A stage or an aside copy left by an apply that died is stale:
        // the lock proves no apply is running. Every file is created
        // exclusively, so two writers of one name refuse the apply.
        writing(stage, key, () => {
            fs.rmSync(stage, { recursive: true, force: true });
            fs.rmSync(aside, { recursive: true, force: true });
            fs.mkdirSync(stage, { recursive: true });
            fs.writeFileSync(path.join(stage, "theme.json"), row.files.theme, { flag: "wx" });
            fs.writeFileSync(path.join(stage, "terminal.json"), terminal, { flag: "wx" });
            for (const entry of settled)
                for (const file of entry.files || []) fs.writeFileSync(path.join(stage, file.destination), file.bytes, { flag: "wx" });
        });
        // A rename cannot replace a non-empty directory: the old render
        // moves aside first, so theme/ is absent between the two renames.
        writing(live, key, () => {
            try {
                fs.renameSync(live, aside);
            } catch (e) {
                if (e.code !== "ENOENT") throw e;
            }
            try {
                fs.renameSync(stage, live);
            } catch (e) {
                if (fs.existsSync(aside)) fs.renameSync(aside, live);
                throw e;
            }
        });
        writing(aside, key, () => fs.rmSync(aside, { recursive: true, force: true }));
    } catch (e) {
        // The next apply removes a stage this one leaves, under the lock,
        // so a failed removal here never replaces the refusal it follows.
        try {
            fs.rmSync(stage, { recursive: true, force: true });
        } catch (cleanup) {
            // The refusal being rethrown names the cause.
        }
        throw e;
    }
    replaceFile(path.join(stateDir, "theme.name"), name + "\n", key);
    // An apply shows the package on every screen: it clears `screens` (D039).
    backgrounds.land(stateDir, { current: background, themes: shown.themes, screens: {} }, shown, key);
    // Asserted on every apply, unchanged bytes included, so a line removed
    // by hand comes back.
    const landed = settled.map(entry => entry.state === "written" || entry.state === "unchanged" ? wire(entry, configHome, live) : entry);
    // Only a rendered entry carries `dropped`; every other target took no file.
    result.targets = landed.map(entry => ({ name: entry.name, state: entry.state, reason: entry.reason, dropped: entry.dropped === undefined ? [] : entry.dropped }));
    for (const entry of landed) if (entry.state === "failed") failures.push(entry.failure);

    const file = themeFile(path.join(configDir, "theme.json"));
    if (file.bytes === null || !file.bytes.equals(row.files.theme)) {
        result.shell = "failed";
        replaceFile(file.path, row.files.theme, key);
        result.shell = "applied";
    }
    // Once the theme file holds the package's bytes, so a follow never
    // takes bytes this apply did not write for its own.
    replaceFile(path.join(stateDir, APPLIED_FILE), JSON.stringify({ schemaVersion: 1, name, file: sha256(row.files.theme), package: digest }) + "\n", key);
    // Last, so each application re-reads files that are all in place.
    result.targets = landed.map((entry, i) => entry.state !== "failed" && due.includes(entry.name)
        ? reloadRow(entry.name, entry.target, configHome, live, result.targets[i], failures)
        : result.targets[i]);
    writePending(stateDir, stillPending(result.targets, due), due, key);
    result.state = applyState(result.shell, result.targets);
}

// The apply's state from its shell and target states: `partial` when a
// target failed or its reload is pending, `applied` when the shell or a
// target took new bytes, otherwise `unchanged`.
function applyState(shell, targets) {
    if (targets.some(t => t.state === "failed" || t.state === "reload-pending")) return "partial";
    if (shell === "applied" || targets.some(t => t.state === "written")) return "applied";
    return "unchanged";
}

// Run RUN, which fills RESULT and pushes each failed target's keyed line
// onto its FAILURES, and print the result: under `json` one line on stdout,
// a refusal's included; in text one line per target, then `ok` or `partial`
// and TAIL's text. A partial result exits 3.
function report(format, result, run, tail) {
    const failures = [];
    try {
        run(failures);
    } catch (e) {
        if (e instanceof Refusal && format === "json") {
            result.state = "failed";
            result.reason = e.reason;
            process.stdout.write(JSON.stringify(result) + "\n");
        }
        throw e;
    }
    for (const failure of failures) process.stderr.write("vgsh: refused: " + failure + "\n");
    if (format === "json") {
        process.stdout.write(JSON.stringify(result) + "\n");
    } else {
        // A reload row carries no `dropped`: reload renders nothing.
        for (const t of result.targets) console.log("target=" + t.name + " state=" + t.state + (t.reason === null ? "" : " reason=" + t.reason) +
            (t.dropped === undefined || t.dropped.length === 0 ? "" : " dropped=" + t.dropped.join(",")));
        console.log((result.state === "partial" ? "partial" : "ok") + " " + tail(result));
    }
    if (result.state === "partial") process.exitCode = PARTIAL_STATUS;
}

function apply(format, configDir, stateDir, lock, name) {
    const result = { state: "failed", shell: "unchanged", targets: [], theme: name, reason: null };
    report(format, result, failures => applyTo(result, failures, configDir, stateDir, lock, name),
        r => "theme=" + name + " state=" + r.state + " shell=" + r.shell);
}

// --- follow

// Apply again the package applied.json records once its content changed,
// while the theme file still holds the bytes that apply wrote. RESULT's
// `follow` is `none` with no record, or with ONLY, a name, when the record
// names another package; `edited` when the theme file is absent or holds
// other bytes, a hand edit the follow leaves; `unavailable` when the name
// no longer resolves to an accepted package; `current` when the package's
// digest is the recorded one; `reapplied` once applyTo runs for it, whose
// result RESULT then carries.
function followTo(result, failures, configDir, stateDir, lock, only) {
    const key = "follow=applied reason";
    if (lock === "busy") refuse(key + "=busy", "busy", 75);
    if (lock === "failed") refuse(key + "=lock-failed path=" + path.join(configDir, "theme.lock"), "lock-failed");
    const applied = readApplied(stateDir, key);
    const settled = outcome => {
        result.follow = outcome;
        result.state = "unchanged";
    };
    if (applied === null || (only !== undefined && applied.name !== only)) return settled("none");
    result.theme = applied.name;
    const themePath = path.join(configDir, "theme.json");
    let bytes;
    try {
        bytes = readIfPresent(themePath);
    } catch (e) {
        refuse(key + "=unreadable path=" + themePath + " error=" + e.code, "unreadable");
    }
    if (bytes === undefined || sha256(bytes) !== applied.file) return settled("edited");
    const row = packageSet(configDir, key).resolved.get(applied.name);
    if (row === undefined || row.state !== "ok") return settled("unavailable");
    if (packageDigest(row, key) === applied.package) return settled("current");
    result.follow = "reapplied";
    applyTo(result, failures, configDir, stateDir, lock, applied.name);
}

function follow(format, configDir, stateDir, lock, only) {
    const result = { state: "failed", shell: "unchanged", targets: [], theme: null, reason: null, follow: null };
    report(format, result, failures => followTo(result, failures, configDir, stateDir, lock, only),
        r => "follow=" + r.follow + " theme=" + (r.theme === null ? "-" : r.theme) + " state=" + r.state);
}

// --- reload

// The descriptor bin/vgsh holds the theme lock on, which this process
// inherits; bin/vgsh opens it under the same number. A reload hook gets
// /dev/null there instead, so an application a hook starts never holds the
// lock after the runner exits. A spawn's `ignore` leaves a descriptor above
// 2 as the parent has it, so only a descriptor of its own replaces it:
// docs/architecture/runtime.md § Process.
const LOCK_FD = 9;
// Beside theme/, never in it, since the swap replaces theme/. This judge is
// its only reader and writer; the core never reads it.
const PENDING_FILE = "reload-pending.json";

// The sorted target names <state-dir>/reload-pending.json lists: each
// target whose application may hold files it has not re-read. An absent
// file lists none. KEY leads the refusal for a file that cannot be read or
// parsed, or is no `{ schemaVersion: 1, targets: [<name>...] }`.
function readPending(stateDir, key) {
    const file = path.join(stateDir, PENDING_FILE);
    const doc = readJson(file, key, true);
    if (doc === null) return [];
    const shaped = logic.isPlainObject(doc) && Object.keys(doc).length === 2 && doc.schemaVersion === 1 &&
        Array.isArray(doc.targets) && doc.targets.every(name => typeof name === "string");
    if (!shaped) refuse(key + "=malformed path=" + file, "malformed");
    return [...new Set(doc.targets)].sort();
}

// Record NAMES, sorted, as the pending set when they differ from BEFORE; an
// empty set removes the file. A write that fails refuses, so a pending
// reload is never dropped in silence.
function writePending(stateDir, names, before, key) {
    if (names.join("\n") === before.join("\n")) return;
    const file = path.join(stateDir, PENDING_FILE);
    if (names.length === 0) writing(file, key, () => fs.rmSync(file, { force: true }));
    else replaceFile(file, JSON.stringify({ schemaVersion: 1, targets: names }) + "\n", key);
}

// Whether a settled ENTRY's reload is due once this apply lands: it has a
// hook and its bytes change now or were pending before, or its hook is due
// on every apply and it lands, written or unchanged. A skipped target drops
// its entry: its application no longer reads the files. A failed one keeps
// whatever it had, since it is unknown whether it has a hook.
function reloadDue(entry, before) {
    if (entry.state === "skipped") return false;
    if (entry.target !== undefined && entry.target.reload === null) return false;
    if (entry.state === "unchanged" && render.reloadAlways(entry.target)) return true;
    return entry.state === "written" || before.includes(entry.name);
}

// The names of DUE whose row did not reload: failed or reload-pending.
function stillPending(rows, due) {
    return rows.filter(t => due.includes(t.name) && (t.state === "failed" || t.state === "reload-pending")).map(t => t.name);
}

// The one wiring file a reload argument can name, or undefined when TARGET
// has no such placeholder. A lookup failure keeps the target pending; the
// hook cannot be run with the wrong path.
function reloadWiring(name, target, configHome, failures) {
    if (!render.reloadNamesWiring(target)) return { ok: true, path: undefined };
    try {
        return { ok: true, path: includeFiles(target, configHome)[0] };
    } catch (e) {
        if (typeof e.code !== "string") throw e;
        failures.push("target=" + name + " reason=reload-failed path=" + e.path + " error=" + e.code);
        return { ok: false };
    }
}

// Run target NAME's reload hook, the argv render.reloadCommand writes with
// LIVE, the state directory's theme/, and WIRING, the file its include line
// is kept in, bounded by its timeoutMs, with this process's environment.
// Answers ROW when it exits 0, else ROW as reload-pending with its reason
// and its keyed line pushed onto FAILURES. No stream is a pipe: the hook's
// output never reaches the result on stdout, and spawnSync would wait past
// the timeout for a pipe a hook's child holds.
function reloadRow(name, target, configHome, live, row, failures) {
    const reload = target.reload;
    const wiring = reloadWiring(name, target, configHome, failures);
    if (!wiring.ok) return Object.assign({}, row, { state: "reload-pending", reason: "reload-failed" });
    const [command, ...args] = render.reloadCommand(target, live, wiring.path);
    const nul = fs.openSync("/dev/null", "r");
    let run;
    try {
        const stdio = new Array(LOCK_FD + 1).fill("ignore");
        stdio[LOCK_FD] = nul;
        run = spawnSync(command, args, { stdio, timeout: reload.timeoutMs, killSignal: "SIGKILL" });
    } finally {
        fs.closeSync(nul);
    }
    const key = "target=" + name + " reason=";
    let reason = "reload-failed";
    let failure;
    if (run.error !== undefined && run.error.code === "ETIMEDOUT") {
        reason = "reload-timeout";
        failure = "command=" + command + " timeout-ms=" + reload.timeoutMs;
    } else if (run.error !== undefined) {
        failure = "command=" + command + " error=" + run.error.code;
    } else if (run.signal !== null) {
        failure = "command=" + command + " signal=" + run.signal;
    } else if (run.status !== 0) {
        failure = "command=" + command + " status=" + run.status;
    } else {
        return row;
    }
    failures.push(key + reason + " " + failure);
    return Object.assign({}, row, { state: "reload-pending", reason });
}

// One pending target of a reload: `skipped` and dropped when it is no
// longer shipped, enabled or given a hook; `failed` and kept when its
// target.json cannot be read or judged; else its hook's row, `reloaded`.
function reloadTarget(name, shipped, disabled, configHome, live, failures) {
    const skipped = reason => ({ name, state: "skipped", reason });
    const failed = (reason, failure) => {
        failures.push(failure);
        return { name, state: "failed", reason };
    };
    if (!shipped.includes(name)) return skipped("not-shipped");
    if (disabled.includes(name)) return skipped("disabled");
    const dir = path.join(SHIPPED, TARGETS, name);
    const judged = reading(name, dir, () => readTarget(dir), failed);
    if (!judged.ok) return judged.entry;
    const verdict = judged.value.verdict;
    if (!verdict.ok) return failed(verdict.reason, render.refusalLine(name, verdict));
    const found = reading(name, dir, () => render.detected(verdict.target.detect, onPath), failed);
    if (!found.ok) return found.entry;
    if (!found.value) return skipped("not-detected");
    const setup = reading(name, dir, () => render.setupDone(verdict.target, onPath), failed);
    if (!setup.ok) return setup.entry;
    if (!setup.value) return skipped("setup-absent");
    if (verdict.target.reload === null) return skipped("no-reload");
    return reloadRow(name, verdict.target, configHome, live, { name, state: "reloaded", reason: null }, failures);
}

// Run every pending reload hook again, in name order, and keep pending the
// targets whose hook fails. Nothing is rendered, staged or wired.
function reloadAll(result, failures, configDir, stateDir, lock) {
    const key = "reload=pending reason";
    if (lock === "busy") refuse(key + "=busy", "busy", 75);
    if (lock === "failed") refuse(key + "=lock-failed path=" + path.join(configDir, "theme.lock"), "lock-failed");
    const before = readPending(stateDir, key);
    if (before.length === 0) {
        result.state = "unchanged";
        return;
    }
    const disabled = disabledTargets(configDir, key);
    const base = path.join(SHIPPED, TARGETS);
    let shipped;
    try {
        shipped = childDirs(base) || [];
    } catch (e) {
        refuse(key + "=unreadable path=" + base + " error=" + e.code, "unreadable");
    }
    const configHome = path.dirname(configDir);
    const live = path.join(stateDir, "theme");
    result.targets = before.map(name => reloadTarget(name, shipped, disabled, configHome, live, failures));
    writePending(stateDir, stillPending(result.targets, before), before, key);
    result.state = stillPending(result.targets, before).length > 0 ? "partial" : "reloaded";
}

function reload(format, configDir, stateDir, lock) {
    const result = { state: "failed", targets: [], reason: null };
    report(format, result, failures => reloadAll(result, failures, configDir, stateDir, lock), r => "reload state=" + r.state);
}

// --- backgrounds

// How far each background step moves through the applied package's images.
const BACKGROUND_STEPS = { next: 1, previous: -1 };
// What `background list` names: the applied package's images, or every
// source's.
const BACKGROUND_SCOPES = ["applied", "all"];

// Refuse background VERB unless the caller holds the theme lock.
function backgroundLock(verb, lock, configDir) {
    if (lock === "busy") refuse("background=" + verb + " reason=busy", "busy", 75);
    if (lock === "failed") refuse("background=" + verb + " reason=lock-failed path=" + path.join(configDir, "theme.lock"), "lock-failed");
}

// The package name theme.name holds, which apply writes after the swap, or
// null before any apply. KEY leads the refusal for a file that cannot be
// read or holds a name no package could have.
function appliedName(stateDir, key) {
    const file = path.join(stateDir, "theme.name");
    let name;
    try {
        name = fs.readFileSync(file, "utf8");
    } catch (e) {
        if (e.code === "ENOENT") return null;
        refuse(key + "=unreadable path=" + file + " error=" + e.code, "unreadable");
    }
    name = name.endsWith("\n") ? name.slice(0, -1) : name;
    if (!logic.isPackageName(name)) refuse(key + "=malformed path=" + file, "malformed");
    return name;
}

// The applied package's name, refused `not-applied` before any apply.
function appliedPackage(stateDir, key) {
    const name = appliedName(stateDir, key);
    if (name === null) refuse(key + "=not-applied path=" + path.join(stateDir, "theme.name"), "not-applied");
    return name;
}

// The accepted package NAME resolves to, its row refused `unknown` when no
// package has the name and with its own reason when the judge refused it.
function acceptedPackage(configDir, name, key) {
    const row = packageSet(configDir, key).resolved.get(name);
    if (row === undefined) refuse(key + "=unknown theme=" + name, "unknown");
    if (row.state !== "ok") refuse(key + "=" + row.reason + " theme=" + name + " path=" + row.path, row.reason);
    return row;
}

// Every source `background list --all` names images from and `background
// set` takes one from, as `{ theme, dir }` with the images in DIR's
// backgrounds/: each accepted package a name resolves to, in name order,
// then the user folder, <config-dir>/backgrounds, whose theme is null.
function backgroundSources(configDir, key) {
    const { resolved } = packageSet(configDir, key);
    const packages = [...resolved.keys()].sort().map(name => resolved.get(name)).filter(row => row.state === "ok");
    return packages.map(row => ({ theme: row.name, dir: row.path })).concat([{ theme: null, dir: configDir }]);
}

// A step cycles the applied package's images in name order from the one
// it shows, wrapping at either end, remembers the new one for it and makes
// it current; each screen keeps its own image. RESULT is filled as the
// step learns each part.
function stepBackground(result, step, configDir, stateDir, lock) {
    const key = "background=" + step + " reason";
    backgroundLock(step, lock, configDir);
    const shown = backgrounds.read(logic, stateDir, key);
    const name = appliedPackage(stateDir, key);
    result.theme = name;
    const row = acceptedPackage(configDir, name, key);
    const list = backgrounds.images(row.path, key);
    if (list.length === 0) refuse(key + "=no-backgrounds theme=" + name + " path=" + path.join(row.path, backgrounds.DIR), "no-backgrounds");
    const at = list.indexOf(backgrounds.choose(list, shown.themes[name]));
    const chosen = list[(at + BACKGROUND_STEPS[step] + list.length) % list.length];
    const image = backgrounds.stamped(row.path, chosen, key);
    backgrounds.land(stateDir, { current: image, themes: Object.assign({}, shown.themes, { [name]: chosen }), screens: shown.screens }, shown, key);
    result.background = chosen;
    result.path = image.path;
    result.state = "ok";
}

// Set ARGUMENT, a path `backgrounds.locate` finds among the sources, as
// the current image, or as SCREEN's own when SCREEN is given. The current
// image of the applied package is remembered for it, as a step's is; an
// image of another package or of the user folder, and a screen's image,
// are remembered for none.
function setBackground(result, argument, screen, configDir, stateDir, lock) {
    const key = "background=set reason";
    if (screen !== null && !backgrounds.isOutputName(screen)) refuse(key + "=malformed-screen screen=" + JSON.stringify(screen), "malformed-screen");
    result.screen = screen;
    backgroundLock("set", lock, configDir);
    const shown = backgrounds.read(logic, stateDir, key);
    const applied = appliedName(stateDir, key);
    const { source, background } = backgrounds.locate(backgroundSources(configDir, key), argument, key);
    result.theme = source.theme;
    result.background = background;
    const image = backgrounds.stamped(source.dir, background, key);
    const remembered = source.theme !== null && source.theme === applied;
    const after = screen === null
        ? { current: image, themes: remembered ? Object.assign({}, shown.themes, { [applied]: background }) : shown.themes, screens: shown.screens }
        : { current: shown.current, themes: shown.themes, screens: Object.assign({}, shown.screens, { [screen]: image }) };
    backgrounds.land(stateDir, after, shown, key);
    result.path = image.path;
    result.state = "ok";
}

// List the images of the applied package, or with SCOPE `all` of every
// source, into RESULT's `images`.
function listBackgrounds(result, scope, configDir, stateDir) {
    const key = "background=list reason";
    let sources;
    if (scope === "all") {
        sources = backgroundSources(configDir, key);
    } else {
        const name = appliedPackage(stateDir, key);
        sources = [{ theme: name, dir: acceptedPackage(configDir, name, key).path }];
    }
    result.images = sources.flatMap(s => backgrounds.images(s.dir, key)
        .map(file => ({ background: file, theme: s.theme, path: backgrounds.imagePath(s.dir, file) })));
    result.state = "ok";
}

// Run RUN, which fills RESULT, and print it: under `json` one line on
// stdout, a refusal's included, `state` "failed" beside the refusal's
// reason; in text the lines LINES answers for it.
function backgroundReport(format, result, run, lines) {
    try {
        run();
    } catch (e) {
        if (e instanceof Refusal && format === "json") {
            result.reason = e.reason;
            process.stdout.write(JSON.stringify(result) + "\n");
        }
        throw e;
    }
    if (format === "json") process.stdout.write(JSON.stringify(result) + "\n");
    else for (const line of lines(result)) console.log(line);
}

// A text line's image fields; `theme=-` names the user folder, which no
// package name can be.
function imageFields(background, theme, at) {
    return "background=" + background + " theme=" + (theme === null ? "-" : theme) + " path=" + at;
}

function background(format, verb, configDir, stateDir, rest) {
    if (Object.hasOwn(BACKGROUND_STEPS, verb)) {
        const result = { state: "failed", background: null, theme: null, path: null, reason: null };
        backgroundReport(format, result, () => stepBackground(result, verb, configDir, stateDir, rest[0]),
            r => ["ok " + imageFields(r.background, r.theme, r.path)]);
        return;
    }
    switch (verb) {
    case "set": {
        const result = { state: "failed", background: null, theme: null, path: null, screen: null, reason: null };
        backgroundReport(format, result, () => setBackground(result, rest[1], rest.length === 3 ? rest[2] : null, configDir, stateDir, rest[0]),
            r => ["ok " + imageFields(r.background, r.theme, r.path) + (r.screen === null ? "" : " screen=" + r.screen)]);
        return;
    }
    case "list": {
        const result = { state: "failed", images: null, reason: null };
        backgroundReport(format, result, () => listBackgrounds(result, rest[0], configDir, stateDir),
            r => r.images.map(i => imageFields(i.background, i.theme, i.path)));
        return;
    }
    default: throw new Error("vgsh-theme-judge: background verb " + verb + " is none of next, previous, set, list");
    }
}

// Whether ARGS, after `background`, is a call `background` takes: the
// format, the verb, the two directories, then the lock verdict for a step,
// the lock verdict, the path and an optional output for `set`, or the
// scope for `list`.
function backgroundCall(args) {
    const [format, verb, , , ...rest] = args;
    if (args.length < 5 || !FORMATS.includes(format)) return false;
    if (Object.hasOwn(BACKGROUND_STEPS, verb)) return rest.length === 1 && LOCK_VERDICTS.includes(rest[0]);
    if (verb === "set") return (rest.length === 2 || rest.length === 3) && LOCK_VERDICTS.includes(rest[0]);
    if (verb === "list") return rest.length === 1 && BACKGROUND_SCOPES.includes(rest[0]);
    return false;
}

// --- install

// The judge's verdict on the package in DIR as an installed package named
// NAME, or named by its document when NAME is undefined. The document's
// name is ThemeLogic.accept's reading of it; acceptPackage then judges the
// package under that name, the `vgs`, `targets` and `catalog`
// reservations included, so no package lands under a directory a themes
// directory's walk skips.
function acceptInstall(dir, name) {
    // Files are named relative to DIR: add judges a staging directory the
    // user never sees.
    let read;
    try {
        read = packageFiles(dir);
    } catch (e) {
        return logic.refusal("unreadable", "", "file=" + (e.path ? path.relative(dir, e.path) : ".") + " error=" + e.code);
    }
    if (read.linked !== null) return logic.refusal("symlink", "", "file=" + read.linked);
    const theme = text(read.files.theme);
    const terminal = text(read.files.terminal);
    if (theme === undefined) return logic.refusal("absent", "", "file=theme.json");
    if (name === undefined) {
        const document = logic.accept(tokens, theme);
        if (!document.ok) return document;
        name = document.name;
    }
    return logic.acceptPackage(tokens, { directoryName: name, themeJson: theme, terminalJson: terminal, shipped: false });
}

function acceptCommand(dir, name) {
    const verdict = acceptInstall(dir, name);
    if (!verdict.ok) {
        console.log("reason=" + verdict.reason + (verdict.token === "" ? "" : " token=" + verdict.token) + (verdict.detail === "" ? "" : " " + verdict.detail));
        process.exit(1);
    }
    console.log(verdict.name);
}

// The resolved directory of installed package NAME. Update and remove act
// only on a directory `add` could have landed: a name the package judge
// refuses, `targets`, `catalog`, a name no installed package has, a symlink
// and anything but a directory are refused, and a name only a shipped
// package has is refused as shipped.
function installed(configDir, name) {
    if (!logic.isPackageName(name)) refuse("theme=" + JSON.stringify(name) + " reason=malformed-name", "malformed-name");
    const key = "theme=" + name + " reason";
    if (logic.RESERVED_DIRECTORIES.includes(name)) refuse(key + "=reserved-name", "reserved-name");
    const dir = path.join(configDir, "themes", name);
    let stat;
    try {
        stat = fs.lstatSync(dir);
    } catch (e) {
        if (e.code !== "ENOENT") refuse(key + "=unreadable path=" + dir + " error=" + e.code, "unreadable");
        let shipped;
        try {
            shipped = packageDirs(SHIPPED);
        } catch (e2) {
            refuse(key + "=unreadable path=" + SHIPPED + " error=" + e2.code, "unreadable");
        }
        if (shipped !== null && shipped.includes(name)) refuse(key + "=shipped path=" + path.join(SHIPPED, name), "shipped");
        refuse(key + "=unknown", "unknown");
    }
    if (stat.isSymbolicLink()) refuse(key + "=symlink path=" + dir, "symlink");
    if (!stat.isDirectory()) refuse(key + "=not-a-directory path=" + dir, "not-a-directory");
    let real;
    try {
        real = fs.realpathSync(dir);
    } catch (e) {
        refuse(key + "=unreadable path=" + dir + " error=" + e.code, "unreadable");
    }
    console.log(real);
}

const [command, ...args] = process.argv.slice(2);
main(() => {
    switch (command) {
    case "packages":
        if (args.length > 1) usage("arguments=" + command);
        checkPackages(args[0]);
        break;
    case "catalog-check":
        if (args.length > 1) usage("arguments=" + command);
        checkCatalog(args[0]);
        break;
    case "list":
        if (args.length !== 3 || !FORMATS.includes(args[0])) usage("arguments=" + command);
        list(args[0], args[1], args[2]);
        break;
    case "apply":
        if (args.length !== 5 || !FORMATS.includes(args[0]) || !LOCK_VERDICTS.includes(args[3])) usage("arguments=" + command);
        apply(...args);
        break;
    case "follow":
        if (args.length < 4 || args.length > 5 || !FORMATS.includes(args[0]) || !LOCK_VERDICTS.includes(args[3])) usage("arguments=" + command);
        follow(...args);
        break;
    case "reload":
        if (args.length !== 4 || !FORMATS.includes(args[0]) || !LOCK_VERDICTS.includes(args[3])) usage("arguments=" + command);
        reload(...args);
        break;
    case "background":
        if (!backgroundCall(args)) usage("arguments=" + command);
        background(args[0], args[1], args[2], args[3], args.slice(4));
        break;
    case "accept":
        if (args.length < 1 || args.length > 2) usage("arguments=" + command);
        acceptCommand(args[0], args[1]);
        break;
    case "installed":
        if (args.length !== 2) usage("arguments=" + command);
        installed(args[0], args[1]);
        break;
    default:
        usage("command=" + (command || "missing"));
    }
});
